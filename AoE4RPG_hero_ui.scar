-- =============================================================================
-- AoE4RPG Hero/Elite Level UI
-- =============================================================================
-- Shows heroes and elites on the HUD with their current level, XP, and a bar that
-- fills as XP reaches the threshold required for the next level.
-- =============================================================================

if not AoE4RPG then
    AoE4RPG = {}
end

AoE4RPG.HERO_UI = {
    enabled = true,
    panels = {},
    attribute_context = {
        visible = false,
        level_number = "1",
        exp_text = "0/0",
        exp_progress_width = "0",
        agility_total = "0",
        endurance_total = "0",
        vitality_total = "0",
        agility_stat = "AtkSpd\n0%",
        endurance_stat = "0",
        vitality_stat = "0",
        ability_cooldown_stat = "0%",
        regeneration_stat = "0/s",
        production_stat = "0%",
        critical_stat = "0% | 0%",
        range_stat = "0%",
    },
}

-- This makes sure we always have both the entity object and its ID.
-- You normally do not need to adjust this unless another callback returns a new value type.
function AoE4RPG_UI_NormalizeEntity(value)
    if type(value) == "number" then
        return Entity_FromID and Entity_FromID(value) or nil, value
    end
    if not value then
        return nil, nil
    end
    local id = value.EntityID or (Entity_GetID and Entity_GetID(value))
    return value, id
end

-- This updates every number shown in the selected hero/elite panel.
-- Pass nil to hide and reset the panel. Change the string.format calls below to adjust display formatting.
function AoE4RPG_UI_UpdateHeroAttributes(entity)
    local context = AoE4RPG.HERO_UI.attribute_context
    if not entity then
        context.visible = false
        context.level_number = "1"
        context.exp_text = "0/0"
        context.exp_progress_width = "0"
        context.agility_total = "0"
        context.endurance_total = "0"
        context.vitality_total = "0"
        context.agility_stat = "AtkSpd\n0%"
        context.endurance_stat = "0"
        context.vitality_stat = "0"
        context.ability_cooldown_stat = "0%"
        context.regeneration_stat = "0/s"
        context.production_stat = "0%"
        context.critical_stat = "0% | 0%"
        context.range_stat = "0%"
        if UI_SetDataContext then
            UI_SetDataContext("AoE4RPG_HeroAttributes", context)
        end
        return
    end

    local entity_id
    entity, entity_id = AoE4RPG_UI_NormalizeEntity(entity)
    if not entity or not entity_id then
        return AoE4RPG_UI_UpdateHeroAttributes(nil)
    end
    local data = AoE4RPG_GetUnitData(entity_id)
    if AoE4RPG_AssignEntityRole then
        local is_hero, is_elite = AoE4RPG_AssignEntityRole(entity, data)
        if not is_hero and not is_elite then
            return AoE4RPG_UI_UpdateHeroAttributes(nil)
        end
    end
    context.visible = true
    local stats = data.derived_stats or AoE4RPG_TranslateAttributesToStats(data)
    local level = data.level or 0
    local required_xp = AoE4RPG_ExperienceRequired(level)
    local current_xp = data.exp or 0
    context.level_number = tostring(level + (AoE4RPG.LEVEL_OFFSET or 1))
    context.exp_text = string.format("%d/%d XP", current_xp, required_xp)
    local exp_ratio = math.max(0, math.min(1, current_xp / math.max(1, required_xp)))
    context.exp_progress_width = tostring(math.floor(exp_ratio * 88))
    context.agility_total = string.format("%d", math.floor(data.attributes.agility or 0))
    context.endurance_total = string.format("%d", math.floor(data.attributes.endurance or 0))
    context.vitality_total = string.format("%d", math.floor(data.attributes.vitality or 0))
    context.agility_stat = string.format(
        "%.0f%%",
        (stats.weapon_reload_modifier or 0) * 100
    )
    context.endurance_stat = string.format("%d", math.floor(stats.health or 0))
    context.regeneration_stat = string.format("%.0f/s", stats.health_regeneration or 0)
    context.vitality_stat = string.format("%.0f", stats.armor or 0)
    context.ability_cooldown_stat = string.format("%.0f%%", (stats.ability_cooldown_modifier or 0) * 100)
    -- Technician bonuses are intentionally uniform across repair, construction,
    -- and production; show the shared value once instead of repeating it.
    local production_bonus = data.build_speed_bonus or data.train_speed_bonus or data.production_speed_bonus or 0
    context.production_stat = string.format("%.0f%%", production_bonus)
    context.critical_stat = string.format(
        "%.0f%% | %.0f%%",
        (data.weapon_crit_damage_chance or 0) * 100,
        (data.weapon_crit_damage_factor or 0) * 100
    )
    context.range_stat = string.format("%.0f%%", (data.weapon_range_bonus or 0) * 100)
    if UI_SetDataContext then
        UI_SetDataContext("AoE4RPG_HeroAttributes", context)
    end
end

-- This creates the XAML panel and adds it to the normal game HUD.
-- Adjust Margin to move it, Width/Height to resize it, and row/column values to change spacing.
function AoE4RPG_UI_CreateHeroAttributesUI()
    if not UI_AddChild or not UI_CreateDataContext then
        return false
    end

    local xaml = [[
<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        RenderTransformOrigin="0.5,1"
        Margin="418,0,0,36"
        Width="208"
        Height="152"
        Visibility="{Binding [visible], Converter={StaticResource BoolToVis}}"
        Padding="4">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="28" />
        <RowDefinition Height="29" />
        <RowDefinition Height="29" />
        <RowDefinition Height="29" />
        <RowDefinition Height="29" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="67" />
        <ColumnDefinition Width="66" />
        <ColumnDefinition Width="67" />
      </Grid.ColumnDefinitions>
      <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Padding="1" Margin="0">
        <Grid Height="24" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="34" />
            <ColumnDefinition Width="96" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Level" TextAlignment="Center" VerticalAlignment="Center" Height="20" Margin="0,3,0,0" FontSize="18" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
          <!-- Retained for data/debugging, but the bar is the only visible XP progress indicator. -->
          <TextBlock Grid.Column="1" Text="{Binding [exp_text]}" Visibility="Collapsed" FontSize="14" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
          <!-- UAGS-compatible EXP bar: bind a fill rectangle to a pixel width. -->
          <Grid Grid.Column="2"
                Width="116" Height="12"
                Margin="-46,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#80050B13">
            <Border BorderBrush="#FF9A8352" BorderThickness="1" CornerRadius="1">
              <Grid>
                <Rectangle Fill="#FFFFD45C"
                           Width="{Binding [exp_progress_width]}"
                           HorizontalAlignment="Left" />
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Height="22"
                        MinWidth="18"
                        Padding="2,0"
                        Background="#CC0B1320"
                        BorderBrush="#FFE0B65A"
                        BorderThickness="1"
                        CornerRadius="1">
                  <TextBlock Text="{Binding [level_number]}"
                             TextAlignment="Center"
                             VerticalAlignment="Center"
                             FontSize="12"
                             FontWeight="Bold"
                             Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptStyle}" />
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Grid>
        <!-- Shows the level and experience progress. -->
      </Border>     <!-- Shows Agility icon and value. -->
      <Border Grid.Row="1" Grid.Column="0" Padding="4" Margin="0">
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
          <Image Source="pack://application:,,,/WPFGUI;component/icons/races/common/abilities/speed" Width="20" Height="20" /> <TextBlock Text="{Binding [agility_total]}" TextAlignment="Center" Margin="2,0,0,0" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
        </StackPanel>
      </Border>     <!-- Shows Endurance icon and value. -->
        <Border Grid.Row="1" Grid.Column="1" Padding="4" Margin="0">
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
          <Image Source="pack://application:,,,/WPFGUI;component/icons/races/chinese_historic/abilities/body_of_iron_2" Width="20" Height="20" /> <TextBlock Text="{Binding [endurance_total]}" TextAlignment="Center" Margin="2,0,0,0" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
        </StackPanel>
      </Border>     <!-- Shows Vitality icon and value. -->      
      <Border Grid.Row="1" Grid.Column="2" Padding="4" Margin="0">
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
          <Image Source="pack://application:,,,/WPFGUI;component/icons/races/hre_historic/upgrades/golden_cuirass" Width="20" Height="20" /> <TextBlock Text="{Binding [vitality_total]}" TextAlignment="Center" Margin="2,0,0,0" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
        </StackPanel>
      </Border>     <!-- Shows Attack Speed bonus. -->      
      <Border Grid.Row="2" Grid.Column="0" Padding="4" Margin="0">
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
          <Image Source="pack://application:,,,/WPFGUI;component/icons/races/common/abilities/leader_attack_speed" Width="20" Height="20" /> <TextBlock Text="{Binding [agility_stat]}" TextAlignment="Center" Margin="2,0,0,0" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
        </StackPanel>
      </Border>     <!-- Shows Health bonus. -->
      <Border Grid.Row="2" Grid.Column="1" Padding="4" Margin="0">
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
          <Image Source="pack://application:,,,/WPFGUI;component/icons/unit_stat_health" Width="20" Height="20" /> <TextBlock Text="{Binding [endurance_stat]}" TextAlignment="Center" Margin="2,0,0,0" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
        </StackPanel>
      </Border>     <!-- Shows Armor bonus. -->
      <Border Grid.Row="2" Grid.Column="2" Padding="4" Margin="0">
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
          <Image Source="pack://application:,,,/WPFGUI;component/icons/races/common/abilities/armor" Width="20" Height="20" /> <TextBlock Text="{Binding [vitality_stat]}" TextAlignment="Center" Margin="2,0,0,0" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
        </StackPanel>
      </Border>     <!-- Shows Ability Cooldown modifier. -->
      <Border Grid.Row="3" Grid.Column="0" Padding="4" Margin="0">
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
          <Image Source="pack://application:,,,/WPFGUI;component/icons/races/common/abilities/leader_production_speed_boost" Width="20" Height="20" /> <TextBlock Text="{Binding [ability_cooldown_stat]}" TextAlignment="Center" Margin="2,0,0,0" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
        </StackPanel>
      </Border>     <!-- Shows Health Regeneration bonus. -->
      <Border Grid.Row="3" Grid.Column="1" Padding="4" Margin="0">
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
          <Image Source="pack://application:,,,/WPFGUI;component/icons/races/common/abilities/heal" Width="20" Height="20" /> <TextBlock Text="{Binding [regeneration_stat]}" TextAlignment="Center" Margin="2,0,0,0" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
        </StackPanel>
      </Border>     <!-- Shows Repair, Construction, and Production bonuses. -->
      <Border Grid.Row="3" Grid.Column="2" Padding="4" Margin="0">
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
          <Image Source="pack://application:,,,/WPFGUI;component/icons/races/common/abilities/leader_construction_speed" Width="20" Height="20" /> <TextBlock Text="{Binding [production_stat]}" TextAlignment="Center" Margin="2,0,0,0" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
        </StackPanel>
      </Border>
      <!-- Shows Critical Chance/Damage and Weapon Range together at the bottom. -->
      <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Padding="4" Margin="0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="80" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
            <Image Source="pack://application:,,,/WPFGUI;component/icons/races/crucible_mode/boons/critical_hits" Width="20" Height="20" /> <TextBlock Text="{Binding [critical_stat]}" TextAlignment="Center" Margin="2,0,0,0" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
            <Image Source="pack://application:,,,/WPFGUI;component/icons/races/lancaster/upgrades/warwolf_trebuchet" Width="20" Height="20" /> <TextBlock Text="{Binding [range_stat]}" TextAlignment="Center" Margin="2,0,0,0" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
</Border>]]

    UI_AddChild("ScarNotReplay", "XamlPresenter", "AoE4RPG_HeroAttributes", {
        IsHitTestVisible = true,
        Xaml = xaml,
        DataContext = UI_CreateDataContext(AoE4RPG.HERO_UI.attribute_context),
    })
    return true
end

-- This builds the old text version of the XP bar for the stored hero list.
-- Change bar_width or pass a different width if this text fallback needs to be longer.
-- @param current_xp Current progress; @param required_xp Next-level threshold.
-- @param width Number of characters in the bar.
-- @return Text bar composed of filled `=` and empty `-` characters.
function AoE4RPG_UI_BuildXPBar(current_xp, required_xp, width)
    local bar_width = width or 20
    local required = math.max(1, required_xp or 1)
    local ratio = math.max(0, math.min(1, (current_xp or 0) / required))
    local filled = math.floor(ratio * bar_width)
    local empty = bar_width - filled
    return string.rep("=", filled) .. string.rep("-", empty)
end

-- This builds one readable progress line for the stored hero/elite list.
-- Change the final string.format layout if a debug screen needs different text.
-- @param entity Hero/elite EntityID/entity object with a tracked RPG record.
-- @return Human-readable class, level, XP, and progress-bar text.
function AoE4RPG_UI_GetHeroProgressText(entity)
    local entity_object, entity_id = AoE4RPG_UI_NormalizeEntity(entity)
    if not entity_object or not entity_id then
        return ""
    end
    local unit_data = AoE4RPG_GetUnitData(entity_id)
    if not unit_data then
        return ""
    end

    local class_name = unit_data.class_name or (AoE4RPG_CLASS_GetClassForEntity and AoE4RPG_CLASS_GetClassForEntity(entity_object)) or "hero"
    local level = unit_data.level or 0
    local required = AoE4RPG_ExperienceRequired(level)
    local current_xp = unit_data.exp or 0
    local bar = AoE4RPG_UI_BuildXPBar(current_xp, required, 20)

    return string.format("%s Lvl %d | %d/%d | [%s]", class_name, level + (AoE4RPG.LEVEL_OFFSET or 1), current_xp, required, bar)
end

-- This creates the small data table used to track hero/elite progress entries.
-- Change the default name or title only if another script also uses this panel key.
-- @param name Optional panel key; defaults to `heroes_elites`.
-- @return New panel table stored in HERO_UI.panels.
function AoE4RPG_UI_CreateHeroPanel(name)
    local panel = {
        name = name or "heroes_elites",
        title = "Heroes/Elites",
        visible = true,
        entries = {},
    }

    AoE4RPG.HERO_UI.panels[name or "heroes_elites"] = panel
    return panel
end

-- This scans all world entities and rebuilds the stored hero/elite progress list.
-- The refresh interval is adjusted in AoE4RPG_bootstrap.scar, not inside this function.
-- @side_effect Replaces the panel entries with current progress strings.
function AoE4RPG_UI_RefreshHeroProgress()
    if not AoE4RPG or not AoE4RPG.HERO_UI then
        return
    end

    local panel = AoE4RPG.HERO_UI.panels["heroes_elites"]
    if not panel then
        panel = AoE4RPG_UI_CreateHeroPanel("heroes_elites")
    end

    panel.entries = {}

    if not World_GetAllEntities or not EGroup_CreateIfNotFound or not EGroup_ForEach then
        return
    end

    local all_entities = EGroup_CreateIfNotFound("AoE4RPG_HeroesElites")
    World_GetAllEntities(all_entities)
    -- This callback checks one entity and adds it only when it is a hero or elite.
    -- Adjust: change the final role condition only if another unit type should enter the list.
    local function collect_entity(group_id, index, entity)
        local entity_object, entity_id = AoE4RPG_UI_NormalizeEntity(entity)
        if entity_id then
            if AoE4RPG_CLASS_BindUnit then
                AoE4RPG_CLASS_BindUnit(entity_object)
            end
            local unit_data = AoE4RPG_GetUnitData(entity_id)
            if AoE4RPG_AssignEntityRole then
                AoE4RPG_AssignEntityRole(entity_object, unit_data)
            end
            if unit_data and (unit_data.is_hero or unit_data.is_elite) then
                table.insert(panel.entries, AoE4RPG_UI_GetHeroProgressText(entity_id))
            end
        end
    end
    EGroup_ForEach(all_entities, collect_entity)
end

-- This creates the hero data panel and the visible attribute XAML once.
-- Adjust the XAML function above for visual changes.
-- @return The initialized heroes/elites panel.
function AoE4RPG_UI_InitializeHeroesDisplay()
    local panel = AoE4RPG_UI_CreateHeroPanel("heroes_elites")
    panel.visible = true
    AoE4RPG_UI_CreateHeroAttributesUI()
    return panel
end

-- This is a short helper used after XP or level data changes.
-- It should stay small so callers only need one refresh function name.
function AoE4RPG_UI_UpdateHeroesDisplay()
    AoE4RPG_UI_RefreshHeroProgress()
end

-- This gives the bootstrap a simple name for starting the hero UI.
-- Keep this alias if other host scripts already call InitializeHeroBar.
-- @return The initialized heroes/elites panel.
-- Adjust: point this at another initializer only if the whole hero display is replaced.
function AoE4RPG_UI_InitializeHeroBar()
    return AoE4RPG_UI_InitializeHeroesDisplay()
end
