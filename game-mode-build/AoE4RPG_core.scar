-- =============================================================================
-- AoE4RPG Core Leveling Module
-- =============================================================================
-- Core experience engine and level progression for the AoE4RPG system.
-- This file is intentionally kept modular and can be imported from a host SCAR
-- script or bootstrap module.
-- =============================================================================

if not AoE4RPG then
    AoE4RPG = {}
end

AoE4RPG.VERSION = "1.0.0"
-- Internal levels remain zero-based for XP calculations; the player-facing
-- level is always internal level + LEVEL_OFFSET.
AoE4RPG.LEVEL_OFFSET = 1
AoE4RPG.MaxLevel = 24       -- displayed levels 1-25
AoE4RPG.EliteMaxLevel = 9   -- displayed levels 1-10
AoE4RPG.XPBonusMultiplier = 1.5
AoE4RPG.LEVEL_UP_SOUND = "sfx_campaign_scripted_small_group_celebrate"
AoE4RPG.BRACKET_LEVEL_UP_SOUND = "mus_stinger_campaign_triumph_short"

AoE4RPG.UNIT_DATA = {}
AoE4RPG.UPGRADE_BRACKETS = {
    { min = 0, max = 3, upgrade = nil },
    { min = 4, max = 8, upgrade = "damage1" },
    { min = 9, max = 13, upgrade = "damage2" },
    { min = 14, max = 18, upgrade = "damage3" },
    { min = 19, max = 24, upgrade = "damage5" },
}

-- Creates or reuses a per-entity RPG record, storing level, exp, attributes,
-- and derived stat values so the progression system can persist state between
-- actions and level-ups.
-- @param entity_id Entity identifier used as the persistent registry key.
-- @return table Mutable RPG state for the entity; created on first access.
-- @side_effect Initializes all counters, attributes, role flags, and upgrade state.
-- Adjust: add new saved unit values in the default table below.
function AoE4RPG_GetUnitData(entity_id)
    if not AoE4RPG.UNIT_DATA[entity_id] then
        AoE4RPG.UNIT_DATA[entity_id] = {
            level = 0,
            exp = 0,
            base_exp = 0,
            damage_dealt = 0,
            kills = 0,
            damage_bonus_applied = 0,
            strategist_weapon_cooldown_applied = 0,
            strategist_ability_cooldown_applied = 0,
            weapon_crit_damage_chance = 0,
            weapon_crit_damage_factor = 0,
            weapon_range_bonus = 0,
            build_speed_bonus = 0,
            train_speed_bonus = 0,
            production_speed_bonus = 0,
            attributes = {
                agility = 0,
                endurance = 0,
                vitality = 0,
            },
            derived_stats = {
                weapon_reload_modifier = 0,
                weapon_cooldown_modifier = 0,
                health = 0,
                health_regeneration = 0,
                armor = 0,
                ability_cooldown_modifier = 0,
            },
            buff_heal_changes = 0,
            owner = nil,
            class_name = nil,
            civilization = nil,
            is_hero = false,
            is_elite = false,
            critical_hits_enabled = false,
            applied_bracket_upgrades = {},
            -- Incremented whenever player-visible RPG values change. The hero
            -- UI compares this small counter instead of rebuilding every tick.
            ui_revision = 0,
        }
    end

    return AoE4RPG.UNIT_DATA[entity_id]
end

-- Marks one RPG record as changed for the local hero-panel monitor.
-- Call this after changing experience, level, attributes, or displayed bonuses.
-- @param unit_data Mutable record returned by AoE4RPG_GetUnitData.
-- @return The new monotonically increasing UI revision number.
function AoE4RPG_MarkUnitDataChanged(unit_data)
    if not unit_data then
        return 0
    end

    unit_data.ui_revision = (unit_data.ui_revision or 0) + 1
    return unit_data.ui_revision
end

-- This enables native critical-hit handling for one registered RPG unit.
-- Applying the two weapon flags directly avoids the critical boon upgrade,
-- because that upgrade runs a player-wide state tree and affects every unit.
-- @param entity Registered hero/elite entity receiving critical-hit support.
-- @return True when critical hits are already enabled or were enabled now.
-- Adjust: keep both native enable modifiers together or critical damage may not run.
function AoE4RPG_EnableCriticalHits(entity)
    if not entity or not entity.EntityID then
        return false
    end
    if not AoE4RPG_IsRegisteredEntityBlueprint or not AoE4RPG_IsRegisteredEntityBlueprint(entity) then
        return false
    end

    local unit_data = AoE4RPG_GetUnitData(entity.EntityID)
    if unit_data.critical_hits_enabled then
        return true
    end
    if not Modifier_Create or not Modifier_ApplyToEntity then
        return false
    end

    local enable_hits = Modifier_Create(
        MAT_Weapon,
        "enable_critical_hits_modifier",
        MUT_Enable,
        false,
        1,
        ""
    )
    local enable_damage = Modifier_Create(
        MAT_Weapon,
        "enable_critical_damage_modifier",
        MUT_Enable,
        false,
        1,
        ""
    )
    Modifier_ApplyToEntity(enable_hits, entity, 0)
    Modifier_ApplyToEntity(enable_damage, entity, 0)
    unit_data.critical_hits_enabled = true
    return true
end

-- This scans the entities that already exist when the match starts and enables
-- critical hits only for blueprints listed in AoE4RPG_ENTITY_TABLE.
-- @side_effect Applies both native critical weapon flags once per matching entity.
-- Adjust: add or remove eligible units in _blueprints.scar instead of filtering here.
function AoE4RPG_EnableCriticalHitsForRegisteredUnits()
    if not PLAYERS or not Player_GetEntities or not EGroup_CountSpawned then
        return
    end

    for _, player in pairs(PLAYERS) do
        if player and player.id then
            local entities = Player_GetEntities(player.id)
            if entities then
                for index = 1, EGroup_CountSpawned(entities) do
                    local entity = nil
                    if EGroup_GetSpawnedEntityAt then
                        entity = EGroup_GetSpawnedEntityAt(entities, index)
                    elseif EGroup_GetEntityAt then
                        entity = EGroup_GetEntityAt(entities, index)
                    end
                    if entity then
                        AoE4RPG_EnableCriticalHits(entity)
                    end
                end
            end
        end
    end
end

-- Returns the XP threshold required to advance from the given level to the next
-- level. Lower levels scale more slowly and this keeps the progression curve
-- compact and readable for a game mode.
-- @param level Current zero-based level.
-- @return Integer XP needed to gain exactly one level from `level`.
-- Adjust: change the formula numbers below to make leveling faster or slower.
function AoE4RPG_ExperienceRequired(level)
    local base = 200
    local scaled = base * (1.5 + (level / 2))
    return math.floor(scaled)
end

-- Maps the 3 RPG attributes to their actual runtime stat effects.
-- Agility -> weapon reload / attack speed style scaling
-- Endurance -> health + health regeneration
-- Vitality -> armor
-- Class primary stat receives a stronger multiplier for its translated stat.
-- Strategist (hq) only: health regeneration reduces ability cooldown.
-- @param class_name Lowercase RPG class key.
-- @return Numeric multiplier applied when translating attributes to runtime stats.
-- Adjust: change the shared attribute-family values, not individual classes using the same main stat.
function AoE4RPG_GetPrimaryStatBonus(class_name)
    local class_bonus = {
        assassin = 1.40,
        ranger = 1.30,
        skirmisher = 1.20,
        initiator = 1.35,
        duelist = 1.30,
        technician = 1.10,
        commander = 1.30,
        roamer = 1.20,
        strategist = 1.25,
    }

    return class_bonus[class_name] or 1.0
end

-- Converts raw attribute totals into the stat values that actually affect the
-- game: reload time, cooldown, HP, regen, armor, and strategist ability cooldown.
-- @param unit_data RPG record containing raw agility/endurance/vitality totals.
-- @return Table of derived reload, cooldown, health, regeneration, armor, and
-- ability-cooldown values; also caches the result on `unit_data`.
-- Adjust: change the small multipliers below to tune each attribute's derived bonuses.
function AoE4RPG_TranslateAttributesToStats(unit_data)
    local attrs = (unit_data and unit_data.attributes) or { agility = 0, endurance = 0, vitality = 0 }
    local class_name = (unit_data and unit_data.class_name) or ""
    local primary_bonus = AoE4RPG_GetPrimaryStatBonus(class_name)

    local health_regen = attrs.endurance * 0.050 * primary_bonus
    local ability_cooldown_reduction = 0
    local strategist_weapon_cooldown_bonus = 0
    if class_name == "strategist" then
        ability_cooldown_reduction = health_regen * 0.25
        -- Health regeneration contributes to weapon cooldown, but at one
        -- quarter of the Agility-per-point coefficient.
        strategist_weapon_cooldown_bonus = health_regen * 0.025
    end

    local result = {
        weapon_reload_modifier = attrs.agility * 0.010 * primary_bonus,
        -- Agility is the primary cooldown driver; Strategist regeneration is
        -- deliberately capped at 25% of that per-point contribution.
        weapon_cooldown_modifier = (attrs.agility * 0.005 * primary_bonus) + strategist_weapon_cooldown_bonus,
        health = attrs.endurance * 10 * primary_bonus,
        health_regeneration = health_regen,
        armor = attrs.vitality * 0.200 * primary_bonus,
        ability_cooldown_modifier = ability_cooldown_reduction,
    }

    if unit_data then
        unit_data.derived_stats = result
    end

    return result
end

-- Identifies whether an entity is a hero or elite unit and stores that state on the
-- record so death logic can apply the proper XP and level penalty rules.
-- @param entity EntityID/entity object inspected for engine type tags.
-- @param unit_data Optional registry record to update.
-- @return is_hero, is_elite Boolean role flags used by XP and cap logic.
-- Adjust: change the type-tag checks below if hero or elite squad properties change.
function AoE4RPG_AssignEntityRole(entity, unit_data)
    if not entity then
        return false, false
    end

    local data = unit_data or AoE4RPG_GetUnitData(entity.EntityID)
    if not data then
        return false, false
    end

    local class_name = data.class_name or (AoE4RPG_CLASS_GetClassForEntity and AoE4RPG_CLASS_GetClassForEntity(entity))
    -- HQ/landmark entities may use the strategist class for stat rules, but
    -- they are structures and must never be treated as selectable heroes.
    local is_structure = (Entity_IsOfType and Entity_IsOfType(entity, "hq"))
        or (Entity_IsOfType and Entity_IsOfType(entity, "building"))
    local is_hero = not is_structure and ((Entity_IsOfType and Entity_IsOfType(entity, "hero"))
        or class_name == "ranger"
        or class_name == "assassin"
        or class_name == "strategist"
        or class_name == "commander")
    local is_elite = AoE4RPG_ClassIsElite and AoE4RPG_ClassIsElite(entity)

    data.is_hero = is_hero
    data.is_elite = is_elite
    return is_hero, is_elite
end

-- Computes the XP lost when a unit dies. Heroes keep their level but suffer an XP
-- reduction, elites lose a level.
-- @param entity Killed entity whose role determines the penalty.
-- @param unit_data Persistent record to reduce in place.
-- @side_effect Heroes lose XP, elites lose one level, and ordinary units lose 25% XP.
-- Adjust: edit each role branch below to change its death penalty.
function AoE4RPG_ApplyDeathPenalty(entity, unit_data)
    if not entity or not unit_data then
        return
    end

    local is_hero, is_elite = AoE4RPG_AssignEntityRole(entity, unit_data)

    if is_hero then
        local xp_loss = math.min(unit_data.exp, math.max(0, math.floor((unit_data.level + 1) * 25)))
        unit_data.exp = math.max(0, unit_data.exp - xp_loss)
        AoE4RPG_MarkUnitDataChanged(unit_data)
        return
    end

    if is_elite then
        unit_data.level = math.max(0, unit_data.level - 1)
        unit_data.exp = 0
        AoE4RPG_MarkUnitDataChanged(unit_data)
        return
    end

    local xp_loss = math.min(unit_data.exp, math.max(0, math.floor(unit_data.exp * 0.25)))
    unit_data.exp = math.max(0, unit_data.exp - xp_loss)
    AoE4RPG_MarkUnitDataChanged(unit_data)
end

-- Returns the level bracket step for the current level. Brackets are defined as:
-- Internal 0-3 (display 1-4) = no upgrade, 4-8 (display 5-9) = damage1,
-- 9-13 (display 10-14) = damage2, 14-18 (display 15-19) = damage3,
-- 19-24 (display 20-25) = damage5.
-- @param level Level to classify into the five reward bands.
-- @return One-based bracket index used by the reward table.
-- Adjust: edit UPGRADE_BRACKETS near the top of this file to change the ranges.
function AoE4RPG_GetLevelBracketStep(level)
    local current_level = level or 0
    if current_level < 0 then
        current_level = 0
    end

    for index, bracket in ipairs(AoE4RPG.UPGRADE_BRACKETS) do
        if current_level >= bracket.min and current_level <= bracket.max then
            return index
        end
    end

    return #AoE4RPG.UPGRADE_BRACKETS
end

-- Applies the translated stats to the target entity using the SCAR modifier
-- system for weapon reload, cooldown, health, health regeneration, armor, and
-- specialist ability cooldown reduction.
-- @param entity Target entity receiving UAGS-compatible modifiers.
-- @param unit_data Aggregate attributes to translate and apply.
-- @side_effect Adds indefinite entity modifiers; callers should invoke this only
-- for incremental changes because modifiers are not automatically deduplicated.
-- Adjust: add another modifier block here only when a new translated stat is added.
function AoE4RPG_ApplyAttributeStats(entity, unit_data)
    if not entity or not unit_data then
        return
    end

    local translated = AoE4RPG_TranslateAttributesToStats(unit_data)

    if translated.weapon_reload_modifier ~= 0 and Modifier_ApplyToEntity then
        Modifier_ApplyToEntity(Modifier_Create(MAT_Weapon, "reload_weapon_modifier", MUT_MultiplicationAddition, false, translated.weapon_reload_modifier, ""), entity, 0)
    end

    if translated.weapon_cooldown_modifier ~= 0 and Modifier_ApplyToEntity then
        Modifier_ApplyToEntity(Modifier_Create(MAT_Weapon, "cooldown_weapon_modifier", MUT_MultiplicationAddition, false, translated.weapon_cooldown_modifier, ""), entity, 0)
    end

    if translated.health ~= 0 and Modifier_ApplyToEntity then
        Modifier_ApplyToEntity(Modifier_Create(MAT_Entity, "health_maximum_modifier", MUT_MultiplicationAddition, false, translated.health / math.max(1, Entity_GetHealthMax(entity)), ""), entity, 0)
    end

    if translated.health_regeneration ~= 0 and Modifier_ApplyToEntity then
        Modifier_ApplyToEntity(Modifier_Create(MAT_Entity, "health_regeneration_modifier", MUT_Addition, false, translated.health_regeneration, ""), entity, 0)
    end

    if translated.ability_cooldown_modifier ~= 0 and Modifier_ApplyToEntity then
        local reduction_factor = 1 - translated.ability_cooldown_modifier
        if reduction_factor <= 0 then
            reduction_factor = 0.01
        end
        Modifier_ApplyToEntity(Modifier_Create(MAT_Ability, "ability_recharge_time_modifier", MUT_Multiplication, false, reduction_factor, ""), entity, 0)
    end

    if translated.armor ~= 0 and Modifier_ApplyToEntity then
        Modifier_ApplyToEntity(Modifier_Create(MAT_Entity, "armor_scalar_for_fire_damage", MUT_Addition, false, translated.armor, ""), entity, 0)
        Modifier_ApplyToEntity(Modifier_Create(MAT_Entity, "armor_scalar_for_melee_damage", MUT_Addition, false, translated.armor, ""), entity, 0)
        Modifier_ApplyToEntity(Modifier_Create(MAT_Entity, "armor_scalar_for_ranged_damage", MUT_Addition, false, translated.armor, ""), entity, 0)
        Modifier_ApplyToEntity(Modifier_Create(MAT_Entity, "armor_scalar_for_truedamage_damage", MUT_Addition, false, translated.armor, ""), entity, 0)
    end
end

-- Returns the maximum possible level based on class type. Elite variants such as
-- Skirmisher, Duelist, and Roamer stop at the elite cap while regular heroes can
-- continue to the full hero cap.
-- @param entity Entity whose elite status selects the cap.
-- @return EliteMaxLevel for elite records, otherwise MaxLevel.
-- Adjust: change MaxLevel and EliteMaxLevel near the top of this file.
function AoE4RPG_GetEffectiveLevelLimit(entity)
    if not entity then
        return AoE4RPG.MaxLevel
    end

    if AoE4RPG_ClassIsElite and AoE4RPG_ClassIsElite(entity) then
        return AoE4RPG.EliteMaxLevel
    end

    return AoE4RPG.MaxLevel
end

-- This plays the normal level sound or the stronger bracket sound for the unit owner.
-- @param owner Player that owns the unit; used to avoid playing another player's sound.
-- @param reached_new_bracket True when this level is the first level of a new bracket.
-- Adjust: change LEVEL_UP_SOUND or BRACKET_LEVEL_UP_SOUND near the top of this file.
function AoE4RPG_PlayLevelUpSound(owner, reached_new_bracket)
    if not Sound_Play2D then
        return
    end

    -- Sound_Play2D is local, so only call it on the client that owns this unit.
    if owner and Game_GetLocalPlayer and Player_GetID then
        local local_player = Game_GetLocalPlayer()
        if local_player then
            local owner_id = Player_GetID(owner)
            local local_player_id = Player_GetID(local_player)
            if owner_id ~= local_player_id then
                return
            end
        end
    end

    local sound_event = reached_new_bracket
        and AoE4RPG.BRACKET_LEVEL_UP_SOUND
        or AoE4RPG.LEVEL_UP_SOUND
    Sound_Play2D(sound_event)
end

-- Handles the damage event and decides whether the attacker or victim gains XP.
-- It tracks damage dealt, handles building-only and unit-only XP scaling, and
-- applies level-up checks after accumulating the experience points.
-- @param context UAGS GE_DamageReceived payload containing attacker, victim,
-- owners, and positive damage.
-- @side_effect Adds XP to eligible participants and invokes level-up modifiers/UI.
-- Adjust: tune XP in the two Calculate...Exp functions so this event stays easy to follow.
function AoE4RPG_LevelUp(context)
    if not context or not context.attacker or not context.victim or not context.damage then
        return
    end

    if context.damage <= 0 then
        return
    end

    local attacker = context.attacker
    local victim = context.victim
    local attacker_owner = context.attackerOwner
    local victim_owner = context.victimOwner

    if not attacker or not victim then
        return
    end

    if not attacker.EntityID or not victim.EntityID then
        return
    end

    if attacker.EntityID == victim.EntityID then
        return
    end

    if World_OwnsEntity and World_OwnsEntity(attacker) then
        return
    end

    if Entity_IsOfType and (Entity_IsOfType(victim, "animal") or Entity_IsOfType(attacker, "building")) then
        return
    end

    local attacker_id = attacker.EntityID
    local victim_id = victim.EntityID
    local attacker_data = AoE4RPG_GetUnitData(attacker_id)
    local victim_data = AoE4RPG_GetUnitData(victim_id)

    if AoE4RPG_CLASS_BindUnit then
        AoE4RPG_CLASS_BindUnit(attacker)
        AoE4RPG_CLASS_BindUnit(victim)
    end

    attacker_data.owner = attacker_owner

    local attacker_exp = AoE4RPG_CalculateAttackerExp(attacker, victim, context.damage, attacker_owner, victim_owner, attacker_data)
    if AoE4RPG_CLASS_GetExpMultiplier then
        attacker_exp = attacker_exp * AoE4RPG_CLASS_GetExpMultiplier(attacker, attacker_data, "attack")
    end
    attacker_data.exp = attacker_data.exp + attacker_exp
    AoE4RPG_MarkUnitDataChanged(attacker_data)

    local attacker_leveled_up, attacker_level_gain = AoE4RPG_CheckAndApplyLevelUp(attacker, attacker_owner, attacker_data, true)

    local victim_exp = 0
    if not (Entity_IsOfType and (Entity_IsOfType(attacker, "monk") or Entity_IsOfType(attacker, "villager") or Entity_IsOfType(attacker, "naval_fishing_ship"))) then
        victim_exp = AoE4RPG_CalculateVictimExp(victim, attacker, context.damage, victim_owner, attacker_owner, victim_data)

        if AoE4RPG_CLASS_GetExpMultiplier then
            victim_exp = victim_exp * AoE4RPG_CLASS_GetExpMultiplier(victim, victim_data, "damage_taken")
        end

        victim_data.exp = victim_data.exp + victim_exp
        AoE4RPG_MarkUnitDataChanged(victim_data)
        AoE4RPG_CheckAndApplyLevelUp(victim, victim_owner, victim_data, false)
    end
end

-- Calculates the amount of XP granted to the attacker when it deals damage,
-- including a bonus for enemy kills and a smaller reward for damaging buildings.
-- @param attacker Damaging entity; @param victim Damaged entity;
-- @param damage Raw damage amount; @param unit_data Attacker registry record.
-- @return XP from damage plus a kill bonus when the victim is dead.
-- Adjust: change the damage and kill reward numbers below for offensive XP balance.
function AoE4RPG_CalculateAttackerExp(attacker, victim, damage, attacker_owner, victim_owner, unit_data)
    if not unit_data then
        unit_data = AoE4RPG_GetUnitData(attacker.EntityID)
    end

    unit_data.damage_dealt = (unit_data.damage_dealt or 0) + damage

    local victim_max_health = Entity_GetHealthMax and Entity_GetHealthMax(victim) or 100
    local gained_exp = 0

    if Entity_IsBuilding and Entity_IsBuilding(victim) then
        gained_exp = damage * 0.1
    else
        gained_exp = damage * 0.5
    end

    if victim and Entity_GetHealth and Entity_GetHealth(victim) <= 0 then
        local kill_bonus = victim_max_health * 0.5
        gained_exp = gained_exp + kill_bonus
        unit_data.kills = (unit_data.kills or 0) + 1
    end

    return gained_exp
end

-- Calculates the XP awarded to the victim for taking damage, so the unit can
-- still progress while being damaged by enemy attacks.
-- @param victim Entity receiving damage; @param damage Raw damage amount.
-- @return XP awarded for surviving damage (currently 35% of damage).
-- Adjust: change the damage fraction below for defensive XP balance.
function AoE4RPG_CalculateVictimExp(victim, attacker, damage, victim_owner, attacker_owner, unit_data)
    if not unit_data then
        unit_data = AoE4RPG_GetUnitData(victim.EntityID)
    end

    local damage_taken = damage * 0.35
    return damage_taken
end

-- Checks whether the unit has enough XP to level up, applies the new level,
-- and then applies the class stat growth and any level-up rewards.
-- @param entity Candidate hero/elite; @param unit_data Its mutable RPG record.
-- @param grant_bonus Whether offensive level-up rewards should be granted.
-- @return true/false plus final level; consumes overflow XP across multiple levels.
-- Adjust: keep LEVEL_OFFSET display-only; change XP and caps in their settings above.
function AoE4RPG_CheckAndApplyLevelUp(entity, owner, unit_data, grant_bonus)
    if not entity or not unit_data then
        return false, 0
    end

    local is_hero, is_elite = AoE4RPG_AssignEntityRole(entity, unit_data)
    if not is_hero and not is_elite then
        return false, unit_data.level
    end

    local max_level = AoE4RPG_GetEffectiveLevelLimit(entity)
    if unit_data.level >= max_level then
        if unit_data.exp ~= 0 then
            unit_data.exp = 0
            AoE4RPG_MarkUnitDataChanged(unit_data)
        end
        return false, unit_data.level
    end

    local leveled = false
    while unit_data.level < max_level do
        local required_exp = AoE4RPG_ExperienceRequired(unit_data.level)
        if unit_data.exp < required_exp then
            break
        end
        local overflow = unit_data.exp - required_exp
        local previous_level = unit_data.level
        unit_data.level = unit_data.level + 1
        unit_data.exp = overflow
        unit_data.base_exp = required_exp

        if AoE4RPG_CLASS_ApplyGrowth then
            local class_name = AoE4RPG_CLASS_GetClassForEntity(entity)
            if class_name then
                AoE4RPG_CLASS_ApplyGrowth(entity, class_name, unit_data.level)
                -- Class growth applies only this level's incremental modifiers;
                -- keep the aggregate translation for UI/data without reapplying
                -- all historical attributes to the entity.
                AoE4RPG_TranslateAttributesToStats(unit_data)
            end
        end

        local new_bracket = AoE4RPG_GetLevelBracketStep(unit_data.level)
        local previous_bracket = AoE4RPG_GetLevelBracketStep(previous_level)
        local reached_new_bracket = new_bracket > previous_bracket
        if reached_new_bracket then
            local class_name = unit_data.class_name or (AoE4RPG_CLASS_GetClassForEntity and AoE4RPG_CLASS_GetClassForEntity(entity))
            if class_name then
                AoE4RPG_ApplyBracketUpgrade(entity, owner, class_name, new_bracket)
            end
        end

        if AoE4RPG_UI_UpdateHeroesDisplay then
            AoE4RPG_UI_UpdateHeroesDisplay()
        end

        if grant_bonus and AoE4RPG_GrantLevelUpReward then
            AoE4RPG_GrantLevelUpReward(entity, owner, unit_data)
        end

        if AoE4RPG_PlayLevelUpSound then
            AoE4RPG_PlayLevelUpSound(owner, reached_new_bracket)
        end

        -- Class growth and every displayed reward for this level are complete;
        -- publish one revision so a selected unit refreshes on the next tick.
        AoE4RPG_MarkUnitDataChanged(unit_data)
        leveled = true
    end

    if unit_data.level >= max_level then
        if unit_data.exp ~= 0 then
            unit_data.exp = 0
            AoE4RPG_MarkUnitDataChanged(unit_data)
        end
    end

    return leveled, unit_data.level
end

-- Calculates the class damage bonus described by the class overview. Agility
-- scales with attack-speed investment, Endurance scales with current health,
-- and Vitality scales with the armor derived from total vitality. The returned
-- value is the desired aggregate bonus; callers apply only its delta.
-- @param entity Entity whose live health/type state may affect the result.
-- @param unit_data Bound record containing cumulative attributes and class key.
-- @return Aggregate damage modifier in UAGS multiplication-addition units.
-- Adjust: change primary-stat profile values instead of adding a second damage attribute.
function AoE4RPG_CalculateClassDamageBonus(entity, unit_data)
    if not entity or not unit_data then
        return 0
    end

    local attrs = unit_data.attributes or {}
    local class_name = unit_data.class_name or ""
    local profile = AoE4RPG_CLASS_DAMAGE_PROFILES and AoE4RPG_CLASS_DAMAGE_PROFILES[class_name]
    local class_def = AoE4RPG.CLASS_DEFINITIONS and AoE4RPG.CLASS_DEFINITIONS[class_name]
    if not profile or not class_def then
        return 0
    end

    local primary = AoE4RPG_GetPrimaryStatBonus(class_name)
    local primary_stat = class_def.stat_type
    local primary_rate = profile[primary_stat] or 0
    local agility = primary_stat == "agility" and (attrs.agility or 0) * primary_rate or 0
    local endurance = primary_stat == "endurance" and (attrs.endurance or 0) * primary_rate or 0
    local vitality = primary_stat == "vitality" and (attrs.vitality or 0) * primary_rate or 0

    local health_ratio = 1
    if Entity_GetHealth and Entity_GetHealthMax then
        local max_health = Entity_GetHealthMax(entity)
        if max_health and max_health > 0 then
            health_ratio = math.max(0, math.min(1, Entity_GetHealth(entity) / max_health))
        end
    end

    -- This function is called after CLASS_ApplyGrowth has applied the current
    -- level's class bonuses. Include those effective bonuses in the driver used
    -- for damage, rather than calculating from raw attributes alone.
    local attack_speed_multiplier = class_name == "ranger" and 2.0 or 1.0
    local attack_speed_factor = 1 + (attrs.agility or 0) * 0.01 * primary * attack_speed_multiplier

    -- Base translated armor plus the incremental class armor rules: normal
    -- Vitality armor, Duelist's doubled Vitality armor, and Roamer's Endurance
    -- armor. This keeps the damage calculation after those bonuses.
    local armor_value = (attrs.vitality or 0) * 0.2 * primary
        + (attrs.endurance or 0) * 0.2
        + (attrs.vitality or 0) * 0.6
    if class_name == "duelist" then
        armor_value = armor_value + (attrs.vitality or 0) * 0.6
    elseif class_name == "roamer" then
        armor_value = armor_value + (attrs.endurance or 0) * 0.3
    end
    local bonus = agility * attack_speed_factor + endurance * health_ratio + vitality * armor_value

    if class_name == "strategist" then
        local regen = (attrs.endurance or 0) * 0.05 * primary
        bonus = bonus + regen * 0.25
    end

    return math.max(0, bonus)
end

-- Applies a one-time bracket damage modifier when a hero or elite enters a new
-- level band, following the modifier-based reward pattern used by UAGS.
-- @param entity Target entity; @param class_name Class key for record isolation.
-- @param bracket_index One-based entry in UPGRADE_BRACKETS.
-- @side_effect Applies the bracket's one-time damage modifier to its squad/entity.
-- Adjust: change the upgrade names in UPGRADE_BRACKETS to swap bracket rewards.
function AoE4RPG_ApplyBracketUpgrade(entity, owner, class_name, bracket_index)
    if not entity or not class_name then
        return
    end

    local bracket = AoE4RPG.UPGRADE_BRACKETS[bracket_index]
    if not bracket or not bracket.upgrade then
        return
    end

    local unit_data = AoE4RPG_GetUnitData(entity.EntityID)
    if not unit_data then
        return
    end

    local upgrade_name = "upgrade_" .. tostring(class_name) .. "_" .. tostring(bracket.upgrade)
    if unit_data.applied_bracket_upgrades and unit_data.applied_bracket_upgrades[upgrade_name] then
        return
    end

    if unit_data.applied_bracket_upgrades then
        unit_data.applied_bracket_upgrades[upgrade_name] = true
    end

    -- UAGS applies level rewards through real entity/squad modifiers rather
    -- than invented Upgrade_* helpers. Keep each bracket one-time per entity.
    if Modifier_ApplyToEntity then
        local bonus = ({ damage1 = 0.10, damage2 = 0.20, damage3 = 0.30, damage5 = 0.50 })[bracket.upgrade] or 0
        local squad = Entity_GetSquad and Entity_GetSquad(entity)
        if squad and Modifier_ApplyToSquad then
            Modifier_ApplyToSquad(Modifier_Create(MAT_Weapon, "damage_weapon_modifier", MUT_MultiplicationAddition, false, bonus, ""), squad, 0)
        else
            Modifier_ApplyToEntity(Modifier_Create(MAT_Weapon, "damage_weapon_modifier", MUT_MultiplicationAddition, false, bonus, ""), entity, 0)
        end
    end
end

-- Small helper used by the class system to apply raw attribute bonuses such as
-- attack speed or armor without changing the overall progression record.
-- @param entity Entity receiving the modifier; @param stat_name Supported logical
-- stat (`attack_speed`, `damage`, `health`, or `armor`).
-- @param value Increment expressed in the class-growth scale.
-- @side_effect Converts the logical stat into UAGS entity/squad modifiers.
-- Adjust: add another elseif branch when a new logical stat needs an engine modifier.
function AoE4RPG_ApplyStatModifier(entity, stat_name, value)
    if not entity then
        return
    end

    if stat_name == "attack_speed" and Modifier_ApplyToEntity then
        local factor = math.max(0.01, 1 - value)
        Modifier_ApplyToEntity(Modifier_Create(MAT_Weapon, "reload_weapon_modifier", MUT_Multiplication, false, factor, ""), entity, 0)
        Modifier_ApplyToEntity(Modifier_Create(MAT_Weapon, "cooldown_weapon_modifier", MUT_Multiplication, false, factor, ""), entity, 0)
    elseif stat_name == "armor" and Modifier_ApplyToEntity then
        Modifier_ApplyToEntity(Modifier_Create(MAT_Entity, "armor_scalar_for_truedamage_damage", MUT_Addition, false, value, ""), entity, 0)
        Modifier_ApplyToEntity(Modifier_Create(MAT_Entity, "armor_scalar_for_fire_damage", MUT_Addition, false, value, ""), entity, 0)
        Modifier_ApplyToEntity(Modifier_Create(MAT_Entity, "armor_scalar_for_melee_damage", MUT_Addition, false, value, ""), entity, 0)
        Modifier_ApplyToEntity(Modifier_Create(MAT_Entity, "armor_scalar_for_ranged_damage", MUT_Addition, false, value, ""), entity, 0)
    elseif stat_name == "health" and Modifier_ApplyToEntity then
        Modifier_ApplyToEntity(Modifier_Create(MAT_Entity, "health_maximum_modifier", MUT_MultiplicationAddition, false, value / math.max(1, Entity_GetHealthMax(entity)), ""), entity, 0)
    elseif stat_name == "damage" and Modifier_ApplyToEntity then
        Modifier_ApplyToEntity(Modifier_Create(MAT_Weapon, "damage_weapon_modifier", MUT_Addition, false, value, entity), entity, 0)
    end
end

-- Fire when an entity is killed so the module can apply the correct death rules.
-- Heroes keep their level but lose XP, elite units lose one level, and regular
-- units lose a partial XP value instead of carrying all progress into the next
-- life or respawn.
-- @param context UAGS GE_EntityKilled payload; victim is preferred when present.
-- @side_effect Applies the role-specific death penalty to the tracked victim.
-- Adjust: change AoE4RPG_ApplyDeathPenalty for balance; keep this event wrapper simple.
function AoE4RPG_OnEntityKilled(context)
    if not context then
        return
    end

    local entity = context.victim or context.entity
    if not entity then
        return
    end
    local entity_id = entity.EntityID
    local data = AoE4RPG_GetUnitData(entity_id)

    if not data then
        return
    end

    if data.level > 0 then
        AoE4RPG_ApplyDeathPenalty(entity, data)
    end
end
