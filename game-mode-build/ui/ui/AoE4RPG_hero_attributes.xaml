<!-- AoE4RPG hero attribute overlay. Visible content is XP plus three attributes;
     derived statistics are available from the whole-panel hover popup. -->
<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        Width="208"
        Height="176"
        Padding="4"
        Visibility="{Binding [visible], Converter={StaticResource BoolToVis}}">
    <Border.Resources>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="pack://application:,,,ui/Resources/HUDResources.xaml" />
        </ResourceDictionary.MergedDictionaries>
    </Border.Resources>
    <Border.ToolTip>
        <ContentControl Style="{StaticResource HUDTooltipBorderStyle}">
            <Grid Width="208">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Derived Statistics" Style="{StaticResource nHUDSubheaderSmallTextBlockStyle}" />
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal"><TextBlock Text="AtkSpd: " Style="{StaticResource nHUDBaseTextBlockStyle}" /><TextBlock Text="{Binding [agility_stat]}" Style="{StaticResource nHUDBaseTextBlockStyle}" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Health: " Style="{StaticResource nHUDBaseTextBlockStyle}" /><TextBlock Text="{Binding [endurance_stat]}" Style="{StaticResource nHUDBaseTextBlockStyle}" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal"><TextBlock Text="Armor: " Style="{StaticResource nHUDBaseTextBlockStyle}" /><TextBlock Text="{Binding [vitality_stat]}" Style="{StaticResource nHUDBaseTextBlockStyle}" /></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal"><TextBlock Text="Cooldown: " Style="{StaticResource nHUDBaseTextBlockStyle}" /><TextBlock Text="{Binding [ability_cooldown_stat]}" Style="{StaticResource nHUDBaseTextBlockStyle}" /></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Regen: " Style="{StaticResource nHUDBaseTextBlockStyle}" /><TextBlock Text="{Binding [regeneration_stat]}" Style="{StaticResource nHUDBaseTextBlockStyle}" /></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal"><TextBlock Text="Production: " Style="{StaticResource nHUDBaseTextBlockStyle}" /><TextBlock Text="{Binding [production_stat]}" Style="{StaticResource nHUDBaseTextBlockStyle}" /></StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal"><TextBlock Text="Critical: " Style="{StaticResource nHUDBaseTextBlockStyle}" /><TextBlock Text="{Binding [critical_stat]}" Style="{StaticResource nHUDBaseTextBlockStyle}" /></StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"><TextBlock Text="Range: " Style="{StaticResource nHUDBaseTextBlockStyle}" /><TextBlock Text="{Binding [range_stat]}" Style="{StaticResource nHUDBaseTextBlockStyle}" /><TextBlock Text=" Speed/Setup:" Style="{StaticResource nHUDBaseTextBlockStyle}" /><TextBlock Text="{Binding [speed_stat]}" Style="{StaticResource nHUDBaseTextBlockStyle}" /></StackPanel>
            </Grid>
        </ContentControl>
    </Border.ToolTip>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- XP bar and displayed level number. -->
        <Border Grid.Row="0" Padding="1">
            <Grid Height="24" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Level" TextAlignment="Center" VerticalAlignment="Center" Height="20" Margin="0,3,0,0" FontSize="18" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
                <Grid Grid.Column="2" Width="116" Height="12" Margin="-46,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#80050B13">
                    <Border BorderBrush="#FF9A8352" BorderThickness="1" CornerRadius="1">
                        <Grid>
                            <Rectangle Fill="#FFFFD45C" Width="{Binding [exp_progress_width]}" HorizontalAlignment="Left" />
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Height="22" MinWidth="18" Padding="2,0" Background="#CC0B1320" BorderBrush="#FFE0B65A" BorderThickness="1" CornerRadius="1">
                                <TextBlock Text="{Binding [level_number]}" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptStyle}" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Keen attribute only. Native selection XAML owns derived statistics. -->
        <Border Grid.Row="1" Padding="4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="20" Height="20" Margin="0,0,5,0">
                    <Image Width="20" Height="20" Source="pack://application:,,,/WPFGUI;component/ui/races/abbasid/golden_age/golden_age_icon_overlay.png" Visibility="{Binding [agility_main_attribute_visible], Converter={StaticResource BoolToVis}}" />
                    <Image Width="20" Height="20" Source="pack://application:,,,/WPFGUI;component/icons/races/common/abilities/speed" />
                </Grid>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [agility_total]}" FontSize="14" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
                        <TextBlock Text=" + " Visibility="{Binding [agility_bonus_visible], Converter={StaticResource BoolToVis}}" FontSize="14" />
                        <TextBlock Text="{Binding [agility_bonus]}" Visibility="{Binding [agility_bonus_visible], Converter={StaticResource BoolToVis}}" FontSize="14" />
                    </StackPanel>
                    <TextBlock Text="{Binding [agility_growth]}" FontSize="9" Foreground="#FFB7C4D6" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Hearty attribute only. Native selection XAML owns health/regen. -->
        <Border Grid.Row="2" Padding="4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="20" Height="20" Margin="0,0,5,0">
                    <Image Width="20" Height="20" Source="pack://application:,,,/WPFGUI;component/ui/races/abbasid/golden_age/golden_age_icon_overlay.png" Visibility="{Binding [endurance_main_attribute_visible], Converter={StaticResource BoolToVis}}" />
                    <Image Width="20" Height="20" Source="pack://application:,,,/WPFGUI;component/icons/races/chinese_historic/abilities/body_of_iron_2" />
                </Grid>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [endurance_total]}" FontSize="14" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
                        <TextBlock Text=" + " Visibility="{Binding [endurance_bonus_visible], Converter={StaticResource BoolToVis}}" FontSize="14" />
                        <TextBlock Text="{Binding [endurance_bonus]}" Visibility="{Binding [endurance_bonus_visible], Converter={StaticResource BoolToVis}}" FontSize="14" />
                    </StackPanel>
                    <TextBlock Text="{Binding [endurance_growth]}" FontSize="9" Foreground="#FFB7C4D6" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Stout attribute only. Native selection XAML owns armor/cooldowns. -->
        <Border Grid.Row="3" Padding="4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="20" Height="20" Margin="0,0,5,0">
                    <Image Width="20" Height="20" Source="pack://application:,,,/WPFGUI;component/ui/races/abbasid/golden_age/golden_age_icon_overlay.png" Visibility="{Binding [vitality_main_attribute_visible], Converter={StaticResource BoolToVis}}" />
                    <Image Width="20" Height="20" Source="pack://application:,,,/WPFGUI;component/icons/races/hre_historic/upgrades/golden_cuirass" />
                </Grid>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [vitality_total]}" FontSize="14" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
                        <TextBlock Text=" + " Visibility="{Binding [vitality_bonus_visible], Converter={StaticResource BoolToVis}}" FontSize="14" />
                        <TextBlock Text="{Binding [vitality_bonus]}" Visibility="{Binding [vitality_bonus_visible], Converter={StaticResource BoolToVis}}" FontSize="14" />
                    </StackPanel>
                    <TextBlock Text="{Binding [vitality_growth]}" FontSize="9" Foreground="#FFB7C4D6" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Border>
