-- ================= AoE4RPG UI Panel ===============
-- AoE4RPG UI Panel - Panel Manager creates, updates, and removes guarded XamlPresenter panels.
-- Author: Hikitomi
-- Referenced: AoE4RPG_ui_main.scar and native XamlPresenter APIs.
-- ================= AoE4RPG UI Panel ===============

AoE4RPG = AoE4RPG or {}
AoE4RPG.UI_PANELS = AoE4RPG.UI_PANELS or {}

-- Rejects XAML that would make a reusable presenter unsafe to refresh.
local function AoE4RPG_UI_PanelValidate(name, xaml)
    if type(xaml) ~= "string" or xaml == "" then
        if AoE4RPG_DebugLog then
            AoE4RPG_DebugLog("UI panel " .. tostring(name) .. " has no XAML")
        end
        return false
    end
    if string.find(xaml, "x:Name=", 1, true) ~= nil then
        if AoE4RPG_DebugLog then
            AoE4RPG_DebugLog("UI panel " .. tostring(name) .. " contains x:Name")
        end
        return false
    end
    return true
end

-- Releases one module-owned presenter from our registry without touching the native UI tree.
function AoE4RPG_UI_PanelRemove(name)
    -- IMPORTANT: UI_Remove can unregister a XamlPresenter while its XAML children still exist.
    -- Cardinal treats that as a fatal UISelectionHandle lifecycle error, so visibility must be
    -- controlled through the data context and native match teardown must own final disposal.
    AoE4RPG.UI_PANELS[name] = nil
end

-- Removes every presenter registered by the AoE4RPG UI layer.
function AoE4RPG_UI_PanelRemoveAll()
    -- The game owns the ScarNotReplay HUD tree and safely disposes it when the match closes.
    -- IMPORTANT: Do not unregister parent presenters here while XAML child handles are still attached.
    AoE4RPG.UI_PANELS = {}
end

-- Creates one guarded XamlPresenter under the standalone HUD root.
function AoE4RPG_UI_PanelCreate(name, xaml, data_context, interactive, parent)
    if not UI_AddChild or not UI_CreateDataContext then
        return false
    end
    if not AoE4RPG_UI_PanelValidate(name, xaml) then
        return false
    end

    -- IMPORTANT: A successful presenter is permanent for this match.
    -- Startup retries may call this function again; update its context instead of unregistering
    -- a live presenter whose XAML descendants are still attached.
    if AoE4RPG.UI_PANELS[name] == true then
        if data_context ~= nil then
            AoE4RPG_UI_PanelSetData(name, data_context)
        end
        return true
    end
    local properties = {
        IsHitTestVisible = interactive == true,
        Xaml = xaml,
    }
    if data_context ~= nil then
        properties.DataContext = UI_CreateDataContext(data_context)
    end

    local ok, err = pcall(function()
        UI_AddChild(parent or "ScarNotReplay", "XamlPresenter", name, properties)
    end)
    if not ok then
        if AoE4RPG_DebugLog then
            AoE4RPG_DebugLog("UI panel " .. tostring(name) .. " failed: " .. tostring(err))
        end
        return false
    end

    AoE4RPG.UI_PANELS[name] = true
    return true
end

-- Refreshes the named presenter data context without recreating its XAML.
function AoE4RPG_UI_PanelSetData(name, data_context)
    if not UI_SetDataContext or not AoE4RPG.UI_PANELS[name] then
        return false
    end
    local ok = pcall(function()
        UI_SetDataContext(name, data_context)
    end)
    return ok
end
