-- ================= AoE4RPG Bracket Indicator ===============
-- AoE4RPG Bracket Indicator - Bracket Objective UI shows the current bracket and choice state in the objective UI.
-- Author: Hikitomi
-- Referenced: AoE4RPG_ui_panel.scar and AoE4RPG_random_bonus.scar.
-- ================= AoE4RPG Bracket Indicator ===============

if not AoE4RPG then AoE4RPG = {} end

AoE4RPG.BRACKET_INDICATOR = AoE4RPG.BRACKET_INDICATOR or {
    objective = nil,
    element_ids = {},
    initialized = false,
    text_prefix = "BRACKET ",
    text_suffix = " CHOICE",
    arrow = false,
    arrow_offset = 2,
}

-- Returns the local objective owner used by the overhead indicator.
function AoE4RPG_BONUS_INDICATOR_GetLocalPlayer()
    if Game_GetLocalPlayer then
        return Game_GetLocalPlayer()
    end
    return nil
end

-- Creates one hidden objective container for all local bracket indicators.
function AoE4RPG_BONUS_INDICATOR_Initialize()
    local indicator = AoE4RPG.BRACKET_INDICATOR
    if indicator.initialized and indicator.objective then
        return true
    end
    if not Objective_Register or not Objective_AddUIElements
        or not Objective_RemoveUIElements then
        return false
    end

    local player = AoE4RPG_BONUS_INDICATOR_GetLocalPlayer()
    if not player then
        return false
    end

    local objective = {
        Title = "",
        Type = OT_Secondary,
    }
    Objective_Register(objective, player)
    if objective.ID and Obj_SetState then
        Obj_SetState(objective.ID, OS_Complete)
    end
    if objective.ID and Obj_SetVisible then
        Obj_SetVisible(objective.ID, false)
    end

    indicator.objective = objective
    indicator.initialized = objective.ID ~= nil
    return indicator.initialized
end

-- Confirms that the entity is a local, tracked hero or elite and is not a rider attachment.
-- IMPORTANT: Riders share progression but are never selectable or presented with their own bracket choice.
function AoE4RPG_BONUS_INDICATOR_IsEligibleEntity(entity)
    if not entity or not entity.EntityID then
        return false
    end
    if Entity_IsValid and not Entity_IsValid(entity.EntityID) then
        return false
    end
    if Entity_IsOfType and Entity_IsOfType(entity, "rider") then
        return false
    end
    if not Entity_GetPlayerOwner or not Game_GetLocalPlayer then
        return false
    end
    local entity_owner = AoE4RPG_ENTITY_TRACKER_GetSafePlayerOwner
        and AoE4RPG_ENTITY_TRACKER_GetSafePlayerOwner(entity)
        or nil
    if not entity_owner then
        return false
    end
    local local_player = Game_GetLocalPlayer()
    local entity_owner_id = AoE4RPG_BONUS_GetPlayerIdentifier
        and AoE4RPG_BONUS_GetPlayerIdentifier(entity_owner)
        or (entity_owner and (entity_owner.PlayerID or entity_owner.id))
    local local_player_id = AoE4RPG_BONUS_GetPlayerIdentifier
        and AoE4RPG_BONUS_GetPlayerIdentifier(local_player)
        or (local_player and (local_player.PlayerID or local_player.id))
    if not entity_owner_id or not local_player_id
        or entity_owner_id ~= local_player_id then
        return false
    end

    local tracker = AoE4RPG.ENTITY_TRACKER
    local record = tracker and tracker.tracked_entity_records
        and tracker.tracked_entity_records[entity.EntityID]
        or nil
    return record and (record.role == "heroes" or record.role == "elites") or false
end

-- Removes one overhead indicator without requiring the dead entity handle.
function AoE4RPG_BONUS_INDICATOR_RemoveEntity(entity_id)
    local indicator = AoE4RPG.BRACKET_INDICATOR
    local element_id = entity_id and indicator.element_ids[entity_id] or nil
    if element_id and indicator.objective and Objective_RemoveUIElements then
        Objective_RemoveUIElements(indicator.objective, element_id)
    end
    if entity_id then
        indicator.element_ids[entity_id] = nil
    end
    return element_id ~= nil
end

-- Removes every local overhead indicator.
-- This is used after a shared elite choice, because one selection resolves the pending choice for all elites.
function AoE4RPG_BONUS_INDICATOR_Clear()
    local indicator = AoE4RPG.BRACKET_INDICATOR
    for entity_id in pairs(indicator.element_ids) do
        AoE4RPG_BONUS_INDICATOR_RemoveEntity(entity_id)
    end
    return true
end

-- Places the synchronized bracket-choice message above one eligible entity.
function AoE4RPG_BONUS_INDICATOR_Show(entity, bracket_index)
    if not AoE4RPG_BONUS_INDICATOR_IsEligibleEntity(entity)
        or not bracket_index
        or not AoE4RPG_BONUS_INDICATOR_Initialize() then
        return false
    end

    local indicator = AoE4RPG.BRACKET_INDICATOR
    AoE4RPG_BONUS_INDICATOR_RemoveEntity(entity.EntityID)

    local text = indicator.text_prefix .. tostring(bracket_index) .. indicator.text_suffix
    local element_id = Objective_AddUIElements(
        indicator.objective,
        entity,
        false,
        text,
        indicator.arrow,
        indicator.arrow_offset
    )
    if not element_id then
        return false
    end
    indicator.element_ids[entity.EntityID] = element_id
    return true
end

-- Refreshes the indicator from the same active offer used by the choice UI.
-- IMPORTANT: Keeps the overhead message correct after respawn or after consuming one offer while another crossed bracket remains queued.
function AoE4RPG_BONUS_INDICATOR_RefreshEntity(entity_id)
    if not entity_id or not AoE4RPG_BONUS_GetActiveOffer then
        return false
    end
    local entity = Entity_FromID and Entity_FromID(entity_id) or nil
    local offer = entity and AoE4RPG_BONUS_GetActiveOffer(entity_id) or nil
    if offer and type(offer.choices) == "table"
        and #offer.choices == (AoE4RPG.BONUS and AoE4RPG.BONUS.choices_per_offer or 3) then
        return AoE4RPG_BONUS_INDICATOR_Show(entity, offer.bracket_index)
    end
    return AoE4RPG_BONUS_INDICATOR_RemoveEntity(entity_id)
end
