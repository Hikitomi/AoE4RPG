local AoE4RPG_HERO_UI_CLASS_ABBREVIATION_LOC_IDS = {
    ranger = 2001,
    assassin = 2002,
    skirmisher = 2003,
    initiator = 2004,
    duelist = 2005,
    technician = 2006,
    commander = 2007,
    roamer = 2008,
    strategist = 2009,
}

local AoE4RPG_HERO_UI_CLASS_NAME_LOC_IDS = {
    ranger = 2010,
    assassin = 2011,
    skirmisher = 2012,
    initiator = 2013,
    duelist = 2014,
    technician = 2015,
    commander = 2016,
    roamer = 2017,
    strategist = 2018,
}

-- Returns the current locale's text object for one AoE4RPG localization ID.
function AoE4RPG_UI_Localize(localization_id)
    return Loc_FormatText(AoE4RPG.HERO_UI.localization_prefix .. tostring(localization_id))
end

-- Returns plain localized text when SCAR must combine a label with internal values.
function AoE4RPG_UI_LocalizeString(localization_id)
    local localized_text = AoE4RPG_UI_Localize(localization_id)
    return localized_text and localized_text.LocString or ""
end

-- Loads fixed Hero UI labels once per match.
function AoE4RPG_UI_InitializeLocalizedText()
    if AoE4RPG.HERO_UI.localized_static_text_initialized then
        return
    end
    local class_context = AoE4RPG.HERO_UI.class_slot_context
    class_context.title = AoE4RPG_UI_Localize(1980)
    local attribute_context = AoE4RPG.HERO_UI.attribute_context
    attribute_context.improvement_title = AoE4RPG_UI_Localize(1981)
    attribute_context.attack_speed_label = AoE4RPG_UI_Localize(1982)
    attribute_context.health_label = AoE4RPG_UI_Localize(1983)
    attribute_context.armor_label = AoE4RPG_UI_Localize(1984)
    attribute_context.cooldown_label = AoE4RPG_UI_Localize(1985)
    attribute_context.regeneration_label = AoE4RPG_UI_Localize(1986)
    attribute_context.production_label = AoE4RPG_UI_Localize(1987)
    attribute_context.critical_label = AoE4RPG_UI_Localize(1988)
    attribute_context.range_label = AoE4RPG_UI_Localize(1989)
    attribute_context.speed_setup_label = AoE4RPG_UI_Localize(1990)
    AoE4RPG.HERO_UI.localized_static_text_initialized = true
end

-- Updates the compact top-right class reservation display.
-- A class that is not present in the current civilization's RPG production registry is shown as 0/0.
function AoE4RPG_UI_UpdateClassSlotMenu()
    AoE4RPG_UI_InitializeLocalizedText()
    local context = AoE4RPG.HERO_UI.class_slot_context
    local class_slots = AoE4RPG.CLASS_SLOTS or {}
    local occupied = class_slots.occupied or {}
    local entity_counts = class_slots.entity_counts or {}
    local production_by_slot = class_slots.production_by_slot or {}
    local occupied_count = 0
    for _ in pairs(occupied) do
        occupied_count = occupied_count + 1
    end
    local maximum_class_slots = math.max(
        1,
        math.floor(tonumber(class_slots.maximum) or AoE4RPG.MaxClassSlots or 5)
    )
    -- Read the same state that drives the production lock.
    -- This avoids the UI showing 0/1 after the simulation has already reached the class limit.
    local has_global_capacity = not class_slots.production_limit_reached
        and occupied_count < maximum_class_slots
    local class_rows = {
        { key = "ranger" },
        { key = "assassin" },
        { key = "skirmisher" },
        { key = "initiator" },
        { key = "duelist" },
        { key = "technician" },
        { key = "commander" },
        { key = "roamer" },
        { key = "strategist" },
    }
    for _, row in ipairs(class_rows) do
        local production_rows = production_by_slot[row.key]
        local class_exists = type(production_rows) == "table"
            and next(production_rows) ~= nil
        local current_count = math.max(0, entity_counts[row.key] or 0)
        local is_elite_class = (AoE4RPG_IsClassFlaggedElite
            and AoE4RPG_IsClassFlaggedElite(class_slots.civilization, row.key))
            or (AoE4RPG_GetDynamicEliteLimitRule
                and AoE4RPG_GetDynamicEliteLimitRule(class_slots.civilization, row.key) ~= nil)
            or false
        local maximum_count = 1
        if is_elite_class and AoE4RPG_GetEliteConcurrentTrackingLimit then
            maximum_count = math.max(0, AoE4RPG_GetEliteConcurrentTrackingLimit(
                class_slots.civilization,
                row.key,
                class_slots.player_handle,
                current_count
            ))
        end
        local displayed_count = 0
        local displayed_maximum = 0
        if occupied[row.key] or (class_exists and has_global_capacity) then
            displayed_count = current_count
            displayed_maximum = maximum_count
        end
        local signature = tostring(displayed_count) .. "/" .. tostring(displayed_maximum)
        if AoE4RPG.HERO_UI.class_slot_signatures[row.key] ~= signature then
            context[row.key] = AoE4RPG_UI_LocalizeString(
                AoE4RPG_HERO_UI_CLASS_ABBREVIATION_LOC_IDS[row.key]
            ) .. " " .. signature
            AoE4RPG.HERO_UI.class_slot_signatures[row.key] = signature
        end
    end
    local census_enabled = AoE4RPG.debug_resource_census_enabled == true
    context.resource_census_visible = census_enabled
    if census_enabled then
        local census = (AoE4RPG.SETTINGS or {}).neutral_resource_census or {}
        local function census_text(prefix_localization_id, phase_name)
            local phase = census[phase_name]
            local gold_value = phase and tostring(phase.gold or 0) or "-"
            local stone_value = phase and tostring(phase.stone or 0) or "-"
            local relic_value = phase and tostring(phase.relics or 0) or "-"
            return AoE4RPG_UI_LocalizeString(prefix_localization_id)
                .. " " .. AoE4RPG_UI_LocalizeString(2029) .. gold_value
                .. " " .. AoE4RPG_UI_LocalizeString(2030) .. stone_value
                .. " " .. AoE4RPG_UI_LocalizeString(2031) .. relic_value
        end
        context.resource_census_preset = census_text(2024, "PreInit")
        context.resource_census_init = census_text(2025, "OnInit")
        context.resource_census_play = census_text(2026, "OnPlay before modifiers")
    end
    if AoE4RPG_UI_PanelSetData then
        AoE4RPG_UI_PanelSetData("AoE4RPG_ClassSlots", context)
    elseif UI_SetDataContext then
        UI_SetDataContext("AoE4RPG_ClassSlots", context)
    end
end

-- IMPORTANT: Keeps class reservation changes visible immediately after a hero or elite is tracked or removed, including changes made by respawn and rebind monitors.
function AoE4RPG_UI_MonitorClassSlotMenu()
    AoE4RPG_UI_UpdateClassSlotMenu()
end

function AoE4RPG_UI_StartClassSlotMenuMonitor()
    if AoE4RPG.HERO_UI.class_slot_monitor_registered then
        return true
    end
    if not Rule_AddInterval then
        return false
    end
    AoE4RPG_UI_UpdateClassSlotMenu()
    Rule_AddInterval(AoE4RPG_UI_MonitorClassSlotMenu, 0.25)
    AoE4RPG.HERO_UI.class_slot_monitor_registered = true
    return true
end

function AoE4RPG_UI_StopClassSlotMenuMonitor()
    if AoE4RPG.HERO_UI.class_slot_monitor_registered and Rule_Remove then
        Rule_Remove(AoE4RPG_UI_MonitorClassSlotMenu)
    end
    AoE4RPG.HERO_UI.class_slot_monitor_registered = false
end

-- Creates a UAGS-style top-right live class-slot menu.
-- It is read-only and does not change production availability or reservation state.
function AoE4RPG_UI_CreateClassSlotMenu()
    AoE4RPG_UI_InitializeLocalizedText()
    if not AoE4RPG_UI_PanelCreate and (not UI_AddChild or not UI_CreateDataContext) then
        return false
    end
    local xaml = [[
<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="0,60,10,0"
        Width="110"
        Padding="5,3"
        Panel.ZIndex="3"
        Background="#B0101824"
        BorderBrush="#FF9A8352"
        BorderThickness="1"
        Visibility="{Binding [visible], Converter={StaticResource BoolToVis}}">
  <StackPanel>
    <TextBlock Text="{Binding [title]}" FontSize="11" FontWeight="Bold" Foreground="#FFFFD45C" HorizontalAlignment="Center" Margin="0,0,0,2" />
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding [ranger]}" Width="52" FontSize="12" Foreground="#FFE6EDF5" />
      <TextBlock Text="{Binding [assassin]}" Width="52" FontSize="12" Foreground="#FFE6EDF5" />
    </StackPanel>
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding [skirmisher]}" Width="52" FontSize="12" Foreground="#FFE6EDF5" />
      <TextBlock Text="{Binding [initiator]}" Width="52" FontSize="12" Foreground="#FFE6EDF5" />
    </StackPanel>
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding [duelist]}" Width="52" FontSize="12" Foreground="#FFE6EDF5" />
      <TextBlock Text="{Binding [technician]}" Width="52" FontSize="12" Foreground="#FFE6EDF5" />
    </StackPanel>
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding [commander]}" Width="52" FontSize="12" Foreground="#FFE6EDF5" />
      <TextBlock Text="{Binding [roamer]}" Width="52" FontSize="12" Foreground="#FFE6EDF5" />
    </StackPanel>
    <TextBlock Text="{Binding [strategist]}" FontSize="12" Foreground="#FFE6EDF5" />
    <StackPanel Visibility="{Binding [resource_census_visible], Converter={StaticResource BoolToVis}}">
      <TextBlock Text="{Binding [resource_census_preset]}" FontSize="9" Foreground="#FFFFD45C" Margin="0,2,0,0" />
      <TextBlock Text="{Binding [resource_census_init]}" FontSize="9" Foreground="#FFFFD45C" />
      <TextBlock Text="{Binding [resource_census_play]}" FontSize="9" Foreground="#FFFFD45C" />
    </StackPanel>
  </StackPanel>
</Border>]]
    return AoE4RPG_UI_PanelCreate(
        "AoE4RPG_ClassSlots",
        xaml,
        AoE4RPG.HERO_UI.class_slot_context,
        false,
        "ScarNotReplay"
    )
end

-- Ensures we always have both the entity object and its ID.
-- IMPORTANT: You normally do not need to adjust this unless another callback returns a new value type.
function AoE4RPG_UI_NormalizeEntity(value)
    if type(value) == "number" then
        return Entity_FromID and Entity_FromID(value) or nil, value
    end
    if not value then
        return nil, nil
    end
    local id = value.EntityID or (Entity_GetID and Entity_GetID(value))
    return value, id
end

-- Updates every number shown in the selected hero/elite panel.
-- Pass nil to hide and reset the panel.
-- Change the string.format calls below to adjust display formatting.
function AoE4RPG_UI_UpdateHeroAttributes(entity)
    AoE4RPG_UI_InitializeLocalizedText()
    local context = AoE4RPG.HERO_UI.attribute_context
    if not entity then
        context.visible = false
        context.level_number = "1"
        context.exp_text = "0/0 " .. AoE4RPG_UI_LocalizeString(2027)
        context.exp_progress_width = "0"
        context.agility_total = "0"
        context.agility_growth = "+0/" .. AoE4RPG_UI_LocalizeString(2028)
        context.agility_bonus = "0"
        context.agility_bonus_visible = false
        context.agility_main_attribute_visible = false
        context.endurance_total = "0"
        context.endurance_growth = "+0/" .. AoE4RPG_UI_LocalizeString(2028)
        context.endurance_bonus = "0"
        context.endurance_bonus_visible = false
        context.endurance_main_attribute_visible = false
        context.vitality_total = "0"
        context.vitality_growth = "+0/" .. AoE4RPG_UI_LocalizeString(2028)
        context.vitality_bonus = "0"
        context.vitality_bonus_visible = false
        context.vitality_main_attribute_visible = false
        context.agility_stat = "0%"
        context.endurance_stat = "0"
        context.vitality_stat = "0"
        context.speed_stat = ""
        context.ability_cooldown_stat = "0%"
        context.regeneration_stat = "0/s"
        context.production_stat = "0%"
        context.critical_stat = "0% | 0%"
        context.range_stat = "0%"
        if AoE4RPG_UI_PanelSetData then
            AoE4RPG_UI_PanelSetData("AoE4RPG_HeroAttributes", context)
            AoE4RPG_UI_PanelSetData("AoE4RPG_HeroDerivedStats", context)
        elseif UI_SetDataContext then
            UI_SetDataContext("AoE4RPG_HeroAttributes", context)
            UI_SetDataContext("AoE4RPG_HeroDerivedStats", context)
        end
        return
    end

    local entity_id
    entity, entity_id = AoE4RPG_UI_NormalizeEntity(entity)
    if not entity or not entity_id then
        return AoE4RPG_UI_UpdateHeroAttributes(nil)
    end
    -- IMPORTANT: Buildings and their garrison containers never show RPG progression.
    -- This prevents an outpost or garrison selection from inheriting a unit panel.
    if Entity_IsOfType and Entity_IsOfType(entity, "building") then
        return AoE4RPG_UI_UpdateHeroAttributes(nil)
    end
    if not AoE4RPG_ENTITY_TRACKER_IsTrackedEntityIdentifier
        or not AoE4RPG_ENTITY_TRACKER_IsTrackedEntityIdentifier(entity_id) then
        return AoE4RPG_UI_UpdateHeroAttributes(nil)
    end
    local data = AoE4RPG_GetExistingUnitData
        and AoE4RPG_GetExistingUnitData(entity_id)
        or nil
    -- The overlay is reserved for entities with an RPG attribute record.
    -- IMPORTANT: A native unit can be selected without having any RPG attributes at all.
    if not data or type(data.attributes) ~= "table" then
        return AoE4RPG_UI_UpdateHeroAttributes(nil)
    end
    local class_profile = AoE4RPG_CLASS_GetEntityProfile
        and AoE4RPG_CLASS_GetEntityProfile(entity)
        or nil
    if not class_profile then
        return AoE4RPG_UI_UpdateHeroAttributes(nil)
    end
    context.visible = true
    local main_attribute = class_profile.stat_type or ""
    context.agility_main_attribute_visible = main_attribute == "agility"
    context.endurance_main_attribute_visible = main_attribute == "endurance"
    context.vitality_main_attribute_visible = main_attribute == "vitality"
    -- The class registry owns the cached class values.
    -- Merge only this unit's level and selected bonuses before presenting the result.
    local class_values = AoE4RPG_CLASS_GetEntityValues
        and AoE4RPG_CLASS_GetEntityValues(entity, data)
        or data
    local stats = class_values.derived_stats or data.derived_stats
    local level = data.level or 0
    local progress = AoE4RPG_CLASS_GetEntityProgress
        and AoE4RPG_CLASS_GetEntityProgress(entity_id)
        or nil
    local required_xp = data.uses_native_experience
        and (data.native_experience_required or 0)
        or AoE4RPG_ExperienceRequired(level)
    local current_xp = progress and progress.damage_dealt
        or data.damage_dealt
        or 0
    context.level_number = tostring(level + (AoE4RPG.LEVEL_OFFSET or 1))
    context.exp_text = required_xp > 0
        -- IMPORTANT: XP can be fractional because native damage/progress state models are floats.
        -- Round only the localized display text and leave progression calculations exact.
        and string.format("%.0f/%.0f", current_xp, required_xp)
            .. " " .. AoE4RPG_UI_LocalizeString(2027)
        or AoE4RPG_UI_Localize(1992)
    local exp_ratio = required_xp > 0
        and math.max(0, math.min(1, current_xp / required_xp))
        or 1
    context.exp_progress_width = tostring(math.floor(exp_ratio * 164))                                             -- XP fill width inside the reduced content area and 1px border padding.
    local non_bonus = class_values.non_bonus_attributes or data.non_bonus_attributes or data.attributes or {}
    local total = class_values.attributes or data.attributes or {}
    local function format_attribute(value)
        return string.format("%g", AoE4RPG_RoundToStep(value or 0, 0.25))
    end
    local growth = data.class_attribute_growth
        or class_profile.attribute_growth
        or {}
    local function format_attribute_growth(value)
        return "+" .. string.format("%g", AoE4RPG_RoundToStep(value or 0, 0.25))
            .. "/" .. AoE4RPG_UI_LocalizeString(2028)
    end
    local function set_attribute_pair(name)
        local non_bonus_value = non_bonus[name] or 0
        local bonus_value = (total[name] or 0) - non_bonus_value
        context[name .. "_total"] = format_attribute(non_bonus_value)
        context[name .. "_bonus"] = format_attribute(bonus_value)
        context[name .. "_bonus_visible"] = math.abs(bonus_value) > 0.001
        context[name .. "_growth"] = format_attribute_growth(growth[name])
    end
    set_attribute_pair("agility")
    set_attribute_pair("endurance")
    set_attribute_pair("vitality")
    local attribute_upgrade_stars = class_values.attribute_upgrade_stars
        or { health = 0, armor = 0, weapon_range = 0, speed = 0, siege_setup = 0 }
    local upgrade_star = "\226\152\133" -- UTF-8 star glyph, kept as byte escapes for SCAR source compatibility.
    local function format_upgrade_stars(count)
        count = math.max(0, math.floor(tonumber(count) or 0))
        return count > 0 and (" " .. upgrade_star .. " x" .. tostring(count)) or ""
    end
    context.agility_stat = string.format("%.0f%%", (stats.weapon_reload_modifier or 0) * 100)                    -- Attack Speed bonus.
    context.endurance_stat = string.format("%d", math.floor(stats.health or 0))
        .. format_upgrade_stars(attribute_upgrade_stars.health)                                                   -- Health bonus and automatic Health upgrade stars.
    context.regeneration_stat = string.format("%.0f/s", stats.health_regeneration or 0)                         -- Health Regeneration bonus.
    context.vitality_stat = string.format("%.0f", stats.armor or 0)
        .. format_upgrade_stars(attribute_upgrade_stars.armor)                                                    -- Armor bonus and automatic Armor upgrade stars.
    context.speed_stat = attribute_upgrade_stars.siege_setup
        and attribute_upgrade_stars.siege_setup > 0
        and format_upgrade_stars(attribute_upgrade_stars.siege_setup)
        or format_upgrade_stars(attribute_upgrade_stars.speed)                                                    -- Speed or Siege Setup upgrade stars.
    context.ability_cooldown_stat = string.format("%.0f%%", (stats.ability_cooldown_modifier or 0) * 100)       -- IMPORTANT: Ability Cooldown modifier.
    local production_bonus = data.build_speed_bonus or data.train_speed_bonus or data.production_speed_bonus or 0 -- Repair, Construction, and Production bonuses are all the same.
    context.production_stat = string.format("%.0f%%", production_bonus)
    context.critical_stat = string.format(
        "%.0f%% | %.0f%%",
        (stats.critical_hit_chance or 0) * 100,
        (class_values.weapon_crit_damage_factor or data.weapon_crit_damage_factor or 0) * 100
    )                                                                                                             -- Critical Chance | Critical Damage.
    context.range_stat = string.format("%.0f%%", (stats.weapon_range_modifier or 0) * 100)
        .. format_upgrade_stars(attribute_upgrade_stars.weapon_range)                                             -- Weapon Range bonus and automatic range upgrade stars.
    if AoE4RPG_UI_PanelSetData then
        AoE4RPG_UI_PanelSetData("AoE4RPG_HeroAttributes", context)
        AoE4RPG_UI_PanelSetData("AoE4RPG_HeroDerivedStats", context)
    elseif UI_SetDataContext then
        UI_SetDataContext("AoE4RPG_HeroAttributes", context)
        UI_SetDataContext("AoE4RPG_HeroDerivedStats", context)
    end
end

-- Creates the XAML panel and adds it to the normal game HUD.
-- Adjust Margin to move it, Width/Height to resize it, and row/column values to change spacing.
function AoE4RPG_UI_CreateHeroAttributesUI()
    AoE4RPG_UI_InitializeLocalizedText()
    if not AoE4RPG_UI_PanelCreate and (not UI_AddChild or not UI_CreateDataContext) then
        if AoE4RPG_DebugLog then
            AoE4RPG_DebugLog("hero presenter APIs unavailable")
        end
        return false
    end

    local xaml = [[
<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        RenderTransformOrigin="0.5,1"
        Margin="428,0,0,4"
        Width="178"
        Height="176"
        Visibility="{Binding [visible], Converter={StaticResource BoolToVis}}"
        Padding="4">
    <Border.Resources>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,ui/Resources/HUDResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </Border.Resources>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="148" /></Grid.RowDefinitions>
      <!-- Keep the XP box and its bound fill inside the 176px content area. -->
      <Border Grid.Row="0" Padding="1">
        <Grid Height="24" VerticalAlignment="Center">
          <Grid Width="164" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#80050B13">
            <Border BorderBrush="#FF9A8352" BorderThickness="1" CornerRadius="1"><Grid><Rectangle Fill="#FFFFD45C" Width="{Binding [exp_progress_width]}" HorizontalAlignment="Left" /><Border HorizontalAlignment="Center" VerticalAlignment="Center" Height="22" MinWidth="18" Padding="2,0" Background="#CC0B1320" BorderBrush="#FFE0B65A" BorderThickness="1" CornerRadius="1"><TextBlock Text="{Binding [level_number]}" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptStyle}" /></Border></Grid></Border>
          </Grid>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="40" />
        <RowDefinition Height="40" />
      </Grid.RowDefinitions>

      <!-- Keen attribute only; native selection XAML owns derived statistics. -->
      <Border Grid.Row="0" Padding="4">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Grid layers the class-main-attribute marker under the normal icon. -->
          <Grid Width="20" Height="20" Margin="0,0,5,0">
            <Image Width="20" Height="20" Source="pack://application:,,,/WPFGUI;component/icons/races/abbasid/golden_age/golden_age_icon_overlay.png" Visibility="{Binding [agility_main_attribute_visible], Converter={StaticResource BoolToVis}}" />
            <Image Width="20" Height="20" Source="pack://application:,,,/WPFGUI;component/icons/races/common/abilities/speed" />
          </Grid>
          <StackPanel Orientation="Vertical" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding [agility_total]}" FontSize="14" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
              <TextBlock Text="{Binding [bonus_separator]}" Margin="3,0" FontSize="14" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
              <TextBlock Text="{Binding [agility_bonus]}" FontSize="14" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
            </StackPanel>
            <TextBlock Text="{Binding [agility_growth]}" FontSize="9" Foreground="#FFB7C4D6" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Hearty attribute only; native selection XAML owns health/regen. -->
      <Border Grid.Row="1" Padding="4">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="20" Height="20" Margin="0,0,5,0">
            <Image Width="20" Height="20" Source="pack://application:,,,/WPFGUI;component/icons/races/abbasid/golden_age/golden_age_icon_overlay.png" Visibility="{Binding [endurance_main_attribute_visible], Converter={StaticResource BoolToVis}}" />
            <Image Width="20" Height="20" Source="pack://application:,,,/WPFGUI;component/icons/races/chinese_historic/abilities/body_of_iron_2" />
          </Grid>
          <StackPanel Orientation="Vertical" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding [endurance_total]}" FontSize="14" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
              <TextBlock Text="{Binding [bonus_separator]}" Margin="3,0" FontSize="14" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
              <TextBlock Text="{Binding [endurance_bonus]}" FontSize="14" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
            </StackPanel>
            <TextBlock Text="{Binding [endurance_growth]}" FontSize="9" Foreground="#FFB7C4D6" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Stout attribute only; native selection XAML owns armor/cooldowns. -->
      <Border Grid.Row="2" Padding="4">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="20" Height="20" Margin="0,0,5,0">
            <Image Width="20" Height="20" Source="pack://application:,,,/WPFGUI;component/icons/races/abbasid/golden_age/golden_age_icon_overlay.png" Visibility="{Binding [vitality_main_attribute_visible], Converter={StaticResource BoolToVis}}" />
            <Image Width="20" Height="20" Source="pack://application:,,,/WPFGUI;component/icons/races/hre_historic/upgrades/golden_cuirass" />
          </Grid>
          <StackPanel Orientation="Vertical" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding [vitality_total]}" FontSize="14" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
              <TextBlock Text="{Binding [bonus_separator]}" Margin="3,0" FontSize="14" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
              <TextBlock Text="{Binding [vitality_bonus]}" FontSize="14" Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptNoShadowStyle}" />
            </StackPanel>
            <TextBlock Text="{Binding [vitality_growth]}" FontSize="9" Foreground="#FFB7C4D6" />
          </StackPanel>
        </StackPanel>
      </Border>
      </Grid>

    </Grid>
</Border>]]

    if AoE4RPG_UI_PanelCreate then
        return AoE4RPG_UI_PanelCreate(
            "AoE4RPG_HeroAttributes",
            xaml,
            AoE4RPG.HERO_UI.attribute_context,
            true,
            "ScarNotReplay"
        )
    end

    local ok = pcall(function()
        UI_AddChild("ScarNotReplay", "XamlPresenter", "AoE4RPG_HeroAttributes", {
            IsHitTestVisible = true,
            Xaml = xaml,
            DataContext = UI_CreateDataContext(AoE4RPG.HERO_UI.attribute_context),
        })
    end)
    return ok
end

-- Creates the standalone derived-statistics presenter beside the hero attributes.
function AoE4RPG_UI_CreateHeroDerivedStatsUI()
    local xaml = [[
<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        Margin="522,0,0,4"
        Width="176"
        Height="176"
        Visibility="{Binding [visible], Converter={StaticResource BoolToVis}}"
        Padding="4,32,0,0">
    <Border.Resources>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,ui/Resources/HUDResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </Border.Resources>
    <StackPanel>
      <TextBlock Text="{Binding [improvement_title]}" FontSize="11" FontWeight="Bold" Foreground="#FFFFD45C" />
      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding [attack_speed_label]}" Margin="0,0,2,0" FontSize="9" Foreground="#FFE6EDF5" /><TextBlock Text="{Binding [agility_stat]}" FontSize="9" Foreground="#FFE6EDF5" /></StackPanel>
      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding [health_label]}" Margin="0,0,2,0" FontSize="9" Foreground="#FFE6EDF5" /><TextBlock Text="{Binding [endurance_stat]}" FontSize="9" Foreground="#FFE6EDF5" /></StackPanel>
      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding [armor_label]}" Margin="0,0,2,0" FontSize="9" Foreground="#FFE6EDF5" /><TextBlock Text="{Binding [vitality_stat]}" FontSize="9" Foreground="#FFE6EDF5" /></StackPanel>
      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding [cooldown_label]}" Margin="0,0,2,0" FontSize="9" Foreground="#FFE6EDF5" /><TextBlock Text="{Binding [ability_cooldown_stat]}" FontSize="9" Foreground="#FFE6EDF5" /></StackPanel>
      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding [regeneration_label]}" Margin="0,0,2,0" FontSize="9" Foreground="#FFE6EDF5" /><TextBlock Text="{Binding [regeneration_stat]}" FontSize="9" Foreground="#FFE6EDF5" /></StackPanel>
      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding [production_label]}" Margin="0,0,2,0" FontSize="9" Foreground="#FFE6EDF5" /><TextBlock Text="{Binding [production_stat]}" FontSize="9" Foreground="#FFE6EDF5" /></StackPanel>
      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding [critical_label]}" Margin="0,0,2,0" FontSize="9" Foreground="#FFE6EDF5" /><TextBlock Text="{Binding [critical_stat]}" FontSize="9" Foreground="#FFE6EDF5" /></StackPanel>
      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding [range_label]}" Margin="0,0,2,0" FontSize="9" Foreground="#FFE6EDF5" /><TextBlock Text="{Binding [range_stat]}" FontSize="9" Foreground="#FFE6EDF5" /></StackPanel>
      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding [speed_setup_label]}" Margin="0,0,2,0" FontSize="9" Foreground="#FFE6EDF5" /><TextBlock Text="{Binding [speed_stat]}" FontSize="9" Foreground="#FFE6EDF5" /></StackPanel>
    </StackPanel>
</Border>]]

    if AoE4RPG_UI_PanelCreate then
        return AoE4RPG_UI_PanelCreate(
            "AoE4RPG_HeroDerivedStats",
            xaml,
            AoE4RPG.HERO_UI.attribute_context,
            false,
            "ScarNotReplay"
        )
    end

    local ok = pcall(function()
        UI_AddChild("ScarNotReplay", "XamlPresenter", "AoE4RPG_HeroDerivedStats", {
            IsHitTestVisible = false,
            Xaml = xaml,
            DataContext = UI_CreateDataContext(AoE4RPG.HERO_UI.attribute_context),
        })
    end)
    return ok
end

-- This builds the old text version of the XP bar for the stored hero list.
-- IMPORTANT: Change bar_width or pass a different width if this text fallback needs to be longer.
function AoE4RPG_UI_BuildXPBar(current_xp, required_xp, width)
    local bar_width = width or 20
    local required = math.max(1, required_xp or 1)
    local ratio = math.max(0, math.min(1, (current_xp or 0) / required))
    local filled = math.floor(ratio * bar_width)
    local empty = bar_width - filled
    return string.rep("=", filled) .. string.rep("-", empty)
end

-- This builds one readable progress line for the stored hero/elite list.
-- Change the final string.format layout if a debug screen needs different text.
function AoE4RPG_UI_GetHeroProgressText(entity)
    local entity_object, entity_id = AoE4RPG_UI_NormalizeEntity(entity)
    if not entity_object or not entity_id then
        return ""
    end
    local unit_data = AoE4RPG_GetExistingUnitData
        and AoE4RPG_GetExistingUnitData(entity_id)
        or nil
    if not unit_data then
        return ""
    end

    local class_profile = AoE4RPG_CLASS_GetEntityProfile
        and AoE4RPG_CLASS_GetEntityProfile(entity_object)
        or nil
    local class_name = unit_data.class_name
        or class_profile and class_profile.class_name
        or "hero"
    local localized_class_name = AoE4RPG_UI_Localize(
        AoE4RPG_HERO_UI_CLASS_NAME_LOC_IDS[class_name] or 1998
    )
    local level = unit_data.level or 0
    local required = unit_data.uses_native_experience
        and (unit_data.native_experience_required or 0)
        or AoE4RPG_ExperienceRequired(level)
    local progress = AoE4RPG_CLASS_GetEntityProgress
        and AoE4RPG_CLASS_GetEntityProgress(entity_object)
        or nil
    local current_xp = progress and progress.damage_dealt
        or unit_data.damage_dealt
        or 0
    local bar = AoE4RPG_UI_BuildXPBar(current_xp, math.max(1, required), 20)
    local experience_text = required > 0
        -- IMPORTANT: The text fallback uses the same float progress source as the XAML presenter.
        -- IMPORTANT: Round only for display; do not truncate stored XP.
        and string.format("%.0f/%.0f", current_xp, required)
        or AoE4RPG_UI_LocalizeString(1996)

    return localized_class_name.LocString
        .. " " .. AoE4RPG_UI_LocalizeString(2028)
        .. " " .. tostring(level + (AoE4RPG.LEVEL_OFFSET or 1))
        .. " | " .. experience_text
        .. " | [" .. bar .. "]"
end

-- Creates the small data table used to track hero/elite progress entries.
-- Change the default name or title only if another script also uses this panel key.
function AoE4RPG_UI_CreateHeroPanel(name)
    local panel = {
        name = name or "heroes_elites",
        title = AoE4RPG_UI_Localize(1997),
        visible = true,
        entries = {},
    }

    AoE4RPG.HERO_UI.panels[name or "heroes_elites"] = panel
    return panel
end

-- This rebuilds the stored hero/elite progress list from tracked EntityIDs only.
-- IMPORTANT: Normal operation never scans the world or tests unrelated regular units.
function AoE4RPG_UI_RefreshHeroProgress()
    if not AoE4RPG or not AoE4RPG.HERO_UI then
        return
    end

    local panel = AoE4RPG.HERO_UI.panels["heroes_elites"]
    if not panel then
        panel = AoE4RPG_UI_CreateHeroPanel("heroes_elites")
    end

    panel.entries = {}

    if not AoE4RPG_ENTITY_TRACKER_ForEachTrackedEntity then
        return
    end

    AoE4RPG_ENTITY_TRACKER_ForEachTrackedEntity(function(entity, entity_id)
        table.insert(panel.entries, AoE4RPG_UI_GetHeroProgressText(entity_id))
    end)
end

-- Creates the hero data panel and the visible attribute XAML once.
-- Adjust the XAML function above for visual changes.
function AoE4RPG_UI_InitializeHeroesDisplay()
    local panel = AoE4RPG_UI_CreateHeroPanel("heroes_elites")
    panel.visible = true
    if not AoE4RPG_UI_CreateHeroAttributesUI() then
        return false
    end
    if not AoE4RPG_UI_CreateHeroDerivedStatsUI() then
        return false
    end
    return panel
end

-- This is a short helper used after XP or level data changes.
-- It should stay small so callers only need one refresh function name.
function AoE4RPG_UI_UpdateHeroesDisplay()
    AoE4RPG_UI_RefreshHeroProgress()
end

-- This gives the bootstrap a simple name for starting the hero UI.
-- Keep this alias if other host scripts already call InitializeHeroBar.
-- ADJUST: point this at another initializer only if the whole hero display is replaced.
function AoE4RPG_UI_InitializeHeroBar()
    return AoE4RPG_UI_InitializeHeroesDisplay()
end
