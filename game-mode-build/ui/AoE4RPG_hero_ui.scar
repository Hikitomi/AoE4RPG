        strategist = "",
        resource_census_visible = false,
        resource_census_preset = "",
        resource_census_init = "",
        resource_census_play = "",
    },
    class_slot_monitor_registered = false,
    attribute_context = {
        visible = false,
        bonus_separator = "+",
        improvement_title = "",
        attack_speed_label = "",
        health_label = "",
        armor_label = "",
        cooldown_label = "",
        regeneration_label = "",
        production_label = "",
        critical_label = "",
