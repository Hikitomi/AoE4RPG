    localization_prefix = "$98552b27dfde4300a0ed44aa6e97017d:",
    localized_static_text_initialized = false,
    panels = {},
    class_slot_signatures = {},
    class_slot_context = {
        visible = true,
        title = "",
        ranger = "",
        assassin = "",
        skirmisher = "",
