-- ================= AoE4RPG Settings ===============
-- AoE4RPG Settings - Match Settings Bridge reads match options and applies player and AI settings.
-- Author: Hikitomi
-- Referenced: AoE4RPG_economic_blueprints.scar and winconditions/AoE4RPG.scar.
-- ================= AoE4RPG Settings ===============

AoE4RPG = AoE4RPG or {}

AoE4RPG.SETTINGS = AoE4RPG.SETTINGS or {
    initialized = false,
    economy_applied = false,
    map_resource_preset_applied = false,
    map_resource_modifier_scheduled = false,
    map_deposit_entities = {},
    map_deposit_monitor_registered = false,
    map_resource_census_logged = false,
    map_animal_census_logged = false,
    animal_deposit_scan_scheduled = false,
    animal_deposit_scan_attempts_remaining = 0,
    option_key = "option_aorpg_uncapped_hero_elite_levels",
    class_slot_option_key = "option_aorpg_max_class_slots",
    -- The legacy key remains readable for older cached lobbies.
    -- New RDOs use separate human and AI values.
    xp_option_key = "option_aorpg_xp_multiplier",
    xp_option_keys = {
        human = "option_aorpg_human_xp_multiplier",
        ai = "option_aorpg_ai_xp_multiplier",
    },
    victory_option_keys = {
        annihilation = "option_aorpg_victory_annihilation",
        conquest = "option_aorpg_victory_conquest",
        regicide = "option_aorpg_victory_regicide",
    },
    -- Retained only so an older cached RDO can still start one condition.
    legacy_victory_mode_option_key = "option_aorpg_victory_mode",
    king_level_minutes_option_key = "option_aorpg_king_level_minutes",
    wall_health_option_key = "option_aorpg_wall_health_multiplier",
    ai_keep_experience_on_death_option_key =
        "option_aorpg_ai_keep_experience_on_death",
    -- IMPORTANT: Source-level fallback.
    -- Hosts can override this before initialization with AoE4RPG.KING_LEVEL_MINUTES when no RDO option is present.
    king_level_minutes = AoE4RPG.KING_LEVEL_MINUTES or 5,
    population_option_keys = {
        player = "option_aorpg_player_max_population",
        ai = "option_aorpg_ai_max_population",
    },
    resource_option_keys = {
        food = "option_aorpg_map_resource_food",
        wood = "option_aorpg_map_resource_wood",
        gold = "option_aorpg_map_resource_gold",
        stone = "option_aorpg_map_resource_stone",
    },
    speed_option_keys = {
        player = {
            gather = "option_aorpg_player_gather_speed",
            build = "option_aorpg_player_build_speed",
            train = "option_aorpg_player_train_speed",
        },
        ai = {
            gather = "option_aorpg_ai_gather_speed",
            build = "option_aorpg_ai_build_speed",
            train = "option_aorpg_ai_train_speed",
        },
    },
}
AoE4RPG.SETTINGS.map_deposit_entities =
    AoE4RPG.SETTINGS.map_deposit_entities or {}
AoE4RPG.SETTINGS.map_deposit_monitor_registered =
    AoE4RPG.SETTINGS.map_deposit_monitor_registered or false
AoE4RPG.SETTINGS.map_resource_modifier_scheduled =
    AoE4RPG.SETTINGS.map_resource_modifier_scheduled or false

-- Resolves a PLAYERS entry or PlayerID before native Player APIs use it.
local function AoE4RPG_Settings_ResolvePlayer(player)
    if AoE4RPG_RUNTIME_GetPlayerHandle then
        return AoE4RPG_RUNTIME_GetPlayerHandle(player)
    end
    if type(player) ~= "number" then
        return player
    end
    local player_from_id = Player_FromId or Player_FromID
    return player_from_id and player_from_id(player) or nil
end

-- Converts the UAGS-style victory selection into a stable internal mode key.
local function AoE4RPG_Settings_ReadVictoryMode(value)
    if type(value) == "string" then
        if value == "aorpg_victory_annihilation" then
            return "annihilation"
        elseif value == "aorpg_victory_regicide" then
            return "regicide"
        elseif value == "aorpg_victory_conquest" then
            return "conquest"
        end
    elseif type(value) == "table" then
        local enum_value = value.enum_value or value.key or value.value_key
        if type(enum_value) == "string" then
            return AoE4RPG_Settings_ReadVictoryMode(enum_value)
        end
        if type(enum_value) == "number" and type(value.enum_items) == "table" then
            for item_key, item_value in pairs(value.enum_items) do
                if item_value == enum_value then
                    return AoE4RPG_Settings_ReadVictoryMode(item_key)
                end
            end
        end
    end
    return "conquest"
end

-- Reads the fixed number of minutes required for one Regicide king step.
local function AoE4RPG_Settings_ReadKingLevelMinutes(value, default_value)
    local function parse_token(token)
        if type(token) == "number" then
            return token
        end
        if type(token) ~= "string" then
            return nil
        end
        return tonumber(token)
            or tonumber(string.match(token, "^aorpg_king_level_minutes_(%d+)$"))
    end

    local parsed = parse_token(value)
    if parsed and parsed > 0 then
        return parsed
    end
    if type(value) == "table" then
        local enum_value = value.enum_value or value.key or value.value_key
        if type(enum_value) == "number" and type(value.enum_items) == "table" then
            for item_key, item_value in pairs(value.enum_items) do
                if item_value == enum_value then
                    parsed = parse_token(item_key)
                    break
                end
            end
        else
            parsed = parse_token(enum_value) or parse_token(value.value)
        end
    end
    if parsed and parsed > 0 then
        return parsed
    end
    return default_value
end

-- Recursively finds an option regardless of which RDO section contains it.
local function AoE4RPG_Settings_FindOption(value, option_key)
    if type(value) ~= "table" then
        return nil
    end
    if value[option_key] ~= nil then
        return value[option_key]
    end
    for _, child in pairs(value) do
        local result = AoE4RPG_Settings_FindOption(child, option_key)
        if result ~= nil then
            return result
        end
    end
    return nil
end

local function AoE4RPG_Settings_ReadBoolean(value, default_value)
    if type(value) == "boolean" then
        return value
    end
    if type(value) == "number" then
        return value ~= 0
    end
    if type(value) == "string" then
        if value == "true" or value == "1" then
            return true
        elseif value == "false" or value == "0" then
            return false
        end
    elseif type(value) == "table" then
        return AoE4RPG_Settings_ReadBoolean(
            value.value or value.boolean_value or value.enabled,
            default_value
        )
    end
    return default_value
end

-- Converts the UAGS-style game_rates enum key into its numeric multiplier.
local function AoE4RPG_Settings_ParseMultiplierKey(value)
    local multipliers = {
        game_rates_000 = 0.00,
        game_rates_010 = 0.10,
        game_rates_025 = 0.25,
        game_rates_050 = 0.50,
        game_rates_075 = 0.75,
        game_rates_1 = 1.00,
        game_rates_1_25 = 1.25,
        game_rates_1_50 = 1.50,
        game_rates_1_75 = 1.75,
        game_rates_2 = 2.00,
        game_rates_2_50 = 2.50,
        game_rates_3 = 3.00,
        game_rates_4 = 4.00,
        game_rates_5 = 5.00,
        game_rates_7_50 = 7.50,
        game_rates_10 = 10.00,
        game_rates_15 = 15.00,
        game_rates_20 = 20.00,
        game_rates_25 = 25.00,
        game_rates_50 = 50.00,
        game_rates_100 = 100.00,
    }
    return multipliers[value]
end

-- Reads a direct number, an RDO enum value, or an enum item token.
local function AoE4RPG_Settings_ReadMultiplier(value, default_value)
    local function validate_multiplier(multiplier)
        if type(multiplier) == "number" and multiplier > 0 then
            return multiplier
        end
        return default_value
    end
    if type(value) == "number" then
        return validate_multiplier(value)
    end
    if type(value) == "string" then
        return validate_multiplier(AoE4RPG_Settings_ParseMultiplierKey(value))
    end
    if type(value) ~= "table" then
        return default_value
    end

    -- A WinCondition enum table may expose `value` as a zero-based selection index.
    -- IMPORTANT: It is not the selected multiplier and must not be used directly.
    local direct_value = value.multiplier or value.numeric_value
    if type(direct_value) == "number" then
        return validate_multiplier(direct_value)
    end

    local enum_value = value.enum_value or value.key or value.value_key
    if type(enum_value) == "number" and type(value.enum_items) == "table" then
        for item_key, item_value in pairs(value.enum_items) do
            if item_value == enum_value then
                local parsed_item = AoE4RPG_Settings_ParseMultiplierKey(item_key)
                if parsed_item ~= nil then
                    return validate_multiplier(parsed_item)
                end
            end
        end
    elseif type(enum_value) == "string" then
        return validate_multiplier(AoE4RPG_Settings_ParseMultiplierKey(enum_value))
    end

    -- Compatibility for a wrapper that stores the selected enum token in `value`.
    if type(value.value) == "string" then
        return validate_multiplier(AoE4RPG_Settings_ParseMultiplierKey(value.value))
    end

    return default_value
end

local function AoE4RPG_Settings_ReadClassSlotCount(value, default_value)
    local function parse_token(token)
        if type(token) == "number" then
            return math.floor(token)
        end
        if type(token) ~= "string" then
            return nil
        end
        local numeric_value = tonumber(token)
        if numeric_value then
            return math.floor(numeric_value)
        end
        local suffix = string.match(token, "^aorpg_class_slots_(%d+)$")
        return suffix and tonumber(suffix) or nil
    end

    local direct_value = parse_token(value)
    if direct_value then
        return math.max(1, math.min(5, direct_value))
    end
    if type(value) ~= "table" then
        return default_value
    end

    local enum_value = value.enum_value or value.key or value.value_key
    if type(enum_value) == "string" then
        return parse_token(enum_value) or default_value
    end
    if type(enum_value) == "number" and type(value.enum_items) == "table" then
        for item_key, item_value in pairs(value.enum_items) do
            if item_value == enum_value then
                local parsed_item = parse_token(item_key)
                if parsed_item then
                    return math.max(1, math.min(5, parsed_item))
                end
            end
        end
    end
    return default_value
end

-- Reads a player or AI maximum-population enum and clamps it to an offered value.
local function AoE4RPG_Settings_ReadMaximumPopulation(value, default_value)
    local allowed_values = {
        [25] = true, [50] = true, [75] = true, [100] = true, [150] = true,
        [200] = true, [250] = true, [300] = true, [350] = true, [400] = true,
    }
    local function parse_token(token)
        local population = nil
        if type(token) == "number" then
            population = math.floor(token)
        elseif type(token) == "string" then
            population = tonumber(token)
                or tonumber(string.match(token, "^aorpg_population_(%d+)$"))
        end
        return population and allowed_values[population] and population or nil
    end

    local direct_value = parse_token(value)
    if direct_value then
        return direct_value
    end
    if type(value) ~= "table" then
        return default_value
    end

    local enum_value = value.enum_value or value.key or value.value_key
    if type(enum_value) == "string" then
        return parse_token(enum_value) or default_value
    end
    if type(enum_value) == "number" and type(value.enum_items) == "table" then
        for item_key, item_value in pairs(value.enum_items) do
            if item_value == enum_value then
                return parse_token(item_key) or default_value
            end
        end
    end
    return default_value
end

-- IMPORTANT: Reads the selected AoE4RPG.rdo options through the native setup API.
function AoE4RPG_SETTINGS_Read()
    local options = {}
    if not Setup_GetWinConditionOptions then
        return nil
    end
    Setup_GetWinConditionOptions(options)
    AoE4RPG.WINCONDITION_OPTIONS = options
    return options
end

-- IMPORTANT: Converts an engine entity handle or wrapper into the numeric EntityID used only for validity checks and stable delayed-rule storage.
local function AoE4RPG_Settings_GetEntityIdentifier(entity)
    if AoE4RPG_RUNTIME_GetEntityIdentifier then
        return AoE4RPG_RUNTIME_GetEntityIdentifier(entity)
    end
    if type(entity) == "number" then
        return entity
    end
    if entity == nil then
        return nil
    end
    if type(entity.EntityID) == "number" then
        return entity.EntityID
    end
    if type(entity.id) == "number" then
        return entity.id
    end
    if Entity_GetID and (not scartype or not ST_ENTITY or scartype(entity) == ST_ENTITY) then
        local entity_id = Entity_GetID(entity)
        if type(entity_id) == "number" then
            return entity_id
        end
    end
    return nil
end

-- Applies a configured world resource multiplier once to every matching map deposit.
local function AoE4RPG_Settings_AdjustEntityDeposit(
    entity,
    multiplier,
    contained_amount_modifier
)
    if entity == nil or type(multiplier) ~= "number"
        or multiplier <= 0 or multiplier == 1.0 then
        return
    end
    local entity_id = AoE4RPG_Settings_GetEntityIdentifier(entity)
    if entity_id == nil then
        return
    end
    if AoE4RPG.SETTINGS.map_deposit_entities[entity_id] then
        return
    end
    if Entity_IsValid and not Entity_IsValid(entity_id) then
        return
    end
    local entity_handle = Entity_FromID and Entity_FromID(entity_id) or entity
    if entity_handle == nil then
        return
    end
    local current_amount = Entity_GetRemainingResourceDepositAmount(entity_handle)
    -- IMPORTANT: OnPlay can precede native deposit initialization.
    -- IMPORTANT: Never write an uninitialized zero, because that removes trees and mine deposits.
    if type(current_amount) == "number" and current_amount > 0 then
        -- IMPORTANT: Gold and stone callbacks provide it only after EGroup_Filter has selected their native deposit types.
        -- IMPORTANT: Match UAGS by applying the cap modifier to every such deposit; live blueprint names differ between map scripts and are not a safe whitelist for this operation.
        if contained_amount_modifier
            and Modifier_ApplyToEntity and Modifier_Create then
            Modifier_ApplyToEntity(
                Modifier_Create(
                    MAT_Entity,
                    contained_amount_modifier,
                    MUT_Multiplication,
                    false,
                    multiplier,
                    nil
                ),
                entity_handle,
                0.0
            )
        end
        Entity_SetRemainingResourceDepositAmount(entity_handle, current_amount * multiplier)
        -- Deposits can be enumerated again while late-starting maps finish spawning.
        -- IMPORTANT: Record successful applications so the retry monitor never multiplies an already-adjusted deposit a second time.
        AoE4RPG.SETTINGS.map_deposit_entities[entity_id] = true
    end
end

-- IMPORTANT: Applies the scaled food amount after the living animal converts into a native carcass.
function AoE4RPG_SETTINGS_ResetAnimalFoodResource(rule_id, context)
    if type(context) ~= "table" then
        return
    end
    local entity = nil
    local squad_identifier = context.squad_id
    AoE4RPG_ECONOMIC_BLUEPRINTS_EndAnimalSquadCheck(squad_identifier)
    if type(squad_identifier) == "number"
        and (not Squad_IsValid or Squad_IsValid(squad_identifier)) then
        local squad = Squad_FromID and Squad_FromID(squad_identifier) or context.squad
        if squad ~= nil and Squad_GetFirstEntity then
            entity = Squad_GetFirstEntity(squad)
        end
    end
    entity = entity or context.entity_id or context.entity

    local live_entity =
        AoE4RPG_ECONOMIC_BLUEPRINTS_GetEntity(entity)
    if live_entity == nil or not Entity_GetHealth then
        return
    end

    local animal_data =
        AoE4RPG_ECONOMIC_BLUEPRINTS_GetAnimalDataByScarType(context.animal_type)
    local multiplier = AoE4RPG.SETTINGS.resource_multipliers.food or 1.0
    if Entity_GetHealth(live_entity) > 0 then
        -- IMPORTANT: Handles sheep or cattle created after the initial map scan.
        AoE4RPG_ECONOMIC_BLUEPRINTS_RecordAnimalSquadFood(squad_identifier, live_entity)
        if AoE4RPG_ECONOMIC_BLUEPRINTS_GetAnimalData(live_entity) ~= nil then
            AoE4RPG_ECONOMIC_BLUEPRINTS_ApplyAnimalFoodModifier(
                live_entity,
                multiplier,
                animal_data,
                squad_identifier
            )
        end
        return
    end
    local retained_food, total_food, modifier_persists =
        AoE4RPG_ECONOMIC_BLUEPRINTS_PrepareAnimalCarcass(
            squad_identifier,
            live_entity
        )
    if retained_food == nil or total_food == nil then
        return
    end
    if modifier_persists then
        Entity_SetRemainingResourceDepositAmount(live_entity, retained_food)
        local entity_identifier = live_entity.EntityID
            or (Entity_GetID and (not scartype or not ST_ENTITY or scartype(live_entity) == ST_ENTITY)
                and Entity_GetID(live_entity))
        if type(entity_identifier) == "number" then
            AoE4RPG.ECONOMIC_BLUEPRINTS.applied_animal_entities[entity_identifier] =
                "carcass"
        end
    else
        AoE4RPG_ECONOMIC_BLUEPRINTS_ApplyAnimalFoodModifier(
            live_entity,
            total_food / animal_data.base_food,
            animal_data,
            squad_identifier,
            retained_food,
            total_food,
            true
        )
    end
end

-- IMPORTANT: Runs the expensive native-carcass census only after an animal death.
-- IMPORTANT: Two delayed passes cover hosts that replace the living entity or squad one frame later; multiple deaths in the same interval share this debounced scan window.
function AoE4RPG_SETTINGS_RunScheduledAnimalDepositScan()
    local settings = AoE4RPG.SETTINGS
    settings.animal_deposit_scan_scheduled = false
    if AoE4RPG_ECONOMIC_BLUEPRINTS_ScanAnimalDeposits then
        AoE4RPG_ECONOMIC_BLUEPRINTS_ScanAnimalDeposits()
    end
    settings.animal_deposit_scan_attempts_remaining = math.max(
        0,
        (settings.animal_deposit_scan_attempts_remaining or 0) - 1
    )
    if settings.animal_deposit_scan_attempts_remaining > 0 and Rule_AddOneShot then
        settings.animal_deposit_scan_scheduled = true
        Rule_AddOneShot(AoE4RPG_SETTINGS_RunScheduledAnimalDepositScan, 0.5)
    end
end

-- Detects registered animal deaths from the existing synchronized kill event.
-- IMPORTANT: Map animals do not respawn, so no permanent neutral-squad polling is needed; produced livestock is also covered when it dies and becomes a food deposit.
function AoE4RPG_SETTINGS_OnAnimalKilled(context)
    if (AoE4RPG.SETTINGS.resource_multipliers.food or 1.0) == 1.0
        or type(context) ~= "table" then
        return false
    end
    local victim = context.victim or context.entity
    if victim == nil or not AoE4RPG_ECONOMIC_BLUEPRINTS_GetAnimalData
        or AoE4RPG_ECONOMIC_BLUEPRINTS_GetAnimalData(victim) == nil then
        return false
    end

    local settings = AoE4RPG.SETTINGS
    settings.animal_deposit_scan_attempts_remaining = 2
    if settings.animal_deposit_scan_scheduled then
        return true
    end
    settings.animal_deposit_scan_scheduled = true
    if Rule_AddOneShot then
        Rule_AddOneShot(AoE4RPG_SETTINGS_RunScheduledAnimalDepositScan, 0.25)
    else
        settings.animal_deposit_scan_attempts_remaining = 1
        AoE4RPG_SETTINGS_RunScheduledAnimalDepositScan()
    end
    return true
end

-- Multiplies all neutral entity deposits by their matching world resource setting.
-- IMPORTANT: UAGS unregisters its resource module while all values are the native 1x defaults.
local function AoE4RPG_Settings_HasNonDefaultMapResourceMultiplier()
    local resource_multipliers = AoE4RPG.SETTINGS
        and AoE4RPG.SETTINGS.resource_multipliers
        or {}
    return (resource_multipliers.food or 1.0) ~= 1.0
        or (resource_multipliers.wood or 1.0) ~= 1.0
        or (resource_multipliers.gold or 1.0) ~= 1.0
        or (resource_multipliers.stone or 1.0) ~= 1.0
end

-- Counts native neutral resources without changing their entities or deposits.
-- IMPORTANT: Temporary checkpoints identify the lifecycle phase where map resources disappear.
function AoE4RPG_SETTINGS_LogNeutralResourceCensus(phase_name)
    if AoE4RPG.debug_resource_census_enabled ~= true then
        return false
    end
    if not World_GetAllNeutralEntities or not EGroup_CreateUnique
        or not EGroup_Filter or not EGroup_CountSpawned then
        return false
    end

    local all_neutral = EGroup_CreateUnique()
    local trees = EGroup_CreateUnique()
    local stone = EGroup_CreateUnique()
    local gold = EGroup_CreateUnique()
    local fish = EGroup_CreateUnique()
    local berries = EGroup_CreateUnique()
    local relics = EGroup_CreateUnique()

    World_GetAllNeutralEntities(all_neutral)
    EGroup_Filter(all_neutral, "tree", FILTER_REMOVE, trees)
    EGroup_Filter(all_neutral, "stone", FILTER_REMOVE, stone)
    EGroup_Filter(all_neutral, "gold", FILTER_REMOVE, gold)
    EGroup_Filter(
        all_neutral,
        { "shore_fish", "deep_water_fish" },
        FILTER_REMOVE,
        fish
    )
    EGroup_Filter(all_neutral, "forage_bush", FILTER_REMOVE, berries)
    EGroup_Filter(all_neutral, "relic", FILTER_REMOVE, relics)

    local census = {
        trees = EGroup_CountSpawned(trees),
        berries = EGroup_CountSpawned(berries),
        fish = EGroup_CountSpawned(fish),
        gold = EGroup_CountSpawned(gold),
        stone = EGroup_CountSpawned(stone),
        relics = EGroup_CountSpawned(relics),
    }
    AoE4RPG.SETTINGS.neutral_resource_census =
        AoE4RPG.SETTINGS.neutral_resource_census or {}
    AoE4RPG.SETTINGS.neutral_resource_census[phase_name] = census

    if print then
        print(
            "WARNING: [AoE4RPG] Neutral resource census phase="
                .. tostring(phase_name)
                .. ", trees=" .. tostring(census.trees)
                .. ", berries=" .. tostring(census.berries)
                .. ", fish=" .. tostring(census.fish)
                .. ", gold=" .. tostring(census.gold)
                .. ", stone=" .. tostring(census.stone)
                .. ", relics=" .. tostring(census.relics)
        )
    end
    return true
end

function AoE4RPG_SETTINGS_ApplyMapResourceMultipliers()
    if not AoE4RPG_Settings_HasNonDefaultMapResourceMultiplier() then
        return
    end
    if not World_GetAllNeutralEntities or not EGroup_CreateUnique or not EGroup_Filter then
        return
    end

    local all_neutral = EGroup_CreateUnique()
    local fish_entities = EGroup_CreateUnique()
    local berry_entities = EGroup_CreateUnique()
    local wood_entities = EGroup_CreateUnique()
    local gold_entities = EGroup_CreateUnique()
    local stone_entities = EGroup_CreateUnique()
    local relic_entities = EGroup_CreateUnique()
    World_GetAllNeutralEntities(all_neutral)
    if AoE4RPG_MAPGEN_TRACKER_ScanNeutralEntities then
        AoE4RPG_MAPGEN_TRACKER_ScanNeutralEntities(all_neutral)
    end

    EGroup_Filter(all_neutral, "tree", FILTER_REMOVE, wood_entities)
    EGroup_Filter(all_neutral, "stone", FILTER_REMOVE, stone_entities)
    EGroup_Filter(all_neutral, "gold", FILTER_REMOVE, gold_entities)
    EGroup_Filter(
        all_neutral,
        { "shore_fish", "deep_water_fish" },
        FILTER_REMOVE,
        fish_entities
    )
    EGroup_Filter(all_neutral, "forage_bush", FILTER_REMOVE, berry_entities)
    EGroup_Filter(all_neutral, "relic", FILTER_REMOVE, relic_entities)

    -- Record what MapGen actually supplied before this module changes any deposit.
    -- This distinguishes absent map-generation entities from deposits removed by a later economy operation.
    -- IMPORTANT: Relics are census-only and are never modified by AoE4RPG settings.
    if not AoE4RPG.SETTINGS.map_resource_census_logged
        and EGroup_CountSpawned and print then
        print(
            "[AoE4RPG] Pre-modifier map census: trees="
                .. tostring(EGroup_CountSpawned(wood_entities))
                .. ", berries=" .. tostring(EGroup_CountSpawned(berry_entities))
                .. ", fish=" .. tostring(EGroup_CountSpawned(fish_entities))
                .. ", gold=" .. tostring(EGroup_CountSpawned(gold_entities))
                .. ", stone=" .. tostring(EGroup_CountSpawned(stone_entities))
                .. ", relics=" .. tostring(EGroup_CountSpawned(relic_entities))
        )
        AoE4RPG.SETTINGS.map_resource_census_logged = true
    end

    local function adjust_food(group_id, index, entity)
        AoE4RPG_Settings_AdjustEntityDeposit(
            entity,
            AoE4RPG.SETTINGS.resource_multipliers.food
        )
    end
    local function adjust_wood(group_id, index, entity)
        -- IMPORTANT: Trees such as elm_small_wild do not have modifier_ext.
        -- Scale only the initialized current amount for this family.
        AoE4RPG_Settings_AdjustEntityDeposit(
            entity,
            AoE4RPG.SETTINGS.resource_multipliers.wood
        )
    end
    local function adjust_gold(group_id, index, entity)
        AoE4RPG_Settings_AdjustEntityDeposit(
            entity,
            AoE4RPG.SETTINGS.resource_multipliers.gold,
            "resource_contained_amount_gold"
        )
    end
    local function adjust_stone(group_id, index, entity)
        AoE4RPG_Settings_AdjustEntityDeposit(
            entity,
            AoE4RPG.SETTINGS.resource_multipliers.stone,
            "resource_contained_amount_stone"
        )
    end

    if EGroup_ForEach then
        EGroup_ForEach(fish_entities, adjust_food)
        EGroup_ForEach(berry_entities, adjust_food)
        EGroup_ForEach(wood_entities, adjust_wood)
        EGroup_ForEach(gold_entities, adjust_gold)
        EGroup_ForEach(stone_entities, adjust_stone)
    end

    -- Living animals display their contained food even though they cannot be harvested.
    -- IMPORTANT: Apply their first modifier now; the native-deposit monitor later synchronizes the resulting carcass without using damage events.
    if World_GetAllNeutralSquads and SGroup_CreateUnique and SGroup_Filter and SGroup_ForEach then
        local all_neutral_squads = SGroup_CreateUnique()
        local food_animals = SGroup_CreateUnique()
        World_GetAllNeutralSquads(all_neutral_squads)
        SGroup_Filter(
            all_neutral_squads,
            AoE4RPG_ECONOMIC_BLUEPRINTS_GetAnimalSquadTypes(true),
            FILTER_REMOVE,
            food_animals
        )
        if not AoE4RPG.SETTINGS.map_animal_census_logged
            and SGroup_CountSpawned and print then
            print(
                "[AoE4RPG] Pre-modifier neutral animal census: animals="
                    .. tostring(SGroup_CountSpawned(food_animals))
            )
            AoE4RPG.SETTINGS.map_animal_census_logged = true
        end
        local function adjust_living_animal(group_id, index, squad)
            local entity = Squad_GetFirstEntity(squad)
            local squad_identifier = Squad_GetID and Squad_GetID(squad) or nil
            AoE4RPG_ECONOMIC_BLUEPRINTS_ApplyAnimalFoodModifier(
                entity,
                AoE4RPG.SETTINGS.resource_multipliers.food,
                nil,
                squad_identifier
            )
        end
        SGroup_ForEach(food_animals, adjust_living_animal)
    end

    -- IMPORTANT: Player-owned sheep and cattle are not guaranteed to appear in the neutral scan.
    if type(PLAYERS) == "table" and SGroup_ForEach and Player_GetSquadsFromType then
        for _, player in pairs(PLAYERS) do
            for _, animal_type in ipairs(
                AoE4RPG_ECONOMIC_BLUEPRINTS_GetAnimalSquadTypes(false)
            ) do
                local player_handle = AoE4RPG_Settings_ResolvePlayer(player)
                local owned_animals = player_handle
                    and Player_GetSquadsFromType(player_handle, animal_type)
                    or nil
                if owned_animals then
                    local function adjust_owned_living_animal(group_id, index, squad)
                        local entity = Squad_GetFirstEntity(squad)
                        local squad_identifier = Squad_GetID and Squad_GetID(squad) or nil
                        AoE4RPG_ECONOMIC_BLUEPRINTS_ApplyAnimalFoodModifier(
                            entity,
                            AoE4RPG.SETTINGS.resource_multipliers.food,
                            nil,
                            squad_identifier
                        )
                    end
                    SGroup_ForEach(owned_animals, adjust_owned_living_animal)
                end
            end
        end
    end
end

-- IMPORTANT: Do not modify deposits during the pre-map lifecycle.
-- The delayed play-start pass handles fully initialized neutral entities.
function AoE4RPG_SETTINGS_PresetExecute()
    AoE4RPG_SETTINGS_LogNeutralResourceCensus("PresetExecute before modifiers")
    AoE4RPG.SETTINGS.map_resource_preset_applied = true
end

-- IMPORTANT: Performs a supplemental scan after play begins.
function AoE4RPG_SETTINGS_RunScheduledMapResourceMultipliers()
    AoE4RPG_SETTINGS_ApplyMapResourceMultipliers()
    AoE4RPG.SETTINGS.map_resource_modifier_scheduled = false
end

-- IMPORTANT: Defers resource writes until the neutral map entities have completed native initialization.
-- A one-second delay also keeps this independent from hero UI and critical-hit startup work.
function AoE4RPG_SETTINGS_ScheduleMapResourceMultipliers()
    if not AoE4RPG_Settings_HasNonDefaultMapResourceMultiplier() then
        return
    end
    if AoE4RPG.SETTINGS.map_resource_modifier_scheduled then
        return
    end
    AoE4RPG.SETTINGS.map_resource_modifier_scheduled = true
    if Rule_AddOneShot then
        Rule_AddOneShot(AoE4RPG_SETTINGS_RunScheduledMapResourceMultipliers, 1.0)
    else
        AoE4RPG_SETTINGS_RunScheduledMapResourceMultipliers()
    end
end

-- IMPORTANT: Applies a player-scoped entity-type modifier using the UAGS modifier pattern.
local function AoE4RPG_Settings_ApplyEntityTypeModifier(
    player_handle,
    entity_blueprint,
    modifier_name,
    multiplier
)
    if multiplier == nil or multiplier == 1.0 or entity_blueprint == nil then
        return
    end
    Modifier_ApplyToPlayer(
        Modifier_Create(
            MAT_EntityType,
            modifier_name,
            MUT_Multiplication,
            false,
            multiplier,
            entity_blueprint
        ),
        player_handle,
        0.0
    )
end

-- Filters a construction blueprint to the active civilization when the suffix is known.
local function AoE4RPG_Settings_IsCivilizationWorker(player, blueprint_name)
    if not AoE4RPG_RUNTIME_GetPlayerRaceName or type(blueprint_name) ~= "string" then
        return true
    end
    local player_handle = AoE4RPG_Settings_ResolvePlayer(player)
    if not player_handle then
        return true
    end
    local race_name = AoE4RPG_RUNTIME_GetPlayerRaceName(player, "")
    local suffixes = {
        abbasid = "abb",
        abbasid_ha_01 = "abb_ha_01",
        byzantine = "byz",
        byzantine_ha_mac = "byz_ha_mac",
        chinese = "chi",
        chinese_ha_01 = "chi_ha_01",
        english = "eng",
        french = "fre",
        french_ha_01 = "fre_ha_01",
        hre = "hre",
        hre_ha_01 = "hre_ha_01",
        japanese = "jpn",
        japanese_ha_sen = "jpn_ha_sen",
        jin_dynasty = "jin",
        lancaster = "lan",
        malian = "mal",
        mongol = "mon",
        mongol_ha_gol = "mon_ha_gol",
        ottoman = "ott",
        rus = "rus",
        sultanate = "sul",
        sultanate_ha_tug = "sul_ha_tug",
        templar = "tem",
    }
    local suffix = suffixes[race_name]
    if suffix == nil then
        return true
    end
    return string.find(blueprint_name, "_" .. suffix, 1, true) ~= nil
end

-- Applies global gather income, blueprint build/repair, and player training speed separately to Player and AI.
function AoE4RPG_SETTINGS_ApplyPlayerEconomicSpeed()
    local worker_blueprints = {}
    local gatherer_blueprints = {}
    if BP_GetEntityBlueprintsWithType then
        worker_blueprints = BP_GetEntityBlueprintsWithType("worker") or {}
    end
    if AoE4RPG_ECONOMIC_BLUEPRINTS_GetGathererBlueprints then
        gatherer_blueprints = AoE4RPG_ECONOMIC_BLUEPRINTS_GetGathererBlueprints()
    end

    local function apply_to_player(player)
        local player_handle = AoE4RPG_Settings_ResolvePlayer(player)
        local is_ai = false
        if player_handle and AI_IsAIPlayer then
            local success, result = pcall(AI_IsAIPlayer, player_handle)
            is_ai = success and result == true
        end
        local profile = is_ai and AoE4RPG.SETTINGS.speed.ai or AoE4RPG.SETTINGS.speed.player
        if not profile then
            return
        end

        -- IMPORTANT: UAGS uses the native player production API for training speed.
        if profile.train ~= 1.0 and Modify_PlayerProductionRate then
            Modify_PlayerProductionRate(player_handle, profile.train)
        end

        -- UAGS applies gathering to every matching unit-class EBP.
        -- The player resource-rate API does not modify worker harvest behavior reliably.
        if profile.gather ~= 1.0 then
            for _, entity_blueprint in pairs(gatherer_blueprints) do
                local blueprint_name = BP_GetName(entity_blueprint)
                if AoE4RPG_Settings_IsCivilizationWorker(
                    player_handle,
                    blueprint_name
                ) then
                    for _, modifier_name in ipairs({
                        "resource_entity_harvest_rate_food",
                        "resource_entity_harvest_rate_wood",
                        "resource_entity_harvest_rate_gold",
                        "resource_entity_harvest_rate_stone",
                        "resource_carry_capacity_food",
                        "resource_carry_capacity_wood",
                        "resource_carry_capacity_gold",
                        "resource_carry_capacity_stone",
                    }) do
                        AoE4RPG_Settings_ApplyEntityTypeModifier(
                            player_handle,
                            entity_blueprint,
                            modifier_name,
                            profile.gather
                        )
                    end
                end
            end
        end

        if profile.build ~= 1.0 then
            for _, entity_blueprint in pairs(worker_blueprints) do
                local blueprint_name = BP_GetName(entity_blueprint)
                local is_villager = type(blueprint_name) == "string"
                    and (
                        string.find(blueprint_name, "villager", 1, true) ~= nil
                        or string.find(blueprint_name, "village", 1, true) ~= nil
                    )
                if is_villager
                    and AoE4RPG_Settings_IsCivilizationWorker(player_handle, blueprint_name) then
                    AoE4RPG_Settings_ApplyEntityTypeModifier(
                        player_handle,
                        entity_blueprint,
                        "construction_rate",
                        profile.build
                    )
                    AoE4RPG_Settings_ApplyEntityTypeModifier(
                        player_handle,
                        entity_blueprint,
                        "repair_rate_modifier",
                        profile.build
                    )
                end
            end
        end
    end

    if type(PLAYERS) == "table" then
        for _, player in pairs(PLAYERS) do
            apply_to_player(player)
        end
    elseif World_GetPlayerCount and World_GetPlayerAt then
        for index = 1, World_GetPlayerCount() do
            local player = World_GetPlayerAt(index)
            if player ~= nil then
                apply_to_player(player)
            end
        end
    end
end

-- Applies the UAGS wall-health multiplier to every civilization wall blueprint.
-- IMPORTANT: This changes blueprint health for future and existing player-owned walls without scanning map entities.
function AoE4RPG_SETTINGS_ApplyWallHealthMultiplier()
    local multiplier = AoE4RPG.SETTINGS.wall_health_multiplier or 1.0
    if multiplier == 1.0
        or not BP_GetEntityBlueprintsWithType
        or not BP_GetName
        or not Modifier_ApplyToPlayer
        or not Modifier_Create then
        return
    end

    local wall_blueprints = BP_GetEntityBlueprintsWithType("building") or {}
    local matching_wall_blueprints = {}
    for _, entity_blueprint in pairs(wall_blueprints) do
        local blueprint_name = BP_GetName(entity_blueprint)
        if type(blueprint_name) == "string" then
            local normalized_name = string.lower(blueprint_name)
            if string.find(normalized_name, "wall", 1, true)
                or string.find(normalized_name, "defense_palisade", 1, true) then
                table.insert(matching_wall_blueprints, entity_blueprint)
            end
        end
    end

    local function apply_to_player(player)
        local player_handle = AoE4RPG_Settings_ResolvePlayer(player)
        if not player_handle then
            return
        end
        for _, entity_blueprint in ipairs(matching_wall_blueprints) do
            AoE4RPG_Settings_ApplyEntityTypeModifier(
                player_handle,
                entity_blueprint,
                "health_maximum_modifier",
                multiplier
            )
        end
    end

    if type(PLAYERS) == "table" then
        for _, player in pairs(PLAYERS) do
            apply_to_player(player)
        end
    elseif World_GetPlayerCount and World_GetPlayerAt then
        for index = 1, World_GetPlayerCount() do
            apply_to_player(World_GetPlayerAt(index))
        end
    end
end

-- IMPORTANT: Applies separate human and AI maximum population caps using the UAGS difference-modifier pattern, preserving each tuning pack's starting cap.
function AoE4RPG_SETTINGS_ApplyMaximumPopulation()
    if not Player_GetMaxPopulationCap or not Modifier_Create
        or not Modifier_ApplyToPlayer or CT_Personnel == nil then
        return
    end

    local function apply_to_player(player)
        local player_handle = AoE4RPG_Settings_ResolvePlayer(player)
        local is_ai = false
        if player_handle and AI_IsAIPlayer then
            local success, result = pcall(AI_IsAIPlayer, player_handle)
            is_ai = success and result == true
        end
        local selected_cap = is_ai
            and AoE4RPG.SETTINGS.maximum_population.ai
            or AoE4RPG.SETTINGS.maximum_population.player
        if not player_handle then
            return
        end
        local current_cap = Player_GetMaxPopulationCap(player_handle, CT_Personnel)
        if type(selected_cap) ~= "number" or type(current_cap) ~= "number" then
            return
        end
        local population_difference = selected_cap - current_cap
        if population_difference == 0 then
            return
        end
        Modifier_ApplyToPlayer(
            Modifier_Create(
                MAT_Player,
                "max_personnel_cap_player_modifier",
                MUT_Addition,
                false,
                population_difference,
                ""
            ),
            player_handle,
            0.0
        )
    end

    if type(PLAYERS) == "table" then
        for _, player in pairs(PLAYERS) do
            apply_to_player(player)
        end
    elseif World_GetPlayerCount and World_GetPlayerAt then
        for index = 1, World_GetPlayerCount() do
            local player = World_GetPlayerAt(index)
            if player ~= nil then
                apply_to_player(player)
            end
        end
    end
end

-- Applies the four shared resource multipliers and per-player economic speeds once.
function AoE4RPG_SETTINGS_ApplyEconomyModifiers()
    if AoE4RPG.SETTINGS.economy_applied then
        return
    end
    AoE4RPG.SETTINGS.economy_applied = true

    AoE4RPG_ECONOMIC_BLUEPRINTS_ApplyOvooStoneModifiers(
        AoE4RPG.SETTINGS.resource_multipliers.stone or 1.0
    )
    AoE4RPG_SETTINGS_ApplyWallHealthMultiplier()
    AoE4RPG_SETTINGS_ApplyPlayerEconomicSpeed()
    AoE4RPG_SETTINGS_ApplyMaximumPopulation()

    if (AoE4RPG.SETTINGS.resource_multipliers.food or 1.0) ~= 1.0 then
        -- Initial map animals are finite and are modified by the startup census.
        -- Later carcass replacement is handled by OnAnimalKilled instead of a permanent all-neutral-squad interval rule.
        AoE4RPG_ECONOMIC_BLUEPRINTS_ScanAnimalDeposits()
        AoE4RPG.SETTINGS.animal_deposit_monitor_registered = false
    end
end

-- Applies the standalone unlimited-level setting before RPG systems initialize.
function AoE4RPG_SETTINGS_Apply()
    local class_slot_count = tonumber(AoE4RPG.SETTINGS.max_class_slots) or 5
    AoE4RPG.MaxClassSlots = math.max(1, math.min(5, math.floor(class_slot_count)))
    if AoE4RPG.UNCAPPED_HERO_ELITE_LEVELS then
        AoE4RPG.MaxLevel = 99999
        AoE4RPG.EliteMaxLevel = 99999
    end
end

-- Reads all match settings once and keeps compatibility defaults at 1.0.
function AoE4RPG_SETTINGS_Initialize()
    if AoE4RPG.SETTINGS.initialized then
        return AoE4RPG.UNCAPPED_HERO_ELITE_LEVELS == true
    end

    local options = AoE4RPG_SETTINGS_Read() or {}
    AoE4RPG.UNCAPPED_HERO_ELITE_LEVELS =
        AoE4RPG_Settings_FindOption(options, AoE4RPG.SETTINGS.option_key) == true
    AoE4RPG.SETTINGS.max_class_slots =
        AoE4RPG_Settings_ReadClassSlotCount(
            AoE4RPG_Settings_FindOption(options, AoE4RPG.SETTINGS.class_slot_option_key),
            5
        )
    local legacy_xp_multiplier = AoE4RPG_Settings_ReadMultiplier(
        AoE4RPG_Settings_FindOption(options, AoE4RPG.SETTINGS.xp_option_key),
        1.0
    )
    AoE4RPG.SETTINGS.xp_multipliers = {
        human = AoE4RPG_Settings_ReadMultiplier(
            AoE4RPG_Settings_FindOption(
                options,
                AoE4RPG.SETTINGS.xp_option_keys.human
            ),
            legacy_xp_multiplier
        ),
        ai = AoE4RPG_Settings_ReadMultiplier(
            AoE4RPG_Settings_FindOption(
                options,
                AoE4RPG.SETTINGS.xp_option_keys.ai
            ),
            legacy_xp_multiplier
        ),
    }
    -- Compatibility field for modules that still read the former single multiplier.
    -- New XP awards use xp_multipliers through the owner-aware resolver in AoE4RPG_core.scar.
    AoE4RPG.SETTINGS.xp_multiplier = AoE4RPG.SETTINGS.xp_multipliers.human
    AoE4RPG.SETTINGS.ai_keep_experience_on_death =
        AoE4RPG_Settings_ReadBoolean(
            AoE4RPG_Settings_FindOption(
                options,
                AoE4RPG.SETTINGS.ai_keep_experience_on_death_option_key
            ),
            false
        )
    local victory_defaults = {
        annihilation = true,
        conquest = true,
        regicide = false,
    }
    AoE4RPG.SETTINGS.victory_conditions = {}
    local found_boolean_victory_option = false
    for mode_name, option_key in pairs(AoE4RPG.SETTINGS.victory_option_keys) do
        local option_value = AoE4RPG_Settings_FindOption(options, option_key)
        if option_value ~= nil then
            found_boolean_victory_option = true
        end
        AoE4RPG.SETTINGS.victory_conditions[mode_name] =
            AoE4RPG_Settings_ReadBoolean(
                option_value,
                victory_defaults[mode_name]
            )
    end

    -- Compatibility for a lobby that still has the former single-selection RDO cached.
    -- A current RDO always supplies the three Boolean options.
    if not found_boolean_victory_option then
        local legacy_mode = AoE4RPG_Settings_ReadVictoryMode(
            AoE4RPG_Settings_FindOption(
                options,
                AoE4RPG.SETTINGS.legacy_victory_mode_option_key
            )
        )
        AoE4RPG.SETTINGS.victory_conditions = {
            annihilation = legacy_mode == "annihilation",
            conquest = legacy_mode == "conquest",
            regicide = legacy_mode == "regicide",
        }
    end

    -- IMPORTANT: Preserve the old scalar for compatibility with extensions while making the Boolean table authoritative for native condition registration.
    AoE4RPG.SETTINGS.victory_mode =
        AoE4RPG.SETTINGS.victory_conditions.regicide and "regicide"
        or (AoE4RPG.SETTINGS.victory_conditions.annihilation and "annihilation")
        or "conquest"
    AoE4RPG.SETTINGS.king_level_minutes =
        AoE4RPG_Settings_ReadKingLevelMinutes(
            AoE4RPG_Settings_FindOption(
                options,
                AoE4RPG.SETTINGS.king_level_minutes_option_key
            ),
            AoE4RPG.KING_LEVEL_MINUTES or 5
        )
    AoE4RPG.SETTINGS.wall_health_multiplier =
        AoE4RPG_Settings_ReadMultiplier(
            AoE4RPG_Settings_FindOption(
                options,
                AoE4RPG.SETTINGS.wall_health_option_key
            ),
            1.0
        )
    AoE4RPG.SETTINGS.maximum_population = {}
    for owner_name, option_key in pairs(AoE4RPG.SETTINGS.population_option_keys) do
        AoE4RPG.SETTINGS.maximum_population[owner_name] =
            AoE4RPG_Settings_ReadMaximumPopulation(
                AoE4RPG_Settings_FindOption(options, option_key),
                200
            )
    end

    AoE4RPG.SETTINGS.resource_multipliers = {}
    for resource_name, option_key in pairs(AoE4RPG.SETTINGS.resource_option_keys) do
        AoE4RPG.SETTINGS.resource_multipliers[resource_name] =
            AoE4RPG_Settings_ReadMultiplier(
                AoE4RPG_Settings_FindOption(options, option_key),
                1.0
            )
    end

    AoE4RPG.SETTINGS.speed = { player = {}, ai = {} }
    for owner_name, owner_options in pairs(AoE4RPG.SETTINGS.speed_option_keys) do
        for speed_name, option_key in pairs(owner_options) do
            AoE4RPG.SETTINGS.speed[owner_name][speed_name] =
                AoE4RPG_Settings_ReadMultiplier(
                    AoE4RPG_Settings_FindOption(options, option_key),
                    1.0
                )
        end
    end

    AoE4RPG.SETTINGS.initialized = true
    AoE4RPG_SETTINGS_Apply()
    return AoE4RPG.UNCAPPED_HERO_ELITE_LEVELS
end

-- Compatibility bridge for hosts that still dispatch the Cardinal-style setup.
function AoE4RPG_SETTINGS_Setup(options)
    if type(options) == "table" then
        AoE4RPG.WINCONDITION_OPTIONS = options
        local selected = AoE4RPG_Settings_FindOption(options, AoE4RPG.SETTINGS.option_key)
        if selected ~= nil then
            AoE4RPG.UNCAPPED_HERO_ELITE_LEVELS = selected == true
        end
    end
    AoE4RPG.SETTINGS.initialized = false
    AoE4RPG_SETTINGS_Initialize()
end

-- IMPORTANT: Removes this module's native animal-deposit monitor when the match ends.
function AoE4RPG_SETTINGS_Shutdown()
    if AoE4RPG.SETTINGS.animal_deposit_monitor_registered and Rule_Remove then
        Rule_Remove(AoE4RPG_ECONOMIC_BLUEPRINTS_ScanAnimalDeposits)
    end
    if AoE4RPG.SETTINGS.animal_deposit_scan_scheduled and Rule_Remove then
        Rule_Remove(AoE4RPG_SETTINGS_RunScheduledAnimalDepositScan)
    end
    AoE4RPG.SETTINGS.animal_deposit_monitor_registered = false
    AoE4RPG.SETTINGS.animal_deposit_scan_scheduled = false
    AoE4RPG.SETTINGS.animal_deposit_scan_attempts_remaining = 0
    AoE4RPG.SETTINGS.map_deposit_monitor_registered = false
    AoE4RPG.SETTINGS.map_deposit_entities = {}
    AoE4RPG.SETTINGS.map_resource_preset_applied = false
    AoE4RPG.SETTINGS.map_resource_modifier_scheduled = false
    AoE4RPG.SETTINGS.economy_applied = false
    if AoE4RPG_ECONOMIC_BLUEPRINTS_StopOvooMonitor then
        AoE4RPG_ECONOMIC_BLUEPRINTS_StopOvooMonitor()
    end
    if AoE4RPG_MAPGEN_TRACKER_Shutdown then
        AoE4RPG_MAPGEN_TRACKER_Shutdown()
    end
    if AoE4RPG_ECONOMIC_BLUEPRINTS_ResetRuntimeState then
        AoE4RPG_ECONOMIC_BLUEPRINTS_ResetRuntimeState()
    end
end
