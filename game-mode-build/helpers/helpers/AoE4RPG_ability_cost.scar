-- ================= AoE4RPG Ability Cost ===============
-- AoE4RPG Ability Cost Health Cost Module applies registered RPG health costs to ability casters.
-- Author: Hikitomi
-- Referenced: AoE4RPG_ability_list.scar and native Debug state APIs.
-- ================= AoE4RPG Ability Cost ===============

if not AoE4RPG then
    AoE4RPG = {}
end

AoE4RPG.ABILITY_COST = AoE4RPG.ABILITY_COST or {
    initialized = false,
    health_resource_monitor_registered = false,
    entries_by_blueprint = {},
}

-- Use an existing unused engine state-model float.
-- New state-model keys cannot be registered from SCAR, while Debug is already available to requirements.
AoE4RPG_ABILITY_COST_HEALTH_RESOURCE_KEY = "Debug"

-- Additional cost per repeated random-bonus skill level.
AoE4RPG_ABILITY_COST_LEVEL_INCREASE = 0.20

function AoE4RPG_ABILITY_COST_GetConfiguredEntries()
    local entries = {}
    if AoE4RPG.ABILITY_LIST then
        for _, entry in ipairs(AoE4RPG.ABILITY_LIST) do
            if entry.hp_cost ~= nil then
                table.insert(entries, entry)
            end
        end
    end
    return entries
end

function AoE4RPG_ABILITY_COST_CalculateEntryTotalCost(entry, owner)
    if not entry then
        return 0
    end
    local base_cost = math.max(0, tonumber(entry.hp_cost) or 0)
    local effect_level = 1
    if AoE4RPG_ABILITY_LIST_GetEffectLevel then
        effect_level = AoE4RPG_ABILITY_LIST_GetEffectLevel(entry, owner)
    end
    local increase_per_level = tonumber(entry.cost_increase_per_level)
        or AoE4RPG_ABILITY_COST_LEVEL_INCREASE
    local unique_multiplier = entry.skill_type == "unique" and 1.20 or 1.0
    return base_cost * unique_multiplier
        * (1 + math.max(0, effect_level - 1) * increase_per_level)
end

function AoE4RPG_ABILITY_COST_Initialize()
    local ability_cost = AoE4RPG.ABILITY_COST
    if ability_cost.initialized then
        return true
    end
    ability_cost.entries_by_blueprint = {}

    for _, entry in ipairs(AoE4RPG_ABILITY_COST_GetConfiguredEntries()) do
        local blueprint = nil
        if entry.ability_name and AoE4RPG_GetTuningAbilityBlueprint then
            blueprint = AoE4RPG_GetTuningAbilityBlueprint(entry.ability_name)
        elseif entry.ability_pbgid and BP_GetAbilityBlueprintByPbgID then
            blueprint = BP_GetAbilityBlueprintByPbgID(entry.ability_pbgid)
        end
        if blueprint then
            ability_cost.entries_by_blueprint[blueprint] = entry
        end
    end

    ability_cost.initialized = true
    return true
end

-- Mirrors current health into an entity state-model float.
-- Ability XML can read this key through an entity_datasource statemodelfloat requirement.
-- Remember to also change Locstring warning (not enough health) in the ability XML.
-- Also remember to add health cost description to the ability XML tooltip.
function AoE4RPG_ABILITY_COST_SyncHealthResource(entity)
    if not entity or not Entity_GetHealth or not Entity_SetStateModelFloat then
        return false
    end
    local entity_identifier = type(entity) == "number" and entity
        or type(entity) == "table" and entity.EntityID
        or nil
    if not entity_identifier then
        return false
    end
    if Entity_IsValid and not Entity_IsValid(entity_identifier) then
        return false
    end
    local live_entity = Entity_FromID and Entity_FromID(entity_identifier) or entity
    if not live_entity then
        return false
    end
    Entity_SetStateModelFloat(
        live_entity,
        AoE4RPG_ABILITY_COST_HEALTH_RESOURCE_KEY,
        math.max(0, Entity_GetHealth(live_entity) or 0)
    )
    return true
end

function AoE4RPG_ABILITY_COST_SyncTrackedHealthResources()
    if not AoE4RPG_ENTITY_TRACKER_ForEachTrackedEntity then
        return false
    end
    AoE4RPG_ENTITY_TRACKER_ForEachTrackedEntity(function(entity)
        AoE4RPG_ABILITY_COST_SyncHealthResource(entity)
    end)
    return true
end

function AoE4RPG_ABILITY_COST_StartHealthResourceMonitor()
    local ability_cost = AoE4RPG.ABILITY_COST
    if ability_cost.health_resource_monitor_registered or not Rule_AddInterval then
        return false
    end
    -- The state-model value is presentation data.
    -- Four updates per second are responsive while avoiding eight full tracked-roster walks per second.
    Rule_AddInterval(AoE4RPG_ABILITY_COST_SyncTrackedHealthResources, 0.25)
    ability_cost.health_resource_monitor_registered = true
    return true
end

function AoE4RPG_ABILITY_COST_StopHealthResourceMonitor()
    local ability_cost = AoE4RPG.ABILITY_COST
    if not ability_cost.health_resource_monitor_registered or not Rule_Remove then
        return false
    end
    Rule_Remove(AoE4RPG_ABILITY_COST_SyncTrackedHealthResources)
    ability_cost.health_resource_monitor_registered = false
    return true
end

function AoE4RPG_ABILITY_COST_GetEntry(ability)
    return AoE4RPG.ABILITY_COST.entries_by_blueprint[ability]
end

function AoE4RPG_ABILITY_COST_GetTotalCost(ability, owner)
    local entry = AoE4RPG_ABILITY_COST_GetEntry(ability)
    if not entry then
        return nil
    end
    return AoE4RPG_ABILITY_COST_CalculateEntryTotalCost(entry, owner)
end
