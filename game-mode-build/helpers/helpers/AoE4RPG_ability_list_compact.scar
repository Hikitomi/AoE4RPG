-- ==================== Ability Lookup ==============
-- Resolve an ability by its exact XML blueprint name, object reference, or engine name.
-- Exact XML names are the preferred stable identifier.
-- ==================== Ability Lookup ==============
function AoE4RPG_ABILITY_LIST_Get(ability)
    local ability_name = ability
    -- The ability UI passes the configured XML name as a string after a skill choice.
    if ability and type(ability) ~= "string" and BP_GetName then
        ability_name = BP_GetName(ability) or ability
    end
    for _, entry in ipairs(AoE4RPG.ABILITY_LIST or {}) do
        if entry.ability == ability or entry.ability_name == ability
            or entry.ability_name == ability_name then
            return entry
        end
    end
    return nil
end

-- Returns the selected random-bonus skill level for one ability-list entry.
function AoE4RPG_ABILITY_LIST_GetEffectLevel(entry, owner)
    if not entry then return 1 end
    local effect_level = math.max(1, tonumber(entry.effect_level) or 1)
    local unit_data = owner and owner.EntityID and AoE4RPG_GetUnitData
        and AoE4RPG_GetUnitData(owner.EntityID)
        or nil
    -- Unique skills are not random bonuses.
    -- Their level is the current hero bracket so tier progression controls effect, cost, and cooldown scaling.
    if entry.skill_type == "unique" then
        if unit_data and AoE4RPG_GetLevelBracketStep then
            return math.max(1, AoE4RPG_GetLevelBracketStep(unit_data.level or 0, owner, unit_data))
        end
        return effect_level
    end
    local skill_key = entry.ability_name or entry.ability or entry.ability_pbgid
    local skill_levels = unit_data and unit_data.skill_effect_levels or nil
    local selected_level = skill_levels and skill_levels[skill_key]
    if selected_level == nil and entry.ability_name and skill_levels then
        selected_level = skill_levels[tostring(entry.ability_name)]
    end
    return math.max(effect_level, tonumber(selected_level) or 0)
end

function AoE4RPG_ABILITY_LIST_GetEffectData(ability, owner)
    local entry = AoE4RPG_ABILITY_LIST_Get(ability)
    if not entry then return nil end
    local data = {}
    for key, value in pairs(entry) do data[key] = value end

    -- Normalize compact values before runtime dispatchers and the ability UI read this copy.
    -- Keeps owner, projectile, area, and UI paths aligned.
    if AoE4RPG_EFFECTS_ExpandCompactValues then
        data = AoE4RPG_EFFECTS_ExpandCompactValues(data)
    end

    -- IMPORTANT: Repeated random-bonus skill choices increase the effect level for the current EntityID.
    -- Level one is the configured base effect.
    data.effect_level = AoE4RPG_ABILITY_LIST_GetEffectLevel(entry, owner)
    return data
end
