-- =========================== Respawn Scan =====================================
-- IMPORTANT: Native respawn rules for unique heroes that do not complete through a normal production queue.
-- Both heroes wait for full timer progress before entity scanning.
-- IMPORTANT: Jeanne's four Town Center buyback abilities can independently enable that scan through GE_AbilityExecuted before her timer completes.
-- =========================== Respawn Scan =====================================

AoE4RPG_SPECIAL_RESPAWN_RULES = {
    french_ha_01 = {
        class_name = "ranger",
        scan_mode = "progress_then_scan",
        progress_state_model = "jeanne_d_arc_respawn_progress",
        progress_threshold = 0.95,
        executed_ability_blueprints = {
            "jeanne_d_arc_buyback_1_fre_ha_01",
            "jeanne_d_arc_buyback_2_fre_ha_01",
            "jeanne_d_arc_buyback_3_fre_ha_01",
            "jeanne_d_arc_buyback_4_fre_ha_01",
        },
    },
    mongol = {
        class_name = "commander",
        scan_mode = "progress_then_scan",
        progress_state_model = "khan_respawn_progress_mon",
        -- The state model is normalized from 0.0 to 1.0.
        -- IMPORTANT: Begin scanning during the final five percent so the new Khan can be tracked immediately when the respawn timer completes, without scanning the whole timer.
        progress_threshold = 0.95,
    },
}

-- Converts engine blueprint names and full attrib paths to one stable key.
function AoE4RPG_NormalizeBlueprintName(value)
    if type(value) ~= "string" or value == "" then
        return nil
    end

    local normalized = string.lower(string.gsub(value, "/", "\\"))
    normalized = string.match(normalized, "([^\\]+)$") or normalized
    return string.gsub(normalized, "%.xml$", "")
end

-- Reports whether one registry row contains at least one usable blueprint.
-- Empty strings deliberately return false so their class check starts at zero.
function AoE4RPG_BlueprintRegistryValueExists(value, visited_tables)
    if type(value) == "string" then
        return AoE4RPG_NormalizeBlueprintName(value) ~= nil
    end
    if type(value) ~= "table" then
        return false
    end

    visited_tables = visited_tables or {}
    if visited_tables[value] then
        return false
    end
    visited_tables[value] = true

    if AoE4RPG_BlueprintRegistryValueExists(value.blueprint, visited_tables) then
        visited_tables[value] = nil
        return true
    end
    for key, child in pairs(value) do
        if key ~= "blueprint"
            and AoE4RPG_BlueprintRegistryValueExists(child, visited_tables) then
            visited_tables[value] = nil
            return true
        end
    end
    visited_tables[value] = nil
    return false
end


-- =========================== Scan Slots ====================================
-- Creates the requested per-class state machine for one civilization.
-- =========================== Scan Slots ====================================

function AoE4RPG_CreateHeroClassRemainingChecks(civilization)
    local remaining_checks = {}
    local civilization_table = AoE4RPG_ENTITY_TABLE[civilization]
        or AoE4RPG_ENTITY_TABLE.default
        or {}

    for unit_type, class_name in pairs(AoE4RPG_CLASS_NAME_BY_UNIT_TYPE) do
        local registry_value = civilization_table[unit_type]
        remaining_checks[class_name] = AoE4RPG_BlueprintRegistryValueExists(registry_value) and 1 or 0
    end
    return remaining_checks
end

-- Builds the stable capacity key used by the per-class elite tracker.
function AoE4RPG_GetEliteTrackingLimitKey(class_name)
    if type(class_name) ~= "string" or class_name == "" then
        return nil
    end
    return "elite_" .. class_name
end

-- Returns a civilization/class dynamic elite rule, if one is configured.
function AoE4RPG_GetDynamicEliteLimitRule(civilization, class_name)
    local class_definition = AoE4RPG.CLASS_DEFINITIONS
        and class_name
        and AoE4RPG.CLASS_DEFINITIONS[class_name]
        or nil
    if not class_definition or class_definition.can_be_elite ~= true then
        return nil
    end
    local civilization_rules = AoE4RPG_DYNAMIC_ELITE_LIMIT_RULES
        and AoE4RPG_DYNAMIC_ELITE_LIMIT_RULES[civilization]
        or nil
    local limit_key = AoE4RPG_GetEliteTrackingLimitKey(class_name)
    return civilization_rules and limit_key and civilization_rules[limit_key] or nil
end

-- IMPORTANT: Explicit unit-type check for elites whose native tags do not include bodyguard.
-- Every matching dynamic row is exclusively elite.
function AoE4RPG_IsEntityDynamicElite(entity, civilization, class_name)
    local dynamic_rule = AoE4RPG_GetDynamicEliteLimitRule(civilization, class_name)
    if not entity or not dynamic_rule or not Entity_IsOfType then
        return false
    end
    for _, unit_type in ipairs(dynamic_rule.identifying_unit_types or {}) do
        if Entity_IsOfType(entity, unit_type) then
            return true
        end
    end
    return false
end

-- Reads the currently available Action resource.
-- IMPORTANT: Constant-name fallbacks keep this compatible with hosts that expose the enum under a slightly different SCAR name; Player_GetResources provides a named-table fallback.
function AoE4RPG_GetDynamicEliteAvailableResource(player, dynamic_rule)
    -- Action-resource lookup is currently only supported for the Japanese Sengoku Daimyo.
    -- IMPORTANT: Other civilizations must use fixed elite limits and should not query the player's Action resource.
    if not player or not dynamic_rule
        or dynamic_rule.civilization ~= "japanese_ha_sen" then
        return 0
    end
    if AoE4RPG_RUNTIME_GetPlayerHandle then
        player = AoE4RPG_RUNTIME_GetPlayerHandle(player)
    end
    if not player then
        return 0
    end
    if Player_GetResource then
        for _, constant_name in ipairs(dynamic_rule.resource_constant_names or {}) do
            local resource_type = _G and _G[constant_name] or nil
            if resource_type ~= nil then
                return math.max(0, Player_GetResource(player, resource_type) or 0)
            end
        end
    end
    if Player_GetResources then
        local resources = Player_GetResources(player)
        if resources then
            for _, resource_key in ipairs(dynamic_rule.resource_table_keys or {}) do
                if type(resources[resource_key]) == "number" then
                    return math.max(0, resources[resource_key])
                end
            end
        end
    end
    return 0
end

-- Returns the configured simultaneous elite cap for one class.
-- An unspecified elite class returns zero so production checks can stop immediately.
function AoE4RPG_GetEliteConcurrentTrackingLimit(civilization, class_name, player, tracked_count)
    local civilization_limits = AoE4RPG_ELITE_CONCURRENT_LIMITS[civilization] or {}
    local limit_key = AoE4RPG_GetEliteTrackingLimitKey(class_name)
    if not limit_key then
        return 0
    end
    local dynamic_rule = AoE4RPG_GetDynamicEliteLimitRule(civilization, class_name)
    if dynamic_rule then
        local available_resource = AoE4RPG_GetDynamicEliteAvailableResource(player, dynamic_rule)
        local resource_cost = math.max(0.0001, dynamic_rule.resource_cost_per_elite or 1)
        return math.max(0, tracked_count or 0) + math.floor(available_resource / resource_cost)
    end
    return civilization_limits[limit_key] or 0
end

-- Builds an O(1) reverse lookup from every blueprint variant to its civilization, class, and hero/elite role.
-- Adding blueprints to the registry automatically extends this lookup without changing event or UI code.
-- IMPORTANT: These overrides preserve source-folder identity for native elite blueprints and preserve the original growth civilization for Byzantine mercenaries.
-- IMPORTANT: The name resolver below is authoritative for Byzantine mercenary names.
-- IMPORTANT: The generated map remains as a compatibility fallback for exceptional names.
AoE4RPG_BYZANTINE_MERCENARY_ORIGIN_BY_CODE = {
    abb = "abbasid",
    abb_ha_01 = "abbasid_ha_01",
    byz = "byzantine",
    byz_ha_mac = "byzantine_ha_mac",
    chi = "chinese",
    chi_ha_01 = "chinese_ha_01",
    eng = "english",
    fre = "french",
    fre_ha_01 = "french_ha_01",
    hre = "hre",
    hre_ha_01 = "hre_ha_01",
    jpn = "japanese",
    jpn_ha_sen = "japanese_ha_sen",
    jin = "jin_dynasty",
    lan = "lancaster",
    mal = "malian",
    mon = "mongol",
    mon_ha_gol = "mongol_ha_gol",
    ott = "ottoman",
    rus = "rus",
    sul = "sultanate",
    sul_ha_tug = "sultanate_ha_tug",
    tem = "templar",
}

-- Extracts the original civilization from a Byzantine mercenary blueprint.
function AoE4RPG_GetByzantineMercenaryOriginCivilization(blueprint_name)
    if type(blueprint_name) ~= "string" then
        return nil
    end
    local normalized_name = AoE4RPG_NormalizeBlueprintName(blueprint_name)
    if not normalized_name or not string.match(normalized_name, "_byz$") then
        return nil
    end
    local origin_code = string.match(
        normalized_name,
        "^unit_shogun[^_]*_[^_]+_.-_[0-9]+_(.+)_byz$"
    )
    return origin_code
        and AoE4RPG_BYZANTINE_MERCENARY_ORIGIN_BY_CODE[origin_code]
        or nil
end

