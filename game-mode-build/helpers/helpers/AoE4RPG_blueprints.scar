function AoE4RPG_RebuildBlueprintTrackingLookup()
    AoE4RPG.BLUEPRINT_TRACKING_LOOKUP = {}
    AoE4RPG.BLUEPRINT_CIVILIZATION_LOOKUP = {}

    local function get_sorted_keys(value)
        if AoE4RPG_RUNTIME_GetSortedKeys then
            return AoE4RPG_RUNTIME_GetSortedKeys(value)
        end
        local keys = {}
        for key in pairs(value or {}) do
            table.insert(keys, key)
        end
        table.sort(keys)
        return keys
    end

    local visited_registry_tables = {}
    local function add_blueprint_value(value, entry)
        if type(value) == "string" then
            local normalized_name = AoE4RPG_NormalizeBlueprintName(value)
            if normalized_name then
                local role_override = AoE4RPG_BLUEPRINT_ROLE_OVERRIDES[normalized_name]
                local civilization_override = AoE4RPG_GetByzantineMercenaryOriginCivilization(
                    normalized_name
                ) or AoE4RPG_BLUEPRINT_CIVILIZATION_OVERRIDES[normalized_name]
                local resolved_entry = entry
                if role_override or civilization_override then
                    resolved_entry = {}
                    for entry_key, entry_value in pairs(entry) do
                        resolved_entry[entry_key] = entry_value
                    end
                    resolved_entry.role = role_override or resolved_entry.role
                    resolved_entry.civilization = civilization_override
                        or resolved_entry.civilization
                end
                AoE4RPG.BLUEPRINT_TRACKING_LOOKUP[normalized_name] = resolved_entry
                AoE4RPG.BLUEPRINT_CIVILIZATION_LOOKUP[normalized_name] =
                    resolved_entry.civilization
            end
            return
        end
        if type(value) ~= "table" then
            return
        end
        if visited_registry_tables[value] then
            return
        end
        visited_registry_tables[value] = true

        if value.blueprint then
            add_blueprint_value(value.blueprint, entry)
        end
        for key, child in pairs(value) do
            if key ~= "blueprint" and key ~= "parent_unit_type" then
                add_blueprint_value(child, entry)
            end
        end
        visited_registry_tables[value] = nil
    end

    for _, civilization in ipairs(get_sorted_keys(AoE4RPG_ENTITY_TABLE)) do
        local civilization_table = AoE4RPG_ENTITY_TABLE[civilization]
        if type(civilization_table) == "table" then
            for _, unit_type in ipairs(get_sorted_keys(civilization_table)) do
                local registry_value = civilization_table[unit_type]
                local class_name = AoE4RPG_CLASS_NAME_BY_UNIT_TYPE[unit_type]
                if class_name then
                    local registry_role = (AoE4RPG_GetDynamicEliteLimitRule(civilization, class_name)
                        or AoE4RPG_IsClassFlaggedElite(civilization, class_name))
                        and "elites"
                        or "heroes"
                    add_blueprint_value(registry_value, {
                        civilization = civilization,
                        unit_type = unit_type,
                        class_name = class_name,
                        role = registry_role,
                    })
                elseif unit_type == "elite" then
                    add_blueprint_value(registry_value, {
                        civilization = civilization,
                        unit_type = unit_type,
                        class_name = nil,
                        role = "elites",
                    })
                elseif AoE4RPG_PARENT_UNIT_TYPE_BY_UNIT_TYPE[unit_type] then
                    add_blueprint_value(registry_value, {
                        civilization = civilization,
                        unit_type = unit_type,
                        parent_unit_type = registry_value.parent_unit_type
                            or AoE4RPG_PARENT_UNIT_TYPE_BY_UNIT_TYPE[unit_type],
                        class_name = nil,
                        role = "attached",
                    })
                end
            end
        end
    end

    return AoE4RPG.BLUEPRINT_TRACKING_LOOKUP
end

function AoE4RPG_GetBlueprintTrackingEntryForEntity(entity)
    local civilization = AoE4RPG_GetUnitCivilization and AoE4RPG_GetUnitCivilization(entity) or nil
    -- IMPORTANT: Every native Jeanne tier carries the dedicated `jeanne_d_arc` type.
    -- Her spawn and blueprint-conversion frames can expose a transient live blueprint before the exact-name cache resolves it.
    if Entity_IsOfType and Entity_IsOfType(entity, "jeanne_d_arc") then
        return {
            civilization = "french_ha_01",
            unit_type = "hero",
            class_name = "ranger",
            role = "heroes",
            native_jeanne_fallback = true,
        }
    end

    -- Configured riders can be classified without a rider blueprint table.
    local rider_class = AoE4RPG_GetConfiguredRiderClass and AoE4RPG_GetConfiguredRiderClass(entity, civilization) or nil
    if AoE4RPG_IsConfiguredRider and AoE4RPG_IsConfiguredRider(entity, civilization, rider_class) then
        return { civilization = civilization, unit_type = "rider", parent_unit_type = "hero", class_name = rider_class, role = "attached", rider = true }
    end
    local elite_class = AoE4RPG_GetConfiguredEliteClass and AoE4RPG_GetConfiguredEliteClass(entity, civilization) or nil
    if AoE4RPG_IsConfiguredElite and AoE4RPG_IsConfiguredElite(entity, civilization, elite_class) then
        return { civilization = civilization, unit_type = "elite", class_name = elite_class, role = "elites", elite = true }
    end
    if not entity or not Entity_GetBlueprint then
        return nil
    end
    if not AoE4RPG.BLUEPRINT_TRACKING_LOOKUP then
        AoE4RPG_RebuildBlueprintTrackingLookup()
    end

    local blueprint = Entity_GetBlueprint(entity)
    local blueprint_name = blueprint
    if blueprint and BP_GetName then
        local resolved_name = BP_GetName(blueprint)
        if type(resolved_name) == "string" and resolved_name ~= "" then
            blueprint_name = resolved_name
        end
    end

    local normalized_name = AoE4RPG_NormalizeBlueprintName(blueprint_name)
    local tracking_entry = normalized_name
        and AoE4RPG.BLUEPRINT_TRACKING_LOOKUP[normalized_name]
        or nil
    local mercenary_origin = AoE4RPG_GetByzantineMercenaryOriginCivilization(
        normalized_name
    )
    if tracking_entry and mercenary_origin
        and tracking_entry.civilization ~= mercenary_origin then
        local resolved_entry = {}
        for entry_key, entry_value in pairs(tracking_entry) do
            resolved_entry[entry_key] = entry_value
        end
        resolved_entry.civilization = mercenary_origin
        tracking_entry = resolved_entry
    end
    if tracking_entry then
        return tracking_entry
    end

    -- IMPORTANT: A produced squad can expose its native/live blueprint for a short time instead of the registered RPG EBP.
    -- IMPORTANT: Exact blueprint lookup above remains preferred; this fallback is never used for neutral/world-owned entities.
    local fallback_civilization = nil
    if entity and Entity_GetPlayerOwner
        and (not World_OwnsEntity or not World_OwnsEntity(entity)) then
        fallback_civilization = AoE4RPG_GetUnitCivilization(entity)
    end
    local fallback_class = AoE4RPG_CLASS_GetClassForEntity
        and AoE4RPG_CLASS_GetClassForEntity(entity)
        or nil
    local fallback_unit_type = nil
    for unit_type, class_name in pairs(AoE4RPG_CLASS_NAME_BY_UNIT_TYPE or {}) do
        if class_name == fallback_class then
            fallback_unit_type = unit_type
            break
        end
    end
    local fallback_registry = fallback_civilization
        and AoE4RPG_ENTITY_TABLE[fallback_civilization]
        or nil
    if fallback_registry and fallback_unit_type
        and AoE4RPG_BlueprintRegistryValueExists(fallback_registry[fallback_unit_type]) then
        local fallback_role = (AoE4RPG_GetDynamicEliteLimitRule(fallback_civilization, fallback_class)
            or AoE4RPG_IsClassFlaggedElite(fallback_civilization, fallback_class))
            and "elites"
            or "heroes"
        return {
            civilization = fallback_civilization,
            unit_type = fallback_unit_type,
            class_name = fallback_class,
            role = fallback_role,
            live_blueprint_fallback = true,
        }
    end
    return tracking_entry
end

-- Returns the entity that should receive RPG growth.
function AoE4RPG_GetGrowthTargetEntity(entity)
    if not entity then
        return nil
    end
    local entry = AoE4RPG_GetBlueprintTrackingEntryForEntity(entity)
    local rider_civilization = AoE4RPG_GetUnitCivilization and AoE4RPG_GetUnitCivilization(entity) or nil
    local rider_class = AoE4RPG_GetConfiguredRiderClass and AoE4RPG_GetConfiguredRiderClass(entity, rider_civilization) or nil
    local is_configured_rider = AoE4RPG_IsConfiguredRider
        and AoE4RPG_IsConfiguredRider(entity, rider_civilization, rider_class)
        or false
    if (not entry or not entry.parent_unit_type) and not is_configured_rider then
        return entity
    end
    if Entity_GetParent then
        return Entity_GetParent(entity) or entity
    end
    if Entity_GetAttachedParent then
        return Entity_GetAttachedParent(entity) or entity
    end
    return entity
end

-- Resolves only registered hero/elite blueprints for UI and selection systems.
-- IMPORTANT: The reverse lookup is rebuilt once, so callers avoid full blueprint scans.
-- IMPORTANT: Keep role filtering here so all UI callers share one authoritative test.
function AoE4RPG_GetRegisteredHeroEntryForEntity(entity)
    local entry = AoE4RPG_GetBlueprintTrackingEntryForEntity(entity)
    if entry and (entry.role == "heroes" or entry.role == "elites") then
        return entry
    end
    return nil
end

-- This checks if an entity uses any blueprint written in the registry above.
function AoE4RPG_IsRegisteredEntityBlueprint(entity)
    if not entity or not Entity_GetBlueprint then
        return false
    end

    local blueprint = Entity_GetBlueprint(entity)
    local blueprint_name = blueprint
    if blueprint and BP_GetName then
        local resolved_name = BP_GetName(blueprint)
        if type(resolved_name) == "string" and resolved_name ~= "" then
            blueprint_name = resolved_name
        end
    end
    if type(blueprint_name) ~= "string" or blueprint_name == "" then
        return false
    end

    -- The engine can return either a short name or a full attrib path.
    local wanted_name = AoE4RPG_NormalizeBlueprintName(blueprint_name)
    local function contains_blueprint(value)
        if type(value) == "string" then
            return AoE4RPG_NormalizeBlueprintName(value) == wanted_name
        end
        if type(value) ~= "table" then
            return false
        end
        if value.blueprint and contains_blueprint(value.blueprint) then
            return true
        end
        for key, child in pairs(value) do
            if key ~= "blueprint" and contains_blueprint(child) then
                return true
            end
        end
        return false
    end

    return contains_blueprint(AoE4RPG_ENTITY_TABLE)
end
