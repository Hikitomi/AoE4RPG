-- ADJUST: change AoE4RPG_BLUEPRINT_LEVEL_BANDS above to move the blueprint level breaks.
function AoE4RPG_GetBlueprintStep(level)
    local current_level = level or 0
    if current_level < 0 then
        current_level = 0
    end

    for _, band in ipairs(AoE4RPG_BLUEPRINT_LEVEL_BANDS) do
        if current_level >= band.min and current_level <= band.max then
            return band.step
        end
    end

    return 5
end

-- Returns the exact blueprint for a unit type after checking the currently gained level.
-- ADJUST: edit AoE4RPG_ENTITY_TABLE above to add or replace unit blueprints.
function AoE4RPG_GetBlueprintForUnit(unit_type, civilization, level)
    if not unit_type then
        return nil
    end

    local current_level = level or 0
    -- This helper accepts one blueprint or a level-based blueprint list and picks the usable one.
    -- ADJUST: add another value format here only if the blueprint table starts using it.
    local function select_blueprint(raw_value)
        if type(raw_value) == "string" then
            return raw_value
        end

        if type(raw_value) ~= "table" then
            return nil
        end

        if raw_value.blueprint then
            return raw_value.blueprint
        end

        local step = AoE4RPG_GetBlueprintStep(current_level)
        if raw_value[step] then
            return raw_value[step]
        end

        local selected = nil
        for _, candidate in ipairs(raw_value) do
            if type(candidate) == "string" then
                selected = candidate
            elseif type(candidate) == "table" then
                local candidate_level = candidate.level or 0
                local candidate_bp = candidate.blueprint
                if candidate_bp and candidate_level <= current_level then
                    selected = candidate_bp
                end
            end
        end

        return selected
    end

    civilization = civilization or "default"
    local civ_table = AoE4RPG_ENTITY_TABLE[civilization] or AoE4RPG_ENTITY_TABLE.default
    if civ_table and civ_table[unit_type] then
        local bp = select_blueprint(civ_table[unit_type])
        if bp then
            return bp
        end
    end

    return select_blueprint(AoE4RPG_ENTITY_TABLE.default[unit_type])
end

-- This gives the class system a stable civilization context.
-- ADJUST: add civilization keys to AoE4RPG_ENTITY_TABLE so this lookup can recognize them.
function AoE4RPG_GetUnitCivilization(entity, owner)
    local player = owner

    if not player and entity then
        if AoE4RPG_ENTITY_TRACKER_GetSafePlayerOwner then
            player = AoE4RPG_ENTITY_TRACKER_GetSafePlayerOwner(entity)
        elseif Entity_GetPlayerOwner
            and (not World_OwnsEntity or not World_OwnsEntity(entity)) then
            player = Entity_GetPlayerOwner(entity)
        end
    end

    if player and AoE4RPG_RUNTIME_GetPlayerRaceName then
        local race = AoE4RPG_RUNTIME_GetPlayerRaceName(player, nil)
        if type(race) == "string" then
            local civ = string.lower(race)
            if AoE4RPG_ENTITY_TABLE[civ] then
                return civ
            end
        end
    end

    if entity and Entity_GetBlueprint then
        local bp = Entity_GetBlueprint(entity)
        if bp then
            local blueprint_name = bp
            if BP_GetName then
                local resolved_name = BP_GetName(bp)
                if type(resolved_name) == "string" and resolved_name ~= "" then
                    blueprint_name = resolved_name
                end
            end
            local normalized_name = AoE4RPG_NormalizeBlueprintName(blueprint_name)
            if not AoE4RPG.BLUEPRINT_CIVILIZATION_LOOKUP then
                AoE4RPG_RebuildBlueprintTrackingLookup()
            end
            local cached_civilization = normalized_name
                and AoE4RPG.BLUEPRINT_CIVILIZATION_LOOKUP[normalized_name]
                or nil
            if cached_civilization then
                return cached_civilization
            end

            -- Compatibility fallback for hosts that return raw PropertyBagGroups without names.
            for civ, unit_map in pairs(AoE4RPG_ENTITY_TABLE) do
                for _, blueprint_value in pairs(unit_map) do
                    if type(blueprint_value) == "string" and blueprint_value == bp then
                        return civ
                    elseif type(blueprint_value) == "table" then
                        for _, candidate in pairs(blueprint_value) do
                            if candidate == bp then
                                return civ
                            end
                        end
                    end
                end
            end
        end
    end

    return "default"
end

-- Looks up the extra stat growth assigned to a class for a given civilization.
-- ADJUST: edit AoE4RPG_UNIQUE_STAT_GROWTH above to change civilization bonuses.
function AoE4RPG_GetUniqueGrowthForClass(civilization, class_name)
    if not class_name then
        return { agility = 0.0, endurance = 0.0, vitality = 0.0 }
    end

    civilization = civilization or "default"
    local civ_growth = AoE4RPG_UNIQUE_STAT_GROWTH[civilization] or AoE4RPG_UNIQUE_STAT_GROWTH.default
    local class_growth = civ_growth[class_name] or AoE4RPG_UNIQUE_STAT_GROWTH.default[class_name] or {
        agility = 0.0,
        endurance = 0.0,
        vitality = 0.0,
    }

    return class_growth
end
