-- Optional burst-fire profiles for RPG attribute damage normalization.
-- IMPORTANT: The framework calculates: projectiles_per_burst = max(1, rate_of_fire * duration) RPG damage bonus per projectile = normal bonus / projectiles_per_burst Native weapon damage is never changed.
-- An absent or invalid row keeps the ordinary single-shot bonus.
-- Example only (deliberately disabled): ["unit_shogun_example_1_civ"] = { rate_of_fire = 16, duration = 0.125 },
AoE4RPG_BURST_FIRE_PROFILES = AoE4RPG_BURST_FIRE_PROFILES or {
}

-- Returns the optional burst profile for an entity's current live blueprint.
function AoE4RPG_GetBurstFireProfile(entity)
    if not entity or not Entity_GetBlueprint then
        return nil
    end
    local blueprint = Entity_GetBlueprint(entity)
    local blueprint_name = blueprint
    if blueprint and BP_GetName then
        local resolved_name = BP_GetName(blueprint)
        if type(resolved_name) == "string" and resolved_name ~= "" then
            blueprint_name = resolved_name
        end
    end
    if type(blueprint_name) ~= "string" then
        return nil
    end
    local normalized_name = AoE4RPG_NormalizeBlueprintName
        and AoE4RPG_NormalizeBlueprintName(blueprint_name)
        or blueprint_name
    return AoE4RPG_BURST_FIRE_PROFILES[normalized_name]
        or AoE4RPG_BURST_FIRE_PROFILES[blueprint_name]
end

-- Calculates the configured number of projectiles in one burst.
-- A minimum of one preserves normal damage for malformed rows and true single-shot weapons.
AoE4RPG_BURST_FIRE_PROJECTILE_COUNT_CACHE = AoE4RPG_BURST_FIRE_PROJECTILE_COUNT_CACHE or {}

function AoE4RPG_GetBurstFireProjectileCount(entity)
    local blueprint_name = AoE4RPG_ENTITY_TRACKER_GetEntityBlueprintName
        and AoE4RPG_ENTITY_TRACKER_GetEntityBlueprintName(entity)
        or nil
    if blueprint_name and AoE4RPG_BURST_FIRE_PROJECTILE_COUNT_CACHE[blueprint_name] then
        return AoE4RPG_BURST_FIRE_PROJECTILE_COUNT_CACHE[blueprint_name]
    end

    local profile = AoE4RPG_GetBurstFireProfile(entity)
    if type(profile) ~= "table" or not profile.rate_of_fire then
        local weapon_profile = AoE4RPG_GetBurstFireWeaponProfile(entity)
        if type(weapon_profile) == "table" then
            profile = weapon_profile[1]
        end
    end
    if type(profile) ~= "table" then
        return 1
    end
    local rate_of_fire = tonumber(profile.rate_of_fire or profile.fire_rate)
    local duration = tonumber(profile.duration or profile.burst_duration)
    if not rate_of_fire or not duration or rate_of_fire <= 0 or duration <= 0 then
        return 1
    end
    local projectile_count = math.max(1, rate_of_fire * duration)
    if blueprint_name then
        AoE4RPG_BURST_FIRE_PROJECTILE_COUNT_CACHE[blueprint_name] = projectile_count
    end
    return projectile_count
end

-- Precomputes base burst counts once during map initialization.
-- IMPORTANT: Bracket rate modifiers never update this cache, so RPG damage remains divided by the original burst count rather than the increased bracket rate.
function AoE4RPG_InitializeBurstFireProjectileCountCache()
    for blueprint_name, profile in pairs(AoE4RPG_BURST_FIRE_WEAPON_PROFILES or {}) do
        local weapon = type(profile) == "table" and profile[1] or nil
        local rate_of_fire = weapon and tonumber(weapon.rate_of_fire) or nil
        local duration = weapon and tonumber(weapon.duration) or nil
        if rate_of_fire and duration and rate_of_fire > 0 and duration > 0 then
            AoE4RPG_BURST_FIRE_PROJECTILE_COUNT_CACHE[blueprint_name] =
                math.max(1, rate_of_fire * duration)
        end
    end
end

function AoE4RPG_NormalizeBurstFireDamageBonus(entity, damage_bonus)
    local bonus = tonumber(damage_bonus) or 0
    return bonus / AoE4RPG_GetBurstFireProjectileCount(entity)
end

-- Resolves Jeanne's current combat path from the entity's live blueprint.
-- Returns nil for every other unit, and "villager" for her non-combat tier.
function AoE4RPG_GetJeanneCombatPath(entity)
    if not entity or not AoE4RPG_ENTITY_TRACKER_GetEntityBlueprintName then
        return nil
    end
    local blueprint_name = AoE4RPG_ENTITY_TRACKER_GetEntityBlueprintName(entity)
    return blueprint_name and AoE4RPG_JEANNE_COMBAT_PATH_BY_BLUEPRINT[blueprint_name]
        or nil
end

-- IMPORTANT: Uses Jeanne's explicit native path whenever applicable, then falls back to the engine's normal entity-type check for all other units.
-- Keeps every ranged/melee gated RPG system consistent through Jeanne conversions.
function AoE4RPG_EntityMatchesCombatType(entity, combat_type)
    local jeanne_combat_path = AoE4RPG_GetJeanneCombatPath(entity)
    if jeanne_combat_path then
        return jeanne_combat_path == combat_type
    end
    return Entity_IsOfType and Entity_IsOfType(entity, combat_type) or false
end

