function AoE4RPG_GetBlueprintArmor(blueprint_or_entity)
    local blueprint_name = blueprint_or_entity
    if type(blueprint_or_entity) == "table"
        and AoE4RPG_ENTITY_TRACKER_GetEntityBlueprintName then
        blueprint_name = AoE4RPG_ENTITY_TRACKER_GetEntityBlueprintName(blueprint_or_entity)
    elseif type(blueprint_or_entity) == "number" and Entity_FromID
        and AoE4RPG_ENTITY_TRACKER_GetEntityBlueprintName then
        local entity = Entity_FromID(blueprint_or_entity)
        blueprint_name = entity
            and AoE4RPG_ENTITY_TRACKER_GetEntityBlueprintName(entity)
            or nil
    end
    if type(blueprint_name) ~= "string" or blueprint_name == "" then
        return AoE4RPG_BLUEPRINT_ARMOR.default or 0
    end
    local normalized_name = AoE4RPG_NormalizeBlueprintName
        and AoE4RPG_NormalizeBlueprintName(blueprint_name)
        or blueprint_name
    return AoE4RPG_BLUEPRINT_ARMOR[normalized_name]
        or AoE4RPG_BLUEPRINT_ARMOR[blueprint_name]
        or AoE4RPG_BLUEPRINT_ARMOR.default
        or 0
end

-- Creates a complete four-channel resistance value with deterministic defaults.
-- Keeps callers from checking every optional field before calculation.
function AoE4RPG_CreateEmptyResistance()
    return {
        fire = { flat_armor = 0, percentage_reduction = 0 },
        melee = { flat_armor = 0, percentage_reduction = 0 },
        ranged = { flat_armor = 0, percentage_reduction = 0 },
        true_damage = { flat_armor = 0, percentage_reduction = 0 },
    }
end

-- Adds one partial resistance row into a complete resistance value.
-- Values are added so a future RPG bonus can be combined with the registered XML baseline.
function AoE4RPG_AddResistanceValues(target, source)
    if not target or not source then
        return target
    end

    for _, resistance_type in ipairs(AoE4RPG_RESISTANCE_TYPES) do
        local target_row = target[resistance_type]
            or { flat_armor = 0, percentage_reduction = 0 }
        local resistance_index = AoE4RPG_RESISTANCE_INDEX_BY_TYPE[resistance_type]
        local source_type = resistance_index and source[resistance_index] or nil
        if source_type then
            target_row.flat_armor = (target_row.flat_armor or 0)
                + (tonumber(source_type[1]) or 0)
            target_row.percentage_reduction = (target_row.percentage_reduction or 0)
                + (tonumber(source_type[2]) or 0)
        end
        target[resistance_type] = target_row
    end
    return target
end

-- Returns the registered resistance for a blueprint name or live entity.
-- IMPORTANT: The raw XML is never parsed at runtime.
function AoE4RPG_GetBlueprintResistance(blueprint_or_entity)
    local blueprint_name = blueprint_or_entity
    if type(blueprint_or_entity) == "table"
        and AoE4RPG_ENTITY_TRACKER_GetEntityBlueprintName then
        blueprint_name = AoE4RPG_ENTITY_TRACKER_GetEntityBlueprintName(blueprint_or_entity)
    elseif type(blueprint_or_entity) == "number" and Entity_FromID
        and AoE4RPG_ENTITY_TRACKER_GetEntityBlueprintName then
        local entity = Entity_FromID(blueprint_or_entity)
        blueprint_name = entity
            and AoE4RPG_ENTITY_TRACKER_GetEntityBlueprintName(entity)
            or nil
    end
    if type(blueprint_name) ~= "string" or blueprint_name == "" then
        blueprint_name = "default"
    elseif AoE4RPG_NormalizeBlueprintName then
        blueprint_name = AoE4RPG_NormalizeBlueprintName(blueprint_name)
    end

    local result = AoE4RPG_CreateEmptyResistance()
    local visited = {}
    local function append_row(row_name)
        if type(row_name) == "string" and AoE4RPG_NormalizeBlueprintName then
            row_name = AoE4RPG_NormalizeBlueprintName(row_name)
        end
        if not row_name or visited[row_name] then
            return
        end
        visited[row_name] = true
        local row = AoE4RPG_BLUEPRINT_RESISTANCE[row_name]
        if not row and AoE4RPG_NormalizeBlueprintName then
            for registered_name, registered_row in pairs(AoE4RPG_BLUEPRINT_RESISTANCE) do
                if AoE4RPG_NormalizeBlueprintName(registered_name) == row_name then
                    row = registered_row
                    row_name = registered_name
                    break
                end
            end
        end
        if not row then
            return
        end
        append_row(row.inherits)
        AoE4RPG_AddResistanceValues(result, row)
    end

    append_row(blueprint_name)
    if blueprint_name ~= "default" then
        append_row("default")
    end
    return result
end

-- Combines the registered blueprint baseline with an RPG resistance bonus.
-- Callers may provide only the channels/components they want to increase.
-- Results are normalized to the project's quarter-step stat convention.
function AoE4RPG_CalculateResistanceBonus(blueprint_or_entity, bonus_values)
    local result = AoE4RPG_GetBlueprintResistance(blueprint_or_entity)
    AoE4RPG_AddResistanceValues(result, bonus_values)
    for _, resistance_type in ipairs(AoE4RPG_RESISTANCE_TYPES) do
        local row = result[resistance_type]
        if AoE4RPG_RoundToStep then
            row.flat_armor = AoE4RPG_RoundToStep(row.flat_armor, 0.25)
            row.percentage_reduction = AoE4RPG_RoundToStep(row.percentage_reduction, 0.25)
        end
    end
    return result
end

-- Optional ownership relationship for non-class unit types.
-- A rider can be registered beside a hero and its growth is redirected to that parent hero.
AoE4RPG_PARENT_UNIT_TYPE_BY_UNIT_TYPE = {
    rider = "hero",
}

-- Civilization/class elite rules.
-- IMPORTANT: These can classify native elite entities without requiring an `elite` blueprint table.
-- Concurrent limits remain separate.
AoE4RPG_ELITE_RULES = {
    default = {},
    abbasid_ha_01 = { skirmisher = { elite = true }, duelist = { elite = true } },
    byzantine_ha_mac = { roamer = { elite = true }, skirmisher = { elite = true } },
    english = { duelist = { elite = true }, skirmisher = { elite = true } },
    french = { technician = { elite = true } },
    hre = { technician = { elite = true } },

}

function AoE4RPG_IsClassFlaggedElite(civilization, class_name)
    local class_definition = AoE4RPG.CLASS_DEFINITIONS
        and class_name
        and AoE4RPG.CLASS_DEFINITIONS[class_name]
        or nil
    if not class_definition or class_definition.can_be_elite ~= true then
        return false
    end
    local rule = AoE4RPG_GetEliteRule(civilization, class_name)
    return rule and rule.elite == true or false
end



-- Maximum simultaneously tracked elites per class and civilization.
-- IMPORTANT: Keys use `elite_<class_name>` so different elite classes never share one capacity.
-- Missing keys disable that elite class.
-- Example configuration: templar = { elite_skirmisher = 10, elite_roamer = 5, elite_duelist = 3 }
AoE4RPG_ELITE_CONCURRENT_LIMITS = {
    -- IMPORTANT: Elite capacity is taken from the native used-population requirement: medic or vehicle, whichever is non-zero, rather than the number of available SBP tiers.
    abbasid_ha_01 = { elite_skirmisher = 5 },
    lancaster = { elite_roamer = 2 },
    french = { elite_technician = 4 },
    hre = { elite_technician = 5 },
    english = { elite_duelist = 15 },
    mali = { elite_skirmisher = 25 },
    japanese = { elite_duelist = 4 },
}

-- Returns the configured elite rule for one civilization/class pair.
function AoE4RPG_GetEliteRule(civilization, class_name)
    local civilization_rules = AoE4RPG_ELITE_RULES
        and (AoE4RPG_ELITE_RULES[civilization] or AoE4RPG_ELITE_RULES.default)
        or nil
    if not civilization_rules or not class_name then return nil end
    return civilization_rules[class_name]
end

-- IMPORTANT: Resolves the configured class for a native elite.
-- IMPORTANT: Native class tags take priority.
function AoE4RPG_GetConfiguredEliteClass(entity, civilization, class_name)
    local resolved_class = class_name
    if not resolved_class and AoE4RPG_CLASS_GetClassForEntity then
        resolved_class = AoE4RPG_CLASS_GetClassForEntity(entity)
    end
    local resolved_definition = AoE4RPG.CLASS_DEFINITIONS
        and resolved_class
        and AoE4RPG.CLASS_DEFINITIONS[resolved_class]
        or nil
    if resolved_definition and resolved_definition.can_be_elite == true then
        local rule = AoE4RPG_GetEliteRule(civilization, resolved_class)
        if rule and rule.elite == true then return resolved_class end
    end
    local civilization_rules = AoE4RPG_ELITE_RULES
        and (AoE4RPG_ELITE_RULES[civilization] or AoE4RPG_ELITE_RULES.default)
        or {}
    local only_class = nil
    for candidate_class, rule in pairs(civilization_rules) do
        local class_definition = AoE4RPG.CLASS_DEFINITIONS
            and AoE4RPG.CLASS_DEFINITIONS[candidate_class]
            or nil
        if class_definition and class_definition.can_be_elite == true
            and rule and rule.elite == true then
            if only_class then return nil end
            only_class = candidate_class
        end
    end
    return only_class
end

-- IMPORTANT: Tests native elite identity plus the configured civilization/class rule.
function AoE4RPG_IsConfiguredElite(entity, civilization, class_name)
    if not entity or not Entity_IsOfType then return false end
    local native_elite = Entity_IsOfType(entity, AoE4RPG_BP_BODYGUARD or "bodyguard")
    if not native_elite and AoE4RPG_IsEntityDynamicElite then
        native_elite = AoE4RPG_IsEntityDynamicElite(entity, civilization, class_name)
    end
    if not native_elite then return false end
    return AoE4RPG_GetConfiguredEliteClass(entity, civilization, class_name) ~= nil
end

-- Civilization/class rider rules.
-- IMPORTANT: These do not require a rider registry table.
-- IMPORTANT: A matching entity must have the native `rider` type and the class's native type tag; it is then treated as an attachment-only rider for that profile.
AoE4RPG_RIDER_RULES = {
    default = {},
    abbasid_ha_01 = { initiator = { rider = true } },
    -- Example: abbasid = { ranger = { rider = true } }, mongol = { commander = { rider = true } },
}

-- Civilization-specific Duelist combat effects.
-- Effectiveness is a movement speed percentage, so 0.10 means 10% faster movement after a successful hit.
AoE4RPG_DUELIST_ATTACK_MOVEMENT_SPEED = {
    default = { effectiveness = 0 },
    english = { effectiveness = 0.10 },
    lancaster = { effectiveness = 0.15 },
}

-- Returns the configured Duelist attack movement-speed effect for a civilization.
function AoE4RPG_GetDuelistAttackMovementSpeedRule(civilization)
    local rules = AoE4RPG_DUELIST_ATTACK_MOVEMENT_SPEED or {}
    return rules[civilization] or rules.default
end

-- Returns the configured rider rule for one civilization/class pair.
function AoE4RPG_GetRiderRule(civilization, class_name)
    local civilization_rules = AoE4RPG_RIDER_RULES
        and (AoE4RPG_RIDER_RULES[civilization]
            or AoE4RPG_RIDER_RULES.default)
        or nil
    if not civilization_rules or not class_name then return nil end
    return civilization_rules[class_name]
end

-- Resolves the configured class for a rider.
-- IMPORTANT: Native class tags take priority.
-- IMPORTANT: If no native class is exposed, a single rider=true class for the civilization is an unambiguous fallback; multiple configured classes require native tags.
function AoE4RPG_GetConfiguredRiderClass(entity, civilization, class_name)
    local resolved_class = class_name
    if not resolved_class and AoE4RPG_CLASS_GetClassForEntity then
        resolved_class = AoE4RPG_CLASS_GetClassForEntity(entity)
    end
    if resolved_class then
        local rule = AoE4RPG_GetRiderRule(civilization, resolved_class)
        if rule and rule.rider == true then return resolved_class end
    end
    local civilization_rules = AoE4RPG_RIDER_RULES
        and (AoE4RPG_RIDER_RULES[civilization] or AoE4RPG_RIDER_RULES.default)
        or {}
    local only_class = nil
    for candidate_class, rule in pairs(civilization_rules) do
        if rule and rule.rider == true then
            if only_class then return nil end
            only_class = candidate_class
        end
    end
    return only_class
end

-- IMPORTANT: Tests the native rider tag and the configured civilization/class rider rule.
function AoE4RPG_IsConfiguredRider(entity, civilization, class_name)
    if not entity or not Entity_IsOfType or not Entity_IsOfType(entity, "rider") then
        return false
    end
    return AoE4RPG_GetConfiguredRiderClass(entity, civilization, class_name) ~= nil
end
-- Elite level overrides are separate from elite concurrent limits.
-- They only change the maximum RPG level after an entity is already classified as an elite.
-- Set `maximum_internal_level` only when an elite needs a custom cap.
-- IMPORTANT: Unlisted elites always use AoE4RPG.EliteMaxLevel.
AoE4RPG_ELITE_LEVEL_OVERRIDES = {
    default = {},
}

-- Returns the civilization/class-specific elite level override, if configured.
function AoE4RPG_GetEliteLevelOverride(civilization, class_name)
    local civilization_rules = AoE4RPG_ELITE_LEVEL_OVERRIDES
        and (AoE4RPG_ELITE_LEVEL_OVERRIDES[civilization]
            or AoE4RPG_ELITE_LEVEL_OVERRIDES.default)
        or nil
    if not civilization_rules or not class_name then return nil end
    return civilization_rules[class_name]
end

