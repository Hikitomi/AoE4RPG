-- ========================== Passive Only Section ===========================
-- Skill restrictions for class/civilization-specific random-bonus rolls.
-- ========================== Passive Only Section ===========================

AoE4RPG_ABILITY_SKILL_RESTRICTIONS = {
    french_ha_01 = { hero = "passive_only" },
    mongol = { commander = "passive_only" },
    mongol_ha_gol = { commander = "passive_only" },
}

function AoE4RPG_GetAbilitySkillRestriction(civilization, class_name)
    local civilization_rules = AoE4RPG_ABILITY_SKILL_RESTRICTIONS
        and AoE4RPG_ABILITY_SKILL_RESTRICTIONS[civilization]
    return civilization_rules and civilization_rules[class_name] or nil
end

-- ========================== Special Leveling ================================
-- IMPORTANT: Special progression profiles for native tiered heroes.
-- IMPORTANT: Jeanne's native state model is authoritative: this module only reads it and never grants or removes Jeanne experience.
-- IMPORTANT: Her cumulative native thresholds are 0, 500, 1000, and 2500 experience for tiers 1-4.
-- Khan variants keep normal AoE4RPG experience, but share the four-bracket layout and displayed level-24 cap.
-- ========================== Special Leveling ================================
-- ==================== Foreign Hero Growth Rules ==============
-- Byzantine can hire heroes whose blueprint belongs to another registered civilization.
-- IMPORTANT: Multiple foreign heroes may share a class; each EntityID keeps its own progression inside the selected class profile.
-- ==================== Foreign Hero Growth Rules ==============
AoE4RPG_FOREIGN_HERO_RULES = {
    default = {
        allow_foreign_hero_blueprints = false,
        use_blueprint_civilization_growth = false,
        allow_multiple_same_class = false,
    },
    byzantine = {
        allow_foreign_hero_blueprints = true,
        use_blueprint_civilization_growth = true,
        allow_multiple_same_class = true,
    },
}

function AoE4RPG_GetForeignHeroRule(civilization)
    return AoE4RPG_FOREIGN_HERO_RULES[civilization]
        or AoE4RPG_FOREIGN_HERO_RULES.default
end

function AoE4RPG_IsForeignHeroBlueprintAllowed(civilization, tracking_entry)
    local rule = AoE4RPG_GetForeignHeroRule(civilization)
    return rule.allow_foreign_hero_blueprints == true
        and tracking_entry
        and tracking_entry.role == "heroes"
        and tracking_entry.civilization
        and tracking_entry.civilization ~= civilization
end

function AoE4RPG_GetEntityGrowthCivilization(player_civilization, tracking_entry)
    local rule = AoE4RPG_GetForeignHeroRule(player_civilization)
    if rule.use_blueprint_civilization_growth == true
        and AoE4RPG_IsForeignHeroBlueprintAllowed(player_civilization, tracking_entry) then
        return tracking_entry.civilization
    end
    return player_civilization or tracking_entry and tracking_entry.civilization or "default"
end

function AoE4RPG_ShouldAllowMultipleForeignHeroes(civilization)
    return AoE4RPG_GetForeignHeroRule(civilization).allow_multiple_same_class == true
end

