function AoE4RPG_GetBurstFireWeaponProfile(entity)
    if not entity or not AoE4RPG_ENTITY_TRACKER_GetEntityBlueprintName then
        return nil
    end
    local blueprint_name = AoE4RPG_ENTITY_TRACKER_GetEntityBlueprintName(entity)
    return blueprint_name
        and (AoE4RPG_BURST_FIRE_WEAPON_PROFILES[blueprint_name]
            or AoE4RPG_BURST_FIRE_WEAPON_PROFILES.default)
        or nil
end

function AoE4RPG_GetBaseAttribute(civilization, unit_type)
    local civ_rows = AoE4RPG_BASE_ATTRIBUTE[civilization]
        or AoE4RPG_BASE_ATTRIBUTE.default
        or {}
    return civ_rows[unit_type] or { agility = 0.0, endurance = 0.0, vitality = 0.0 }
end

-- ==================== Blueprint Resistance Registry ==============
-- Stores resistance values that are explicitly defined by a unit blueprint's health_ext.
-- ==================== Blueprint Resistance Registry ==============

-- IMPORTANT: The four resistance channels use the same damage-type split as the native armor modifiers.
-- Compact rows always use this order: Fire, Melee, Ranged, True Damage.
AoE4RPG_RESISTANCE_TYPES = {
    "fire",
    "melee",
    "ranged",
    "true_damage",
}

AoE4RPG_RESISTANCE_INDEX_BY_TYPE = {
    fire = 1,
    melee = 2,
    ranged = 3,
    true_damage = 4,
}

-- IMPORTANT: Native modifier names are kept here so later bonus calculations can apply a channel without duplicating string literals throughout the leveling code.
AoE4RPG_RESISTANCE_MODIFIER_NAMES = {
    fire = "armor_scalar_for_fire_damage",
    melee = "armor_scalar_for_melee_damage",
    ranged = "armor_scalar_for_ranged_damage",
    true_damage = "armor_scalar_for_truedamage_damage",
}

