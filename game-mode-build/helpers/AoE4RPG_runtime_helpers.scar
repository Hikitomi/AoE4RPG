-- ================= AoE4RPG Runtime Helpers ===============
-- AoE4RPG Runtime Helpers - Provides compatibility-safe identifiers, time, copying, and registry traversal.
-- Author: Hikitomi
-- Referenced: Native Entity, Player, World, and Game SCAR APIs.
-- ================= AoE4RPG Runtime Helpers ===============

AoE4RPG = AoE4RPG or {}

function AoE4RPG_RUNTIME_GetPlayerIdentifier(player)
    if type(player) == "number" then
        return player
    end
    if not player then
        return nil
    end
    if type(player.PlayerID) == "number" then
        return player.PlayerID
    end
    if player.id ~= nil and player.id ~= player then
        local player_id = AoE4RPG_RUNTIME_GetPlayerIdentifier(player.id)
        if player_id ~= nil then
            return player_id
        end
    end
    if Player_GetID then
        local success, player_id = pcall(Player_GetID, player)
        if success and type(player_id) == "number" then
            return player_id
        end
    end
    return nil
end

-- Resolves a Player* from a PlayerID or a PLAYERS wrapper table.
-- IMPORTANT: Native Player APIs must never receive the wrapper or numeric ID.
function AoE4RPG_RUNTIME_GetPlayerHandle(player)
    if not player then
        return nil
    end
    if scartype and ST_PLAYER then
        -- IMPORTANT: Some engine wrapper tables make scartype recurse internally.
        -- Keep that compatibility probe protected so UI/network callbacks cannot overflow the SCAR stack.
        local success, player_type = pcall(scartype, player)
        if success and player_type == ST_PLAYER then
            return player
        end
    end
    if type(player) == "number" then
        local player_from_id = Player_FromId or Player_FromID
        return player_from_id and player_from_id(player) or nil
    end
    if type(player) == "table" then
        -- UAGS PLAYERS entries commonly store the native Player handle in `id`.
        -- IMPORTANT: Do not treat that handle table as the outer PLAYERS wrapper.
        if player.id ~= nil and type(player.id) ~= "number" then
            return player.id
        end
        local player_id = player.id or player.PlayerID
        if type(player_id) == "number" then
            local player_from_id = Player_FromId or Player_FromID
            return player_from_id and player_from_id(player_id) or nil
        end
    end
    return player
end

-- Returns a player's race without passing a PLAYERS data table to the native API.
-- IMPORTANT: UAGS PLAYERS entries expose raceName directly, while Player_GetRaceName requires a native Player handle.
function AoE4RPG_RUNTIME_GetPlayerRaceName(player, fallback)
    if not player then
        return fallback
    end
    if type(player) == "table" then
        local race_name = player.raceName or player.race_name
        if type(race_name) == "string" and race_name ~= "" then
            return race_name
        end
    end
    if not Player_GetRaceName then
        return fallback
    end
    local player_handle = AoE4RPG_RUNTIME_GetPlayerHandle(player)
    if not player_handle then
        return fallback
    end
    local success, race_name = pcall(Player_GetRaceName, player_handle)
    if success and type(race_name) == "string" and race_name ~= "" then
        return race_name
    end
    return fallback
end

function AoE4RPG_RUNTIME_GetEntityIdentifier(entity)
    if type(entity) == "number" then
        return entity
    end
    if not entity then
        return nil
    end
    if type(entity.EntityID) == "number" then
        return entity.EntityID
    end
    if type(entity.id) == "number" then
        return entity.id
    end
    local is_entity_handle = true
    if scartype and ST_ENTITY then
        -- IMPORTANT: Keep the engine type probe protected for event targets and wrappers.
        local success, entity_type = pcall(scartype, entity)
        is_entity_handle = success and entity_type == ST_ENTITY
    end
    if Entity_GetID and is_entity_handle then
        local success, entity_id = pcall(Entity_GetID, entity)
        if success and type(entity_id) == "number" then
            return entity_id
        end
    end
    return nil
end

function AoE4RPG_RUNTIME_GetLiveEntity(entity_or_id)
    local entity_id = AoE4RPG_RUNTIME_GetEntityIdentifier(entity_or_id)
    if not entity_id then
        return nil
    end
    local entity = type(entity_or_id) == "number"
        and Entity_FromID and Entity_FromID(entity_id)
        or entity_or_id
    if not entity or (Entity_IsValid and not Entity_IsValid(entity_id)) then
        return nil
    end
    return entity
end

function AoE4RPG_RUNTIME_GetTime()
    if Game_GetTime then
        local game_time = Game_GetTime()
        if game_time ~= nil then
            return game_time
        end
    end
    if World_GetGameTime then
        return World_GetGameTime()
    end
    return nil
end

function AoE4RPG_RUNTIME_CopyTable(value)
    if type(value) ~= "table" then
        return value
    end
    local copy = {}
    for key, child in pairs(value) do
        copy[key] = AoE4RPG_RUNTIME_CopyTable(child)
    end
    return copy
end

function AoE4RPG_RUNTIME_GetSortedKeys(value)
    local keys = {}
    for key in pairs(type(value) == "table" and value or {}) do
        table.insert(keys, key)
    end
    table.sort(keys, function(left, right)
        if type(left) == type(right)
            and (type(left) == "number" or type(left) == "string") then
            return left < right
        end
        return tostring(left) < tostring(right)
    end)
    return keys
end

function AoE4RPG_RUNTIME_ForEachBlueprintName(value, callback)
    if type(callback) ~= "function" then
        return
    end
    if type(value) == "string" then
        callback(value)
        return
    end
    if type(value) ~= "table" then
        return
    end
    for key, child in pairs(value) do
        if key ~= "parent_unit_type" and key ~= "rider" and key ~= "class_name" then
            AoE4RPG_RUNTIME_ForEachBlueprintName(child, callback)
        end
    end
end
