-- ================= AoE4RPG Class Slots ===============
-- AoE4RPG Class Slots - Production Limits enforces hero class and elite production limits.
-- Author: Hikitomi
-- Referenced: AoE4RPG_classes.scar and AoE4RPG_entity_tracker.scar.
-- ================= AoE4RPG Class Slots ===============

if not AoE4RPG then
    AoE4RPG = {}
end

AoE4RPG.CLASS_SLOTS = AoE4RPG.CLASS_SLOTS or {
    initialized = false,
    player_id = nil,
    civilization = "default",
    maximum = 5,
    occupied = {},
    entity_counts = {},
    production_by_slot = {},
    removed_squad_blueprints = {},
    removed_entity_blueprints = {},
    -- The local state remains the UI-facing compatibility table.
    states_by_player_id = {},
}
AoE4RPG.CLASS_SLOTS.states_by_player_id = AoE4RPG.CLASS_SLOTS.states_by_player_id or {}

-- Production-availability APIs use the engine Player* handle.
local function AoE4RPG_ClassSlots_GetPlayerHandle(state)
    if type(state) ~= "table" then
        return nil
    end
    if state.player_handle then
        return state.player_handle
    end
    if AoE4RPG_RUNTIME_GetPlayerHandle and state.player_id then
        state.player_handle = AoE4RPG_RUNTIME_GetPlayerHandle(state.player_id)
        return state.player_handle
    end
    if Player_FromId and state.player_id then
        local success, player = pcall(Player_FromId, state.player_id)
        if success and player then
            state.player_handle = player
            return player
        end
    end
    return nil
end

-- ScarDoc exposes SBP_Exists and EBP_Exists for checking names before resolving them.
-- IMPORTANT: Production rows can expose either an entity name or a squad name, so the exact registered name is always preferred before any compatibility fallback.
local function AoE4RPG_ClassSlots_TryGetSquadBlueprint(blueprint_name)
    if type(blueprint_name) ~= "string" or blueprint_name == ""
        or not BP_GetSquadBlueprint then
        return nil
    end
    if SBP_Exists then
        local exists_success, exists = pcall(SBP_Exists, blueprint_name)
        if exists_success and not exists then
            return nil
        end
    end
    local success, squad_blueprint = pcall(BP_GetSquadBlueprint, blueprint_name)
    if success then
        return squad_blueprint
    end
    return nil
end

local function AoE4RPG_ClassSlots_TryGetEntityBlueprint(blueprint_name)
    if type(blueprint_name) ~= "string" or blueprint_name == ""
        or not BP_GetEntityBlueprint then
        return nil
    end
    if EBP_Exists then
        local exists_success, exists = pcall(EBP_Exists, blueprint_name)
        if exists_success and not exists then
            return nil
        end
    end
    local success, entity_blueprint = pcall(BP_GetEntityBlueprint, blueprint_name)
    if success then
        return entity_blueprint
    end
    return nil
end

-- Safely reads the name of a resolved property-bag group.
local function AoE4RPG_ClassSlots_TryGetBlueprintName(blueprint)
    if not blueprint or not BP_GetName then
        return nil
    end
    local success, blueprint_name = pcall(BP_GetName, blueprint)
    if success and type(blueprint_name) == "string" and blueprint_name ~= "" then
        return string.lower(blueprint_name)
    end
    return nil
end

-- ==================== Blueprint to Squad Name ====================
-- RPG hero and elite entity blueprints use one class segment that is not part of their squad blueprint name.
-- IMPORTANT: Riders never call this function because they are attachment-only records.
-- ==================== Blueprint to Squad Name ====================

function AoE4RPG_GetSquadBlueprintNameFromEntityBlueprint(entity_blueprint_name)
    if type(entity_blueprint_name) ~= "string" or entity_blueprint_name == "" then
        return nil
    end
    local normalized_name = AoE4RPG_NormalizeBlueprintName
        and AoE4RPG_NormalizeBlueprintName(entity_blueprint_name)
        or string.lower(entity_blueprint_name)
    if not normalized_name then
        return nil
    end

    local squad_name = string.gsub(
        normalized_name,
        "^(unit_shogun)_([^_]+)_",
        "%1_"
    )
    squad_name = string.gsub(
        squad_name,
        "^(unit_shogunu)_([^_]+)_",
        "%1_"
    )
    return squad_name
end

-- Resolves one class slot identity.
-- Normal classes use only class_name.
function AoE4RPG_CLASS_SLOTS_GetSlotKey(player_civilization, entry, growth_civilization)
    if type(entry) ~= "table"
        or entry.role == "attached"
        or entry.parent_unit_type
        or type(entry.class_name) ~= "string"
        or entry.class_name == "" then
        return nil
    end

    local is_byzantine_foreign = player_civilization == "byzantine"
        and entry.role == "heroes"
        and type(entry.civilization) == "string"
        and entry.civilization ~= player_civilization
    if is_byzantine_foreign then
        return tostring(growth_civilization or entry.civilization)
            .. ":" .. entry.class_name
    end
    return entry.class_name
end

local function AoE4RPG_ClassSlots_CollectBlueprintNames(value, callback)
    if AoE4RPG_RUNTIME_ForEachBlueprintName then
        AoE4RPG_RUNTIME_ForEachBlueprintName(value, callback)
        return
    end
    if type(value) == "string" then
        callback(value)
        return
    end
    if type(value) ~= "table" then
        return
    end
    for key, child in pairs(value) do
        if key ~= "parent_unit_type"
            and key ~= "rider"
            and key ~= "class_name" then
            AoE4RPG_ClassSlots_CollectBlueprintNames(child, callback)
        end
    end
end

-- Adds one entity/squad production pair to a class slot while deduplicating repeated tier and tracking entries.
local function AoE4RPG_ClassSlots_AddProductionPair(slot_key, entity_name, state)
    local normalized_entity_name = AoE4RPG_NormalizeBlueprintName
        and AoE4RPG_NormalizeBlueprintName(entity_name)
        or nil
    if not slot_key or not normalized_entity_name then
        return
    end
    local squad_name = AoE4RPG_GetSquadBlueprintNameFromEntityBlueprint
        and AoE4RPG_GetSquadBlueprintNameFromEntityBlueprint(normalized_entity_name)
        or normalized_entity_name
    state = state or AoE4RPG.CLASS_SLOTS
    local slot_rows = state.production_by_slot[slot_key]
    if not slot_rows then
        slot_rows = {}
        state.production_by_slot[slot_key] = slot_rows
    end

    local pair_key = normalized_entity_name .. "|" .. tostring(squad_name or "")
    for _, row in ipairs(slot_rows) do
        if row.key == pair_key then
            return
        end
    end
    table.insert(slot_rows, {
        key = pair_key,
        entity_name = normalized_entity_name,
        squad_name = squad_name,
    })
end

-- Resolves the production SBP for a registry row.
-- The project registry is primarily an EBP registry, but AoE4 production buttons are controlled by SBPs.
-- In this project the two names usually match; some custom blueprints instead omit the class prefix.
-- Try the exact EBP name first, then the legacy derived name.
-- IMPORTANT: As a final compatibility fallback, scan the documented military SBP collection once and match either the SBP name or its first EBP.
-- IMPORTANT: The scan is intentionally limited to initialization/refresh, never selection.
local function AoE4RPG_ClassSlots_FindSquadBlueprint(row)
    if type(row) ~= "table" then
        return nil, nil
    end

    local candidate_names = {}
    if row.entity_name then
        table.insert(candidate_names, row.entity_name)
    end
    if row.squad_name and row.squad_name ~= row.entity_name then
        table.insert(candidate_names, row.squad_name)
    end

    for _, candidate_name in ipairs(candidate_names) do
        local squad_blueprint = AoE4RPG_ClassSlots_TryGetSquadBlueprint(candidate_name)
        if squad_blueprint then
            return squad_blueprint, candidate_name
        end
    end

    if not BP_GetSquadBlueprintsWithType then
        return nil, nil
    end
    local list_success, squad_blueprints = pcall(
        BP_GetSquadBlueprintsWithType,
        "military"
    )
    if not list_success or type(squad_blueprints) ~= "table" then
        return nil, nil
    end

    for _, squad_blueprint in pairs(squad_blueprints) do
        local squad_name = AoE4RPG_ClassSlots_TryGetBlueprintName(squad_blueprint)
        for _, candidate_name in ipairs(candidate_names) do
            if squad_name == candidate_name then
                return squad_blueprint, squad_name
            end
        end
        if SBP_GetFirstEBP then
            local first_ebp_success, first_ebp = pcall(
                SBP_GetFirstEBP,
                squad_blueprint
            )
            local first_ebp_name = first_ebp_success
                and AoE4RPG_ClassSlots_TryGetBlueprintName(first_ebp)
                or nil
            if first_ebp_name == row.entity_name then
                return squad_blueprint, squad_name
            end
        end
    end
    return nil, nil
end

-- Builds production pairs for the local civilization.
-- Byzantine additionally receives every foreign hero row accepted by its foreign-hero rule.
-- Rows for riders and unclassified elite entries are intentionally omitted.
function AoE4RPG_CLASS_SLOTS_BuildProductionLookup(player_civilization, state)
    local tracker = state or AoE4RPG.CLASS_SLOTS
    tracker.production_by_slot = {}
    local tables_to_scan = {}

    local civilization_names = {}
    for civilization in pairs(AoE4RPG_ENTITY_TABLE or {}) do
        table.insert(civilization_names, civilization)
    end
    table.sort(civilization_names)
    for _, civilization in ipairs(civilization_names) do
        local civilization_table = AoE4RPG_ENTITY_TABLE[civilization]
        local include_table = civilization == player_civilization
        if player_civilization == "byzantine" and civilization ~= player_civilization then
            include_table = true
        end
        if include_table and type(civilization_table) == "table" then
            table.insert(tables_to_scan, {
                civilization = civilization,
                values = civilization_table,
            })
        end
    end

    table.sort(tables_to_scan, function(left, right)
        return left.civilization < right.civilization
    end)
    for _, civilization_data in ipairs(tables_to_scan) do
        local source_civilization = civilization_data.civilization
        local unit_types = {}
        for unit_type in pairs(civilization_data.values) do
            table.insert(unit_types, unit_type)
        end
        table.sort(unit_types)
        for _, unit_type in ipairs(unit_types) do
            local registry_value = civilization_data.values[unit_type]
            local class_name = AoE4RPG_CLASS_NAME_BY_UNIT_TYPE
                and AoE4RPG_CLASS_NAME_BY_UNIT_TYPE[unit_type]
                or nil
            if class_name then
                local entry = {
                    civilization = source_civilization,
                    unit_type = unit_type,
                    class_name = class_name,
                    role = "heroes",
                }
                local is_foreign = AoE4RPG_IsForeignHeroBlueprintAllowed
                    and AoE4RPG_IsForeignHeroBlueprintAllowed(player_civilization, entry)
                    or false
                if source_civilization == player_civilization or is_foreign then
                    local growth_civilization = AoE4RPG_GetEntityGrowthCivilization
                        and AoE4RPG_GetEntityGrowthCivilization(player_civilization, entry)
                        or source_civilization
                    local slot_key = AoE4RPG_CLASS_SLOTS_GetSlotKey(
                        player_civilization,
                        entry,
                        growth_civilization
                    )
                    AoE4RPG_ClassSlots_CollectBlueprintNames(
                        registry_value,
                        function(entity_name)
                            AoE4RPG_ClassSlots_AddProductionPair(slot_key, entity_name, tracker)
                        end
                    )
                end
            end
        end
    end
    return tracker.production_by_slot
end

-- IMPORTANT: Restores only production entries previously removed by this module, so it never overwrites a pre-existing native lock or removal from another system.
local function AoE4RPG_CLASS_SLOTS_RestoreRemovedProduction(state)
    local tracker = state or AoE4RPG.CLASS_SLOTS
    if not tracker.player_id then
        return
    end
    local player_handle = AoE4RPG_ClassSlots_GetPlayerHandle(tracker)
    if Player_SetSquadProductionAvailability then
        local removed_squad_names = {}
        for squad_name in pairs(tracker.removed_squad_blueprints) do
            table.insert(removed_squad_names, squad_name)
        end
        table.sort(removed_squad_names)
        for _, squad_name in ipairs(removed_squad_names) do
            local squad_blueprint = AoE4RPG_ClassSlots_TryGetSquadBlueprint(squad_name)
            if squad_blueprint then
                Player_SetSquadProductionAvailability(
                    player_handle,
                    squad_blueprint,
                    ITEM_DEFAULT
                )
            end
        end
    end
    if Player_SetEntityProductionAvailability then
        local removed_entity_names = {}
        for entity_name in pairs(tracker.removed_entity_blueprints) do
            table.insert(removed_entity_names, entity_name)
        end
        table.sort(removed_entity_names)
        for _, entity_name in ipairs(removed_entity_names) do
            local entity_blueprint = AoE4RPG_ClassSlots_TryGetEntityBlueprint(entity_name)
            if entity_blueprint then
                Player_SetEntityProductionAvailability(
                    player_handle,
                    entity_blueprint,
                    ITEM_DEFAULT
                )
            end
        end
    end
    tracker.removed_squad_blueprints = {}
    tracker.removed_entity_blueprints = {}
end

-- Caches the expensive military-SBP fallback after the first resolution attempt.
local function AoE4RPG_ClassSlots_GetCachedSquadBlueprint(row)
    if row.squad_resolution_complete then
        return row.resolved_squad_blueprint, row.resolved_squad_name
    end
    row.squad_resolution_complete = true
    row.resolved_squad_blueprint, row.resolved_squad_name =
        AoE4RPG_ClassSlots_FindSquadBlueprint(row)
    return row.resolved_squad_blueprint, row.resolved_squad_name
end

local function AoE4RPG_ClassSlots_GetCachedEntityBlueprint(row)
    if row.entity_resolution_complete then
        return row.resolved_entity_blueprint
    end
    row.entity_resolution_complete = true
    row.resolved_entity_blueprint = row.entity_name
        and AoE4RPG_ClassSlots_TryGetEntityBlueprint(row.entity_name)
        or nil
    return row.resolved_entity_blueprint
end

-- Removes unoccupied class production entries only when every configured class slot is occupied.
-- The documented SBP availability call is primary because hero production buttons train squads.
-- IMPORTANT: Entity availability remains a fallback for custom production rows that expose an EBP directly.
function AoE4RPG_CLASS_SLOTS_RefreshProductionAvailability(state)
    local tracker = state or AoE4RPG.CLASS_SLOTS
    if not tracker.initialized or not tracker.player_id then
        return false
    end

    local occupied_count = 0
    for _ in pairs(tracker.occupied) do
        occupied_count = occupied_count + 1
    end
    tracker.production_limit_reached = tracker.maximum > 0
        and occupied_count >= tracker.maximum

    local desired_squad_blueprints = {}
    local desired_entity_blueprints = {}
    if tracker.production_limit_reached then
        local slot_keys = {}
        for slot_key in pairs(tracker.production_by_slot) do
            table.insert(slot_keys, slot_key)
        end
        table.sort(slot_keys)
        for _, slot_key in ipairs(slot_keys) do
            if not tracker.occupied[slot_key] then
                local production_rows = tracker.production_by_slot[slot_key]
                table.sort(production_rows, function(left, right)
                    return tostring(left.entity_name or left.squad_name or "")
                        < tostring(right.entity_name or right.squad_name or "")
                end)
                for _, row in ipairs(production_rows) do
                    local squad_blueprint, squad_name =
                        AoE4RPG_ClassSlots_GetCachedSquadBlueprint(row)
                    if squad_blueprint and squad_name then
                        desired_squad_blueprints[squad_name] = squad_blueprint
                    end
                    local entity_blueprint =
                        AoE4RPG_ClassSlots_GetCachedEntityBlueprint(row)
                    if entity_blueprint and row.entity_name then
                        desired_entity_blueprints[row.entity_name] = entity_blueprint
                    end
                end
            end
        end
    end

    local player_handle = AoE4RPG_ClassSlots_GetPlayerHandle(tracker)
    local removed_squads = tracker.removed_squad_blueprints or {}
    local removed_entities = tracker.removed_entity_blueprints or {}
    if Player_SetSquadProductionAvailability then
        local removed_squad_names = {}
        for squad_name in pairs(removed_squads) do
            table.insert(removed_squad_names, squad_name)
        end
        table.sort(removed_squad_names)
        for _, squad_name in ipairs(removed_squad_names) do
            if not desired_squad_blueprints[squad_name] then
                local squad_blueprint =
                    AoE4RPG_ClassSlots_TryGetSquadBlueprint(squad_name)
                if squad_blueprint then
                    Player_SetSquadProductionAvailability(
                        player_handle,
                        squad_blueprint,
                        ITEM_DEFAULT
                    )
                end
            end
        end
        local desired_squad_names = {}
        for squad_name in pairs(desired_squad_blueprints) do
            table.insert(desired_squad_names, squad_name)
        end
        table.sort(desired_squad_names)
        for _, squad_name in ipairs(desired_squad_names) do
            if not removed_squads[squad_name] then
                Player_SetSquadProductionAvailability(
                    player_handle,
                    desired_squad_blueprints[squad_name],
                    ITEM_REMOVED
                )
            end
        end
    end
    if Player_SetEntityProductionAvailability then
        local removed_entity_names = {}
        for entity_name in pairs(removed_entities) do
            table.insert(removed_entity_names, entity_name)
        end
        table.sort(removed_entity_names)
        for _, entity_name in ipairs(removed_entity_names) do
            if not desired_entity_blueprints[entity_name] then
                local entity_blueprint =
                    AoE4RPG_ClassSlots_TryGetEntityBlueprint(entity_name)
                if entity_blueprint then
                    Player_SetEntityProductionAvailability(
                        player_handle,
                        entity_blueprint,
                        ITEM_DEFAULT
                    )
                end
            end
        end
        local desired_entity_names = {}
        for entity_name in pairs(desired_entity_blueprints) do
            table.insert(desired_entity_names, entity_name)
        end
        table.sort(desired_entity_names)
        for _, entity_name in ipairs(desired_entity_names) do
            if not removed_entities[entity_name] then
                Player_SetEntityProductionAvailability(
                    player_handle,
                    desired_entity_blueprints[entity_name],
                    ITEM_REMOVED
                )
            end
        end
    end

    tracker.removed_squad_blueprints = {}
    for squad_name in pairs(desired_squad_blueprints) do
        tracker.removed_squad_blueprints[squad_name] = true
    end
    tracker.removed_entity_blueprints = {}
    for entity_name in pairs(desired_entity_blueprints) do
        tracker.removed_entity_blueprints[entity_name] = true
    end
    return true
end

-- Creates the deterministic per-player slot state used for remote human players.
function AoE4RPG_CLASS_SLOTS_EnsurePlayer(player_id, player_civilization, maximum)
    if not player_id then
        return nil
    end
    local local_state = AoE4RPG.CLASS_SLOTS
    if local_state.player_id == player_id then
        return local_state
    end
    local states = local_state.states_by_player_id
    local state = states[player_id]
    if not state then
        state = {
            initialized = true,
            player_id = player_id,
            civilization = player_civilization or "default",
            maximum = math.max(1, math.min(5, math.floor(tonumber(maximum) or 5))),
            occupied = {},
            entity_counts = {},
            production_by_slot = {},
            removed_squad_blueprints = {},
            removed_entity_blueprints = {},
            production_limit_reached = false,
        }
        states[player_id] = state
        AoE4RPG_CLASS_SLOTS_BuildProductionLookup(state.civilization, state)
    end
    return state
end

-- Initializes class-slot state once the local player and match setting exist.
function AoE4RPG_CLASS_SLOTS_Initialize(
    player_id,
    player_civilization,
    maximum,
    player_handle
)
    local tracker = AoE4RPG.CLASS_SLOTS
    if not player_id then
        return false
    end
    tracker.initialized = true
    tracker.player_id = player_id
    tracker.player_handle = player_handle
    tracker.civilization = player_civilization or "default"
    tracker.maximum = math.floor(tonumber(maximum) or 5)
    tracker.maximum = math.max(1, math.min(5, tracker.maximum))
    tracker.occupied = {}
    tracker.entity_counts = {}
    tracker.removed_squad_blueprints = {}
    tracker.removed_entity_blueprints = {}
    tracker.production_limit_reached = false
    tracker.states_by_player_id = tracker.states_by_player_id or {}
    tracker.states_by_player_id[player_id] = tracker
    AoE4RPG_CLASS_SLOTS_BuildProductionLookup(tracker.civilization)
    AoE4RPG_CLASS_SLOTS_RefreshProductionAvailability()
    return true
end

-- Returns whether a new class profile can consume a slot or already owns one.
function AoE4RPG_CLASS_SLOTS_CanAccept(slot_key)
    local tracker = AoE4RPG.CLASS_SLOTS
    if not slot_key or not tracker.initialized then
        return false
    end
    if tracker.occupied[slot_key] then
        return true
    end
    local occupied_count = 0
    for _ in pairs(tracker.occupied) do
        occupied_count = occupied_count + 1
    end
    return occupied_count < tracker.maximum
end

function AoE4RPG_CLASS_SLOTS_Reserve(slot_key, metadata, player_id)
    local tracker = player_id
        and AoE4RPG_CLASS_SLOTS_EnsurePlayer(
            player_id,
            metadata and metadata.player_civilization,
            AoE4RPG.SETTINGS and AoE4RPG.SETTINGS.max_class_slots
                or AoE4RPG.MaxClassSlots
                or 5
        )
        or AoE4RPG.CLASS_SLOTS
    if not tracker or not slot_key or not tracker.initialized then
        return false
    end
    if tracker.occupied[slot_key] then
        return true
    end
    local occupied_count = 0
    for _ in pairs(tracker.occupied) do
        occupied_count = occupied_count + 1
    end
    if occupied_count >= tracker.maximum then
        return false
    end
    tracker.occupied[slot_key] = metadata or true
    AoE4RPG_CLASS_SLOTS_RefreshProductionAvailability(tracker)
    return true
end

-- IMPORTANT: Tracks one live EntityID against a class slot without counting riders.
function AoE4RPG_CLASS_SLOTS_AddEntity(slot_key, player_id)
    if not slot_key then
        return false
    end
    local tracker = player_id and AoE4RPG_CLASS_SLOTS_EnsurePlayer(player_id)
        or AoE4RPG.CLASS_SLOTS
    if not tracker then
        return false
    end
    tracker.entity_counts[slot_key] = (tracker.entity_counts[slot_key] or 0) + 1
    return true
end

-- IMPORTANT: Removes one EntityID.
-- IMPORTANT: A reserved hero slot is retained while its native respawn record is pending, preventing another class from taking that slot.
function AoE4RPG_CLASS_SLOTS_RemoveEntity(slot_key, retain_slot, player_id)
    if not slot_key then
        return false
    end
    local tracker = player_id and AoE4RPG_CLASS_SLOTS_EnsurePlayer(player_id)
        or AoE4RPG.CLASS_SLOTS
    if not tracker then
        return false
    end
    local remaining = math.max(0, (tracker.entity_counts[slot_key] or 0) - 1)
    tracker.entity_counts[slot_key] = remaining
    if remaining == 0 and not retain_slot then
        tracker.entity_counts[slot_key] = nil
        tracker.occupied[slot_key] = nil
        AoE4RPG_CLASS_SLOTS_RefreshProductionAvailability(tracker)
    end
    return true
end

-- Answers whether production scanning should remain active for a new class.
function AoE4RPG_CLASS_SLOTS_HasCapacity()
    local tracker = AoE4RPG.CLASS_SLOTS
    if not tracker.initialized then
        return true
    end
    local occupied_count = 0
    for _ in pairs(tracker.occupied) do
        occupied_count = occupied_count + 1
    end
    return occupied_count < tracker.maximum
end

-- Restores module-owned availability changes at match shutdown.
function AoE4RPG_CLASS_SLOTS_Shutdown()
    for player_id, state in pairs(AoE4RPG.CLASS_SLOTS.states_by_player_id or {}) do
        if state ~= AoE4RPG.CLASS_SLOTS then
            AoE4RPG_CLASS_SLOTS_RestoreRemovedProduction(state)
        end
    end
    AoE4RPG_CLASS_SLOTS_RestoreRemovedProduction()
    local tracker = AoE4RPG.CLASS_SLOTS
    tracker.initialized = false
    tracker.player_id = nil
    tracker.occupied = {}
    tracker.entity_counts = {}
    tracker.production_by_slot = {}
    tracker.states_by_player_id = {}
    tracker.player_handle = nil
    return true
end
