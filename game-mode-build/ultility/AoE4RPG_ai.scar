-- ================= AoE4RPG AI ===============
-- AoE4RPG AI - AI Integration tracks AI heroes and applies progression and survival rules.
-- Author: Hikitomi
-- Referenced: AoE4RPG_core.scar, AoE4RPG_classes.scar, AoE4RPG_random_bonus.scar, and AoE4RPG_entity_tracker.scar.
-- ================= AoE4RPG AI ===============

if not AoE4RPG then
    AoE4RPG = {}
end

AoE4RPG.AI_TRACKER = AoE4RPG.AI_TRACKER or {
    initialized = false,
    build_event_registered = false,
    spawn_event_registered = false,
    tracked_entity_ids = {},
    tracked_entity_records = {},
    sorted_tracked_entity_ids = {},
    tracked_entity_ids_dirty = true,
    tracked_entities_by_player = {},
    retreating_entity_ids = {},
    retired_unit_data_by_player_class = {},
    fallback_player_ids = {},
    fallback_player_cursor = 1,
    fallback_scan_interval = 5.0,
    preservation_health_ratio = 0.35,
    preservation_release_ratio = 0.70,
    preservation_interval = 1.0,
}
AoE4RPG.AI_TRACKER.retreating_entity_ids =
    AoE4RPG.AI_TRACKER.retreating_entity_ids or {}
AoE4RPG.AI_TRACKER.retired_unit_data_by_player_class =
    AoE4RPG.AI_TRACKER.retired_unit_data_by_player_class or {}
AoE4RPG.AI_TRACKER.preservation_health_ratio =
    AoE4RPG.AI_TRACKER.preservation_health_ratio or 0.35
AoE4RPG.AI_TRACKER.preservation_release_ratio =
    AoE4RPG.AI_TRACKER.preservation_release_ratio or 0.70
AoE4RPG.AI_TRACKER.preservation_interval =
    AoE4RPG.AI_TRACKER.preservation_interval or 1.0
AoE4RPG.AI_TRACKER.fallback_player_ids =
    AoE4RPG.AI_TRACKER.fallback_player_ids or {}
AoE4RPG.AI_TRACKER.fallback_player_cursor =
    AoE4RPG.AI_TRACKER.fallback_player_cursor or 1
AoE4RPG.AI_TRACKER.fallback_scan_interval =
    AoE4RPG.AI_TRACKER.fallback_scan_interval or 5.0

local function AoE4RPG_AI_GetPlayerIdentifier(player)
    if AoE4RPG_RUNTIME_GetPlayerIdentifier then
        return AoE4RPG_RUNTIME_GetPlayerIdentifier(player)
    end
    if AoE4RPG_BONUS_GetPlayerIdentifier then
        return AoE4RPG_BONUS_GetPlayerIdentifier(player)
    end
    if type(player) == "number" then return player end
    if type(player) == "table" then
        return player.PlayerID or (player.id and AoE4RPG_AI_GetPlayerIdentifier(player.id))
    end
    return nil
end

local function AoE4RPG_AI_ResolvePlayer(player)
    if AoE4RPG_RUNTIME_GetPlayerHandle then
        return AoE4RPG_RUNTIME_GetPlayerHandle(player)
    end
    if type(player) ~= "number" then
        return player
    end
    local player_from_id = Player_FromId or Player_FromID
    return player_from_id and player_from_id(player) or nil
end

local function AoE4RPG_AI_IsComputerPlayer(player)
    player = AoE4RPG_AI_ResolvePlayer(player)
    local player_id = AoE4RPG_AI_GetPlayerIdentifier(player)
    if not player_id or not AI_IsAIPlayer then return false end
    local success, result = pcall(AI_IsAIPlayer, player)
    return success and result == true
end

-- Returns the AI-specific record used by the shared bonus offer code.
function AoE4RPG_AI_GetTrackedRecord(entity_id)
    return entity_id
        and AoE4RPG.AI_TRACKER.tracked_entity_records[entity_id]
        or nil
end

function AoE4RPG_AI_IsTrackedEntityIdentifier(entity_id)
    return entity_id ~= nil
        and AoE4RPG.AI_TRACKER.tracked_entity_ids[entity_id] == true
end

function AoE4RPG_AI_ForEachTrackedEntity(callback)
    if type(callback) ~= "function" then return end
    local tracker = AoE4RPG.AI_TRACKER
    if tracker.tracked_entity_ids_dirty then
        local entity_ids = {}
        for entity_id in pairs(tracker.tracked_entity_ids) do
            table.insert(entity_ids, entity_id)
        end
        table.sort(entity_ids)
        tracker.sorted_tracked_entity_ids = entity_ids
        tracker.tracked_entity_ids_dirty = false
    end
    for _, entity_id in ipairs(tracker.sorted_tracked_entity_ids) do
        local record = tracker.tracked_entity_records[entity_id]
        local entity = Entity_FromID and Entity_FromID(entity_id) or nil
        if entity and (not Entity_IsValid or Entity_IsValid(entity_id)) then
            callback(entity, entity_id, record)
        end
    end
end

local function AoE4RPG_AI_GetClassForEntity(entity, entry)
    return entry and entry.class_name
        or (AoE4RPG_CLASS_GetClassForEntity and AoE4RPG_CLASS_GetClassForEntity(entity))
end

local function AoE4RPG_AI_GetRetiredUnitDataKey(player_id, class_name, role)
    if player_id == nil or not class_name or not role then return nil end
    return tostring(player_id) .. ":" .. tostring(class_name) .. ":" .. tostring(role)
end

-- Restores the oldest matching AI progression record after a replacement EntityID appears.
local function AoE4RPG_AI_RestoreRetiredUnitData(entity_id, player_id, class_name, role)
    if not AoE4RPG.UNIT_DATA then return nil end
    local key = AoE4RPG_AI_GetRetiredUnitDataKey(player_id, class_name, role)
    local queue = key and AoE4RPG.AI_TRACKER.retired_unit_data_by_player_class[key]
        or nil
    local retired = queue and table.remove(queue, 1) or nil
    if not retired then return nil end
    if #queue == 0 then
        AoE4RPG.AI_TRACKER.retired_unit_data_by_player_class[key] = nil
    end
    if retired.entity_id and AoE4RPG.UNIT_DATA[retired.entity_id] == retired.unit_data then
        AoE4RPG.UNIT_DATA[retired.entity_id] = nil
    end
    AoE4RPG.UNIT_DATA[entity_id] = retired.unit_data
    return retired.unit_data
end

-- Tracks only a computer-owned registered hero or elite.
-- IMPORTANT: AI entities use the same slot rules through their own per-player state.
function AoE4RPG_AI_TrackEntity(entity, player)
    local entity_id = AoE4RPG_RUNTIME_GetEntityIdentifier
        and AoE4RPG_RUNTIME_GetEntityIdentifier(entity)
        or entity and entity.EntityID
    if not entity or not entity_id then return false end
    local tracker = AoE4RPG.AI_TRACKER
    if tracker.tracked_entity_ids[entity_id] then return false end

    local owner = player or (AoE4RPG_ENTITY_TRACKER_GetSafePlayerOwner
        and AoE4RPG_ENTITY_TRACKER_GetSafePlayerOwner(entity))
    owner = AoE4RPG_AI_ResolvePlayer(owner)
    if not AoE4RPG_AI_IsComputerPlayer(owner) then return false end
    local entry = AoE4RPG_GetBlueprintTrackingEntryForEntity
        and AoE4RPG_GetBlueprintTrackingEntryForEntity(entity)
        or nil
    if not entry or entry.role == "attached" or entry.parent_unit_type then return false end

    local class_name = AoE4RPG_AI_GetClassForEntity(entity, entry)
    if not class_name then return false end
    local player_id = AoE4RPG_AI_GetPlayerIdentifier(owner)
    local civilization = AoE4RPG_RUNTIME_GetPlayerRaceName
        and AoE4RPG_RUNTIME_GetPlayerRaceName(owner, entry.civilization)
        or entry.civilization
    local role = entry.role == "elites" and "elites" or "heroes"
    if AoE4RPG_IsConfiguredElite and AoE4RPG_IsConfiguredElite(entity, civilization, class_name) then
        role = "elites"
    end

    local growth_civilization = entry.civilization or civilization
    local class_slot_key = AoE4RPG_CLASS_SLOTS_GetSlotKey
        and AoE4RPG_CLASS_SLOTS_GetSlotKey(
            civilization,
            entry,
            growth_civilization
        )
        or class_name
    if not class_slot_key then return false end
    if AoE4RPG_CLASS_SLOTS_Reserve then
        local slot_reserved = AoE4RPG_CLASS_SLOTS_Reserve(
            class_slot_key,
            {
                class_name = class_name,
                civilization = growth_civilization,
                player_civilization = civilization,
                role = role,
            },
            player_id
        )
        if not slot_reserved then return false end
    end

    tracker.tracked_entity_ids[entity_id] = true
    tracker.tracked_entity_ids_dirty = true
    tracker.tracked_entity_records[entity_id] = {
        role = role,
        class_name = class_name,
        civilization = civilization,
        player_id = player_id,
        class_slot_key = class_slot_key,
    }
    tracker.tracked_entities_by_player[player_id] = tracker.tracked_entities_by_player[player_id] or {}
    tracker.tracked_entities_by_player[player_id][entity_id] = true
    if AoE4RPG_CLASS_SLOTS_AddEntity then
        AoE4RPG_CLASS_SLOTS_AddEntity(class_slot_key, player_id)
    end

    local unit_data = AoE4RPG_AI_RestoreRetiredUnitData(
        entity_id,
        player_id,
        class_name,
        role
    ) or (AoE4RPG_GetUnitData and AoE4RPG_GetUnitData(entity_id) or nil)
    if unit_data then
        unit_data.entity_id = entity_id
        unit_data.owner = owner
        unit_data.class_name = class_name
        unit_data.civilization = civilization
        unit_data.player_civilization = civilization
        unit_data.growth_civilization = growth_civilization
        unit_data.is_hero = role == "heroes"
        unit_data.is_elite = role == "elites"
    end
    if AoE4RPG_CLASS_RegisterEntity then
        AoE4RPG_CLASS_RegisterEntity(entity, growth_civilization, class_name)
    end
    if AoE4RPG_CLASS_BindUnit then AoE4RPG_CLASS_BindUnit(entity) end
    if AoE4RPG_BONUS_EnsureCurrentBracketOffer then
        AoE4RPG_BONUS_EnsureCurrentBracketOffer(entity, true)
    end
    if unit_data and AoE4RPG_CLASS_SyncEntityProgress then
        AoE4RPG_CLASS_SyncEntityProgress(entity, unit_data)
    end
    return true
end

-- Chooses one of the three generated choices without opening a human UI.
-- IMPORTANT: World_GetRand is synchronized; the deterministic fallback keeps all peers consistent when the host does not expose that helper.
function AoE4RPG_AI_AutoSelectOffer(entity, owner, bracket_index)
    if not entity or not AoE4RPG_AI_IsComputerPlayer(owner) then return false end
    local unit_data = AoE4RPG_GetUnitData(entity.EntityID)
    local record = AoE4RPG_AI_GetTrackedRecord(entity.EntityID)
    if not unit_data or not record then return false end

    if record.role == "elites" then
        local player_id = AoE4RPG_AI_GetPlayerIdentifier(owner)
        local shared_state = AoE4RPG.BONUS.shared_elite_bonus_by_player_id[player_id]
        if shared_state and not shared_state.chosen_choice then
            local choice_index = World_GetRand and World_GetRand(1, 3)
                or ((entity.EntityID + (bracket_index or 1)) % 3) + 1
            shared_state.chosen_choice = shared_state.choices[choice_index]
        end
        return shared_state and shared_state.chosen_choice ~= nil
    end

    local offers = unit_data.pending_bracket_bonus_offers or {}
    local offer = offers[1]
    if not offer or offer.bracket_index ~= bracket_index then return false end
    local choice_index = World_GetRand and World_GetRand(1, 3)
        or ((entity.EntityID + bracket_index) % 3) + 1
    local choice = offer.choices[choice_index]
    if not choice then return false end
    local applied = choice.kind == "bonus"
        and AoE4RPG_BONUS_ApplyDefinition(entity, unit_data, choice.key, false,
            "hero:" .. tostring(unit_data.class_name or "unclassified") .. ":bracket:" .. tostring(bracket_index), choice.amount)
        or choice.kind == "attribute"
            and AoE4RPG_BONUS_ApplyAttributeChoice(entity, unit_data, choice)
        or choice.kind == "skill"
            and AoE4RPG_BONUS_ApplySkillChoice(entity, unit_data, choice)
    if not applied then return false end
    unit_data.chosen_bracket_bonuses = unit_data.chosen_bracket_bonuses or {}
    unit_data.chosen_bracket_bonuses[bracket_index] = choice
    table.remove(offers, 1)
    if AoE4RPG_MarkUnitDataChanged then AoE4RPG_MarkUnitDataChanged(unit_data) end
    return true
end

-- Tracks a completed AI unit directly.
function AoE4RPG_AI_OnBuildItemComplete(context)
    if not context or not context.player
        or not AoE4RPG_AI_IsComputerPlayer(context.player) then
        return false
    end
    local player_handle = AoE4RPG_AI_ResolvePlayer(context.player)
    local spawned_squad = context.spawnedSquad
    local entity = spawned_squad and Squad_GetFirstEntity
        and Squad_GetFirstEntity(spawned_squad) or nil
    local tracked = entity and AoE4RPG_AI_TrackEntity(entity, player_handle) or false
    return tracked
end

function AoE4RPG_AI_OnSpawnActionComplete(context)
    return AoE4RPG_AI_OnBuildItemComplete(context)
end

function AoE4RPG_AI_ScanPlayers()
    local tracker = AoE4RPG.AI_TRACKER
    if #tracker.fallback_player_ids == 0 then
        local players = AoE4RPG_ENTITY_TRACKER_GetWorldPlayers
            and AoE4RPG_ENTITY_TRACKER_GetWorldPlayers()
            or {}
        if #players == 0 then
            for _, player in pairs(PLAYERS or {}) do
                table.insert(players, player)
            end
        end
        local seen_player_ids = {}
        for _, player in ipairs(players) do
            local player_handle = AoE4RPG_AI_ResolvePlayer(player)
            local player_id = AoE4RPG_AI_GetPlayerIdentifier(player_handle)
            if player_id and not seen_player_ids[player_id]
                and AoE4RPG_AI_IsComputerPlayer(player_handle) then
                seen_player_ids[player_id] = true
                table.insert(tracker.fallback_player_ids, player_id)
            end
        end
        table.sort(tracker.fallback_player_ids)
        tracker.fallback_player_cursor = 1
    end

    local player_count = #tracker.fallback_player_ids
    if player_count == 0 or not Player_GetEntities or not EGroup_CountSpawned
        or not AoE4RPG_ENTITY_TRACKER_ScanPlayerEntities then
        return false
    end

    -- IMPORTANT: Check only one AI player per interval so adding players cannot create
    -- a same-frame burst of complete roster scans.
    local player_index = math.max(1, math.min(
        player_count,
        math.floor(tonumber(tracker.fallback_player_cursor) or 1)
    ))
    local player_id = tracker.fallback_player_ids[player_index]
    tracker.fallback_player_cursor = (player_index % player_count) + 1
    local player_handle = AoE4RPG_AI_ResolvePlayer(player_id)
    if not AoE4RPG_AI_IsComputerPlayer(player_handle) then
        return false
    end

    -- IMPORTANT: Reuse the human tracker scan only when this AI roster grows.
    -- Build and spawn events remain the immediate path.
    local entities = Player_GetEntities(player_handle)
    if not entities then return false end
    local current_count = EGroup_CountSpawned(entities)
    AoE4RPG.ENTITY_TRACKER = AoE4RPG.ENTITY_TRACKER or {}
    local shared_tracker = AoE4RPG.ENTITY_TRACKER
    shared_tracker.last_owned_entity_count_by_player =
        shared_tracker.last_owned_entity_count_by_player or {}
    local previous_count = shared_tracker.last_owned_entity_count_by_player[player_id]
    if previous_count ~= nil and current_count <= previous_count then
        if current_count < previous_count then
            shared_tracker.last_owned_entity_count_by_player[player_id] = current_count
        end
        return false
    end
    local _, tracked_new_entity = AoE4RPG_ENTITY_TRACKER_ScanPlayerEntities(
        player_handle,
        entities
    )
    return tracked_new_entity
end

-- Issues one synchronized retreat order for a tracked AI squad.
local function AoE4RPG_AI_IssueRetreatOrder(squad, fallback_position)
    if not squad or not fallback_position then return false end
    if Squad_IsRetreating and Squad_IsRetreating(squad) then return true end
    if Cmd_Retreat and SGroup_CreateUnique and SGroup_Add then
        local retreat_group = SGroup_CreateUnique("AoE4RPG_AI_Retreat")
        if retreat_group then
            SGroup_Add(retreat_group, squad)
            Cmd_Retreat(retreat_group, fallback_position, false, false, true, false)
            if SGroup_Destroy then SGroup_Destroy(retreat_group) end
            return true
        end
    end
    -- Compatibility fallback for hosts without the synchronized retreat command.
    if AITactic_AICommandSquadMove then
        AITactic_AICommandSquadMove(squad, fallback_position, 8.0, false)
        return true
    end
    return false
end

-- Gives tracked AI heroes and elites a simple survival priority.
-- IMPORTANT: The synchronized rule walks sorted tracked EntityIDs and never uses local selection state.
function AoE4RPG_AI_MonitorHeroAndElitePreservation()
    if not Entity_GetHealth or not Entity_GetHealthMax
        or not Entity_GetSquad or not Player_GetStartingPosition then
        return
    end
    local tracker = AoE4RPG.AI_TRACKER
    AoE4RPG_AI_ForEachTrackedEntity(function(entity, entity_id, record)
        local maximum_health = Entity_GetHealthMax(entity) or 0
        local current_health = Entity_GetHealth(entity) or 0
        if maximum_health <= 0 or current_health <= 0 then
            tracker.retreating_entity_ids[entity_id] = nil
            return
        end

        local health_ratio = current_health / maximum_health
        local is_retreating = tracker.retreating_entity_ids[entity_id] == true
        if is_retreating and health_ratio >= tracker.preservation_release_ratio then
            tracker.retreating_entity_ids[entity_id] = nil
            return
        end
        if is_retreating or health_ratio > tracker.preservation_health_ratio then return end

        -- Garrisoning already protects the unit and must not be interrupted.
        if Entity_IsInHold and Entity_IsInHold(entity) then return end
        local player = record and AoE4RPG_AI_ResolvePlayer(record.player_id) or nil
        local squad = Entity_GetSquad(entity)
        if not player or not squad then return end
        if Squad_IsValid and not Squad_IsValid(squad) then return end
        local fallback_position = Player_GetStartingPosition(player)
        if not fallback_position then return end
        -- IMPORTANT: Enter native retreat once instead of replacing the AI order every interval.
        if AoE4RPG_AI_IssueRetreatOrder(squad, fallback_position) then
            tracker.retreating_entity_ids[entity_id] = true
        end
    end)
end

function AoE4RPG_AI_OnEntityKilled(context)
    local victim = context and (context.victim or context.entity) or nil
    local entity_id = victim and (victim.EntityID or victim) or nil
    local record = entity_id and AoE4RPG_AI_GetTrackedRecord(entity_id) or nil
    if not record then return false end
    if AoE4RPG.SETTINGS and AoE4RPG.SETTINGS.ai_keep_experience_on_death
        and AoE4RPG.UNIT_DATA and AoE4RPG.UNIT_DATA[entity_id] then
        local key = AoE4RPG_AI_GetRetiredUnitDataKey(
            record.player_id,
            record.class_name,
            record.role
        )
        if key then
            local queue = AoE4RPG.AI_TRACKER.retired_unit_data_by_player_class[key]
                or {}
            table.insert(queue, {
                entity_id = entity_id,
                unit_data = AoE4RPG.UNIT_DATA[entity_id],
            })
            AoE4RPG.AI_TRACKER.retired_unit_data_by_player_class[key] = queue
        end
    end
    AoE4RPG.AI_TRACKER.tracked_entity_ids[entity_id] = nil
    AoE4RPG.AI_TRACKER.tracked_entity_records[entity_id] = nil
    AoE4RPG.AI_TRACKER.retreating_entity_ids[entity_id] = nil
    AoE4RPG.AI_TRACKER.tracked_entity_ids_dirty = true
    local player_entities = AoE4RPG.AI_TRACKER.tracked_entities_by_player[record.player_id]
    if player_entities then player_entities[entity_id] = nil end
    if record.class_slot_key and AoE4RPG_CLASS_SLOTS_RemoveEntity then
        AoE4RPG_CLASS_SLOTS_RemoveEntity(
            record.class_slot_key,
            record.role == "heroes",
            record.player_id
        )
    end
    if AoE4RPG_CLASS_UnregisterEntity then AoE4RPG_CLASS_UnregisterEntity(entity_id) end
    return true
end

function AoE4RPG_AI_Initialize()
    local tracker = AoE4RPG.AI_TRACKER
    if tracker.initialized then return true end
    tracker.initialized = true
    if Rule_AddInterval then
        Rule_AddInterval(AoE4RPG_AI_ScanPlayers, tracker.fallback_scan_interval)
    end
    if Rule_AddInterval then
        Rule_AddInterval(
            AoE4RPG_AI_MonitorHeroAndElitePreservation,
            tracker.preservation_interval
        )
    end
    if Rule_AddGlobalEvent and GE_BuildItemComplete then
        Rule_AddGlobalEvent(AoE4RPG_AI_OnBuildItemComplete, GE_BuildItemComplete)
        tracker.build_event_registered = true
    end
    if Rule_AddGlobalEvent and GE_SpawnActionComplete then
        Rule_AddGlobalEvent(AoE4RPG_AI_OnSpawnActionComplete, GE_SpawnActionComplete)
        tracker.spawn_event_registered = true
    end
    if Rule_AddGlobalEvent and GE_EntityKilled then
        Rule_AddGlobalEvent(AoE4RPG_AI_OnEntityKilled, GE_EntityKilled)
    end
    return true
end

function AoE4RPG_AI_Shutdown()
    local tracker = AoE4RPG.AI_TRACKER
    if tracker.initialized and Rule_Remove then Rule_Remove(AoE4RPG_AI_ScanPlayers) end
    if tracker.initialized and Rule_Remove then
        Rule_Remove(AoE4RPG_AI_MonitorHeroAndElitePreservation)
    end
    if Rule_RemoveGlobalEvent and GE_EntityKilled then
        Rule_RemoveGlobalEvent(AoE4RPG_AI_OnEntityKilled)
    end
    if tracker.build_event_registered and Rule_RemoveGlobalEvent then
        Rule_RemoveGlobalEvent(AoE4RPG_AI_OnBuildItemComplete)
    end
    if tracker.spawn_event_registered and Rule_RemoveGlobalEvent then
        Rule_RemoveGlobalEvent(AoE4RPG_AI_OnSpawnActionComplete)
    end
    tracker.initialized = false
    tracker.tracked_entity_ids = {}
    tracker.tracked_entity_records = {}
    tracker.sorted_tracked_entity_ids = {}
    tracker.tracked_entity_ids_dirty = true
    tracker.fallback_player_ids = {}
    tracker.fallback_player_cursor = 1
    tracker.tracked_entities_by_player = {}
    tracker.retired_unit_data_by_player_class = {}
    tracker.retreating_entity_ids = {}
    tracker.build_event_registered = false
    tracker.spawn_event_registered = false
    return true
end
