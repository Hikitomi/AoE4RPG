-- =============================================================================
-- AoE4RPG Class System
-- =============================================================================
-- Mirrors the class structure used by the original RPG leveling package:
-- Agility = damage/attack speed focus
-- Vitality = durability/armor focus
-- Endurance = health/regeneration focus
-- =============================================================================

if not AoE4RPG then
    AoE4RPG = {}
end

