-- =============================================================================
-- AoE4RPG Blueprint & Civilization Registry
-- =============================================================================
-- This module is used to map each unit_type to a civilization and blueprint name.
-- The civilization is later used to apply unique stat tuning for that class.
-- =============================================================================

if not AoE4RPG then
    AoE4RPG = {}
end

