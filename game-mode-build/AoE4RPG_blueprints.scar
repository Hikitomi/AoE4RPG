-- This checks if an entity uses any blueprint written in the registry above.
-- It walks every civilization and level entry, so adding a new hero or elite to
-- AoE4RPG_ENTITY_TABLE automatically makes it eligible for RPG startup systems.
-- @param entity Entity whose current blueprint should be checked.
-- @return True when its blueprint appears anywhere in AoE4RPG_ENTITY_TABLE.
-- Adjust: only edit AoE4RPG_ENTITY_TABLE; this function should not need new cases.
function AoE4RPG_IsRegisteredEntityBlueprint(entity)
    if not entity or not Entity_GetBlueprint then
        return false
    end

    local blueprint = Entity_GetBlueprint(entity)
    local blueprint_name = blueprint
    if blueprint and BP_GetName then
        local resolved_name = BP_GetName(blueprint)
        if type(resolved_name) == "string" and resolved_name ~= "" then
            blueprint_name = resolved_name
        end
    end
    if type(blueprint_name) ~= "string" or blueprint_name == "" then
        return false
    end

    -- The engine can return either a short name or a full attrib path.
    local function normalize_name(value)
        if type(value) ~= "string" or value == "" then
            return nil
        end
        local normalized = string.lower(string.gsub(value, "/", "\\"))
        normalized = string.match(normalized, "([^\\]+)$") or normalized
        return string.gsub(normalized, "%.xml$", "")
    end

    local wanted_name = normalize_name(blueprint_name)
    local function contains_blueprint(value)
        if type(value) == "string" then
            return normalize_name(value) == wanted_name
        end
        if type(value) ~= "table" then
            return false
        end
        if value.blueprint and contains_blueprint(value.blueprint) then
            return true
        end
        for key, child in pairs(value) do
            if key ~= "blueprint" and contains_blueprint(child) then
                return true
            end
        end
        return false
    end

    return contains_blueprint(AoE4RPG_ENTITY_TABLE)
end

