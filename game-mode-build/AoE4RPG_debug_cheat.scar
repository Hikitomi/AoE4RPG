-- =============================================================================
-- AoE4RPG Debug Cheat
-- =============================================================================
-- Native chat-cheat integration. With the game's `dev` command-line option
-- enabled, typing IDDQD grants the selected eligible hero/elite enough XP for
-- exactly one normal RPG level-up.
-- =============================================================================

-- Applies the debug cheat to the first entity in the single selected squad.
-- @param player_id Player that issued the native cheat command.
-- @param data Additional chat command tokens; unused by IDDQD.
-- @return Nothing. The normal RPG level-up path handles validation and growth.
-- Adjust: change the XP assignment near the bottom if the cheat should grant more than one level.
function AoE4RPG_DebugCheat_IDDQD(player_id, data)
    if not Misc_GetSelectedSquads or not SGroup_CreateIfNotFound
        or not SGroup_Clear or not SGroup_Count or not SGroup_ForEach then
        return
    end

    local selected = SGroup_CreateIfNotFound("AoE4RPG_IDDQD_Selected")
    SGroup_Clear(selected)
    Misc_GetSelectedSquads(selected, false)
    if SGroup_Count(selected) ~= 1 then
        return
    end

    -- This callback checks the first unit in the selected squad and gives it one level of XP.
    -- Adjust: change the unit_data.exp assignment below to grant a different amount.
    local function grant_required_exp(group_id, index, squad_id)
        local entity = Squad_GetFirstEntity and Squad_GetFirstEntity(squad_id)
        if not entity then
            return
        end

        local entity_id
        if type(entity) == "number" then
            entity_id = entity
            entity = Entity_FromID and Entity_FromID(entity) or nil
        else
            entity_id = entity.EntityID or (Entity_GetID and Entity_GetID(entity))
        end
        if not entity or not entity_id or not AoE4RPG_GetUnitData then
            return
        end

        local unit_data = AoE4RPG_GetUnitData(entity_id)
        local is_hero, is_elite = AoE4RPG_AssignEntityRole(entity, unit_data)
        if not is_hero and not is_elite then
            return
        end

        local max_level = AoE4RPG_GetEffectiveLevelLimit(entity)
        if (unit_data.level or 0) >= max_level then
            return
        end

        -- Feed the exact threshold into the ordinary progression function so
        -- class growth, bracket rewards, modifiers, and UI refresh all remain
        -- consistent with gameplay-earned experience.
        unit_data.exp = AoE4RPG_ExperienceRequired(unit_data.level or 0)
        AoE4RPG_CheckAndApplyLevelUp(entity, unit_data.owner or player_id, unit_data, true)
    end

    SGroup_ForEach(selected, grant_required_exp)
end

-- Register IDDQD in the native chat-cheat dispatch table. SCAR initialization
-- callbacks are not assumed to run in import order, so initialize cheat.scar's
-- dispatcher here when its table has not been created yet. Cheat_Init is
-- idempotent: its own later Scar_AddInit callback will see the existing table
-- and leave this registration intact.
-- Adjust: change "IDDQD" here if a different debug chat code is wanted.
function AoE4RPG_DebugCheat_Init()
    if not cheats and Cheat_Init then
        Cheat_Init()
    end

    if not cheats then
        return
    end

    cheats["IDDQD"] = AoE4RPG_DebugCheat_IDDQD
end

if Scar_AddInit then
    Scar_AddInit(AoE4RPG_DebugCheat_Init)
end
