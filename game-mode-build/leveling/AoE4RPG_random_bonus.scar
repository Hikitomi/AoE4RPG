-- ================= AoE4RPG Random Bonus ===============
-- AoE4RPG Random Bonus - Bracket Bonus System creates, validates, and applies RPG bracket bonus choices.
-- Author: Hikitomi
-- Referenced: AoE4RPG_core.scar, AoE4RPG_classes.scar, and AoE4RPG_ability_list_compact.scar.
-- ================= AoE4RPG Random Bonus ===============

if not AoE4RPG then
    AoE4RPG = {}
end

AoE4RPG.BONUS = {
    initialized = false,
    selection_in_progress = false,
    network_event_name = "AoE4RPG_SelectBracketBonus",
    choices_per_offer = 3,
    -- Each player receives exactly one shared elite choice.
    shared_elite_bonus_by_player_id = {},
    -- Non-weapon modifiers are permanent player modifiers filtered to one entity blueprint.
    applied_blueprint_bonus_keys_by_player_id = {},
}

-- IMPORTANT: Values are deliberately centralized so balance changes do not require edits to the offer generation, UI, or network-validation functions.
AoE4RPG.BONUS_DEFINITIONS = {
    movement_speed = {
        display_name = "Movement Speed",
        description = "+5% maximum movement speed",
        derived_stat = "movement_speed_modifier",
        amount = 0.05,
    },
    weapon_range = {
        display_name = "Weapon Range",
        description = "+10% weapon range (Ranged only)",
        derived_stat = "weapon_range_modifier",
        amount = 0.10,
        required_type = "ranged",
        attack_related = true,
        weapon_related = true,
    },
    attack_speed = {
        display_name = "Attack Speed",
        description = "+10% attack speed",
        derived_stat = "attack_speed_modifier",
        amount = 0.10,
        attack_related = true,
        weapon_related = true,
    },
    critical_chance = {
        display_name = "Critical Chance",
        description = "+5% critical-hit chance",
        derived_stat = "critical_hit_chance",
        amount = 0.05,
        attack_related = true,
    },
    regeneration = {
        display_name = "Regeneration",
        description = "+2.0 health regenerated per second",
        derived_stat = "health_regeneration_bonus",
        amount = 2.0,
    },
    teardown_speed = {
        display_name = "Teardown Speed",
        description = "+10% weapon teardown speed (Siege only)",
        derived_stat = "teardown_speed_modifier",
        amount = 0.10,
        required_type = "siege",
        attack_related = true,
        weapon_related = true,
    },
    health_per_attack = {
        display_name = "Health Per Attack",
        description = "+2.5% maximum health per successful attack (Melee only)",
        derived_stat = "health_per_attack_ratio",
        amount = 0.025,
        required_type = "melee",
        attack_related = true,
    },
}

-- IMPORTANT: Fixed ordering is required because random selection must begin with the same candidate list on every machine.
-- IMPORTANT: Never generate this list with pairs().
AoE4RPG.BONUS_DEFINITION_ORDER = {
    "movement_speed",
    "weapon_range",
    "attack_speed",
    "critical_chance",
    "regeneration",
    "teardown_speed",
    "health_per_attack",
}

AoE4RPG.BONUS_ATTRIBUTE_DISPLAY_NAMES = {
    agility = "Keen",
    endurance = "Hearty",
    vitality = "Stout",
}

-- Returns a stable numeric identifier for either a numeric PlayerID or a player object.
-- This is used for network ownership checks and local-only UI display.
function AoE4RPG_BONUS_GetPlayerIdentifier(player)
    if AoE4RPG_RUNTIME_GetPlayerIdentifier then
        return AoE4RPG_RUNTIME_GetPlayerIdentifier(player)
    end
    if type(player) == "number" then
        return player
    end
    if not player then
        return nil
    end
    if player.PlayerID then
        return player.PlayerID
    end
    if player.id then
        -- IMPORTANT: Core player entries wrap the engine PlayerID in `.id`; normalize it recursively so comparisons with Game_GetLocalPlayer never compare a wrapper table against its numeric identifier.
        return AoE4RPG_BONUS_GetPlayerIdentifier(player.id)
    end
    if Player_GetID then
        return Player_GetID(player)
    end
    return nil
end

-- Checks the optional attack-capability and ranged, melee, or siege restrictions for one definition.
-- IMPORTANT: Jeanne's current native blueprint defines her melee/ranged path, while all other units retain the normal engine entity-type check.
function AoE4RPG_BONUS_IsDefinitionEligible(entity, definition)
    if not entity or not definition then
        return false
    end
    if not definition.required_type then
        if definition.attack_related then
            return AoE4RPG_EntityMatchesCombatType(entity, "melee")
                or AoE4RPG_EntityMatchesCombatType(entity, "ranged")
        end
        return true
    end
    if definition.attack_related
        and not (AoE4RPG_EntityMatchesCombatType(entity, "melee")
            or AoE4RPG_EntityMatchesCombatType(entity, "ranged")) then
        return false
    end
    if definition.required_type == "melee" or definition.required_type == "ranged" then
        return AoE4RPG_EntityMatchesCombatType(entity, definition.required_type)
    end
    return Entity_IsOfType and Entity_IsOfType(entity, definition.required_type) or false
end

-- Returns true when a value occurs in an ordered availability list.
function AoE4RPG_BONUS_IsListedValue(list, value)
    if not list or value == nil then
        return false
    end
    for _, listed_value in ipairs(list) do
        if listed_value == value then
            return true
        end
    end
    return false
end

-- Resolves the actual ability blueprint used by a random-bonus skill.
-- IMPORTANT: Custom AoE4RPG abilities live in the tuning namespace, while native abilities use their unqualified engine name.
function AoE4RPG_BONUS_GetSkillAbilityBlueprint(entry, entity)
    if not entry then
        return nil
    end
    local candidates = {}
    if entry.ability_name and AoE4RPG_GetTuningAbilityBlueprint then
        local tuning_success, tuning_blueprint = pcall(
            AoE4RPG_GetTuningAbilityBlueprint,
            entry.ability_name
        )
        if tuning_success and tuning_blueprint then
            table.insert(candidates, tuning_blueprint)
        end
    end
    if entry.ability_name and BP_GetAbilityBlueprint then
        local native_success, native_blueprint = pcall(
            BP_GetAbilityBlueprint,
            entry.ability_name
        )
        if native_success and native_blueprint then
            table.insert(candidates, native_blueprint)
        end
    end
    if entry.ability_pbgid and BP_GetAbilityBlueprintByPbgID then
        local pbgid_success, pbgid_blueprint = pcall(
            BP_GetAbilityBlueprintByPbgID,
            entry.ability_pbgid
        )
        if pbgid_success and pbgid_blueprint then
            table.insert(candidates, pbgid_blueprint)
        end
    end
    -- IMPORTANT: A native ability may already be attached under a different namespace from the tuning copy.
    -- Prefer the candidate the selected entity actually owns when the caller supplies an entity.
    if entity and Entity_HasAbility then
        for _, candidate in ipairs(candidates) do
            local has_ability_success, has_ability = pcall(
                Entity_HasAbility,
                entity,
                candidate
            )
            if has_ability_success and has_ability then
                return candidate
            end
        end
    end
    return candidates[1]
end

-- IMPORTANT: An offer is usable only when its native ability blueprint can be resolved and the engine has the API required to attach that ability to the hero.
-- IMPORTANT: This check is performed before generating an offer, so invalid skill cards do not occupy one of the three selectable choices.
function AoE4RPG_BONUS_IsSkillUsable(entity, entry)
    if not entity or not entry or not Entity_AddAbility then
        return false
    end
    return AoE4RPG_BONUS_GetSkillAbilityBlueprint(entry, entity) ~= nil
end

-- Checks an ability-list row against the selected hero/elite class and civilization.
function AoE4RPG_BONUS_IsAbilityEligible(entity, entry)
    if not entity or not entry then
        return false
    end
    local unit_data = entity.EntityID and AoE4RPG_GetUnitData
        and AoE4RPG_GetUnitData(entity.EntityID) or nil
    local class_name = unit_data and unit_data.class_name
    if not class_name and AoE4RPG_CLASS_GetEntityProfile then
        local profile = AoE4RPG_CLASS_GetEntityProfile(entity)
        class_name = profile and profile.class_name
    end
    local civilization = unit_data and unit_data.civilization
        or (AoE4RPG.ENTITY_TRACKER and AoE4RPG.ENTITY_TRACKER.civilization)
    local availability = entry.availability or "all"
    local availability_classes = entry.availability_classes or entry.classes
    if availability == "exclude"
        and AoE4RPG_BONUS_IsListedValue(availability_classes, class_name) then
        return false
    elseif availability == "only"
        and not AoE4RPG_BONUS_IsListedValue(availability_classes, class_name) then
        return false
    elseif availability ~= "all" and availability ~= "exclude" and availability ~= "only" then
        return false
    end

    -- Keep the older per-row restrictions valid alongside the new mode.
    if entry.class_name and entry.class_name ~= class_name then
        return false
    end
    if entry.civilization and entry.civilization ~= civilization then
        return false
    end
    if entry.civilizations
        and not AoE4RPG_BONUS_IsListedValue(entry.civilizations, civilization) then
        return false
    end
    return true
end

-- Builds a deterministic candidate pool in BONUS_DEFINITION_ORDER order.
function AoE4RPG_BONUS_GetEligibleDefinitionKeys(entity, unrestricted_only)
    local eligible_keys = {}
    for _, definition_key in ipairs(AoE4RPG.BONUS_DEFINITION_ORDER) do
        local definition = AoE4RPG.BONUS_DEFINITIONS[definition_key]
        if (not unrestricted_only or not definition.required_type)
            and AoE4RPG_BONUS_IsDefinitionEligible(entity, definition) then
            table.insert(eligible_keys, definition_key)
        end
    end
    return eligible_keys
end

-- Chooses three unique options.
-- IMPORTANT: World_GetRand is preferred because the offer is created in synchronized simulation code; the arithmetic fallback remains deterministic when that helper is unavailable in a host mode.
function AoE4RPG_BONUS_GenerateChoices(entity, bracket_index, unrestricted_only)
    local candidate_keys = AoE4RPG_BONUS_GetEligibleDefinitionKeys(entity, unrestricted_only)
    local choices = {}
    local entity_id = entity and entity.EntityID or 0

    -- Choose one of the above.
    -- Can occur again.
    if #candidate_keys > 0 then
        local candidate_index = World_GetRand and World_GetRand(1, #candidate_keys)
            or ((entity_id + (bracket_index or 0)) % #candidate_keys) + 1
        local selected_key = candidate_keys[candidate_index]
        local selected_definition = AoE4RPG.BONUS_DEFINITIONS[selected_key]
        local bracket_multiplier = math.max(1, bracket_index or 1)
        choices[1] = {
            kind = "bonus",
            key = selected_key,
            amount = (selected_definition.amount or 0) * bracket_multiplier,
            bracket_multiplier = bracket_multiplier,
        }
    end

    -- Primary attribute choice.
    -- The class definition determines which attribute is used.
    local unit_data = entity and AoE4RPG_GetUnitData(entity.EntityID) or nil
    local class_name = unit_data and unit_data.class_name
        or (entity and AoE4RPG_CLASS_GetEntityProfile and AoE4RPG_CLASS_GetEntityProfile(entity)
            and AoE4RPG_CLASS_GetEntityProfile(entity).class_name)
    local class_definition = class_name and AoE4RPG.CLASS_DEFINITIONS[class_name] or nil
    local attribute_name = class_definition and class_definition.stat_type or "agility"
    choices[2] = {
        kind = "attribute",
        key = attribute_name,
        amount = (bracket_index or 1) * 2 + 3,
    }

    -- Skill choice.
    -- List is from the Ability Listing Table.
    -- Repeated selections of the same skill increase its level by one.
    -- Some class/civilization blueprints may only roll passive skills.
    local all_skill_entries = AoE4RPG.ABILITY_LIST or {}
    local skill_entries = {}
    local civilization = unit_data and unit_data.civilization
        or (AoE4RPG.ENTITY_TRACKER and AoE4RPG.ENTITY_TRACKER.civilization)
    local passive_only = AoE4RPG_GetAbilitySkillRestriction
        and AoE4RPG_GetAbilitySkillRestriction(civilization, class_name) == "passive_only"
    for _, candidate in ipairs(all_skill_entries) do
        local skill_type = candidate.skill_type or "active"
        if skill_type ~= "unique"
            and AoE4RPG_BONUS_IsAbilityEligible(entity, candidate)
            and AoE4RPG_BONUS_IsSkillUsable(entity, candidate)
            and (not passive_only or skill_type == "passive") then
            table.insert(skill_entries, candidate)
        end
    end
    local skill_entry = skill_entries[1]
    if #skill_entries > 1 then
        local skill_index = World_GetRand and World_GetRand(1, #skill_entries)
            or ((entity_id + (bracket_index or 0)) % #skill_entries) + 1
        skill_entry = skill_entries[skill_index]
    end
    if skill_entry then
        choices[3] = {
            kind = "skill",
            key = skill_entry.ability_name or skill_entry.ability_pbgid or skill_entry.ability,
        }
    end

    return choices
end

function AoE4RPG_BONUS_GetChoiceDisplay(choice, unit_data)
    if not choice then return nil end
    if choice.kind == "bonus" then
        local definition = AoE4RPG.BONUS_DEFINITIONS[choice.key]
        if not definition then return nil end
        local amount = choice.amount or definition.amount
        return definition.display_name,
            definition.description .. " (x" .. tostring(choice.bracket_multiplier or 1)
            .. ", amount " .. tostring(amount) .. ")"
    elseif choice.kind == "attribute" then
        local name = AoE4RPG.BONUS_ATTRIBUTE_DISPLAY_NAMES[choice.key]
            or string.upper(string.sub(choice.key or "attribute", 1, 1))
                .. string.sub(choice.key or "attribute", 2)
        return name .. " Attribute", "+" .. tostring(choice.amount) .. " " .. name
    elseif choice.kind == "skill" then
        local level = unit_data and unit_data.skill_levels and unit_data.skill_levels[choice.key] or 0
        return "Skill: " .. tostring(choice.key), "Learn or upgrade this skill (level " .. tostring(level + 1) .. ")"
    end
    return nil
end

function AoE4RPG_BONUS_ApplyAttributeChoice(entity, unit_data, choice)
    if not choice or not choice.key or not unit_data then return false end
    unit_data.attribute_bonuses = unit_data.attribute_bonuses or {}
    unit_data.attribute_bonuses[choice.key] = (unit_data.attribute_bonuses[choice.key] or 0)
        + (choice.amount or 0)
    if AoE4RPG_RecalculateAttributeTotals then
        AoE4RPG_RecalculateAttributeTotals(unit_data)
    end
    -- Attribute choices change the live totals, not only the displayed record.
    -- IMPORTANT: The reapply path preserves the selected choice and avoids modifier stacking.
    if entity and AoE4RPG_CLASS_ReapplyEntityBonuses then
        AoE4RPG_CLASS_ReapplyEntityBonuses(entity, unit_data)
    elseif AoE4RPG_TranslateAttributesToStats then
        AoE4RPG_TranslateAttributesToStats(unit_data)
    end
    if AoE4RPG_MarkUnitDataChanged then
        AoE4RPG_MarkUnitDataChanged(unit_data)
    end
    return true
end

function AoE4RPG_BONUS_ApplySkillChoice(entity, unit_data, choice, reapply_only)
    if not entity or not unit_data or not choice or not choice.key then return false end
    unit_data.skill_levels = unit_data.skill_levels or {}
    local skill_level = unit_data.skill_levels[choice.key] or 0
    if not reapply_only then
        skill_level = skill_level + 1
    end
    local entry = nil
    for _, candidate in ipairs(AoE4RPG.ABILITY_LIST or {}) do
        if candidate.ability_name == choice.key
            or tostring(candidate.ability_pbgid or "") == tostring(choice.key)
            or candidate.ability == choice.key then
            entry = candidate
            break
        end
    end
    if not entry then
        return false
    end
    if not reapply_only and not AoE4RPG_BONUS_IsAbilityEligible(entity, entry) then
        return false
    end
    if entry.skill_type == "unique" then
        return false
    end
    local ability = AoE4RPG_BONUS_GetSkillAbilityBlueprint(entry, entity)
    if not ability or not Entity_AddAbility then
        return false
    end
    -- IMPORTANT: Keep native ability attachment state per EntityID.
    -- IMPORTANT: A level reapply on the same entity must not duplicate the ability, while a respawned EntityID must receive every previously selected skill again.
    unit_data.skill_ability_entity_ids = unit_data.skill_ability_entity_ids or {}
    local applied_entity_ids = unit_data.skill_ability_entity_ids[choice.key]
    if not applied_entity_ids then
        applied_entity_ids = {}
        unit_data.skill_ability_entity_ids[choice.key] = applied_entity_ids
    end
    if skill_level > 0 and ability and Entity_AddAbility
        and not applied_entity_ids[entity.EntityID] then
        -- IMPORTANT: A tier conversion can keep the EntityID while replacing its native blueprint.
        -- IMPORTANT: Check the current entity first so the skill is restored exactly once on the new tier, while avoiding a duplicate when the native ability stayed.
        local already_attached = false
        if Entity_HasAbility then
            local has_ability_success, has_ability = pcall(
                Entity_HasAbility,
                entity,
                ability
            )
            already_attached = has_ability_success and has_ability == true
        end
        if not already_attached then
            Entity_AddAbility(entity, ability)
        end
        applied_entity_ids[entity.EntityID] = true
    end
    unit_data.skill_levels[choice.key] = skill_level
    unit_data.skill_effect_levels = unit_data.skill_effect_levels or {}
    unit_data.skill_effect_levels[choice.key] = skill_level

    -- IMPORTANT: Passive reactive effects do not depend on the native ability being executed.
    -- IMPORTANT: Register them when the skill is granted so the replacement EntityID receives the same effect during skill reapplication.
    if entry.effect_name == "damage_on_attacked"
        and AoE4RPG_EFFECT_LIST_Apply then
        local effect_data = {}
        for key, value in pairs(entry) do effect_data[key] = value end
        effect_data.effect_level = skill_level
        AoE4RPG_EFFECT_LIST_Apply(
            entry.effect_name,
            entity,
            entity,
            effect_data
        )
    end

    -- Skill positions are assigned only when a distinct random-bonus skill is first selected.
    -- IMPORTANT: Reapplying a skill or respawning its entity preserves the same slot, so the safer UI order never depends on ability XML order.
    unit_data.skill_slots = unit_data.skill_slots or {}
    unit_data.skill_slot_by_key = unit_data.skill_slot_by_key or {}
    if not unit_data.skill_slot_by_key[choice.key] then
        local next_slot = 1
        while unit_data.skill_slots[next_slot] do
            next_slot = next_slot + 1
        end
        if next_slot <= 5 then
            unit_data.skill_slots[next_slot] = choice.key
            unit_data.skill_slot_by_key[choice.key] = next_slot
        end
    end
    unit_data.ui_revision = (unit_data.ui_revision or 0) + 1
    return true
end

-- Returns true if a queued offer already exists for the supplied bracket.
function AoE4RPG_BONUS_HasQueuedOffer(unit_data, bracket_index)
    for _, offer in ipairs(unit_data.pending_bracket_bonus_offers or {}) do
        if offer.bracket_index == bracket_index then
            return true
        end
    end
    return false
end

-- Queues one three-choice offer when an entity first enters a new bracket.
function AoE4RPG_BONUS_CreateOffer(entity, owner, bracket_index)
    local entity_id = AoE4RPG_RUNTIME_GetEntityIdentifier
        and AoE4RPG_RUNTIME_GetEntityIdentifier(entity)
        or entity and entity.EntityID
    if not entity or not entity_id or not bracket_index then
        return false
    end

    local unit_data = AoE4RPG_GetUnitData(entity_id)
    local tracked_record = AoE4RPG.ENTITY_TRACKER
        and AoE4RPG.ENTITY_TRACKER.tracked_entity_records[entity_id]
        or nil
    if not tracked_record then
        return false
    end
    local is_elite = tracked_record.role == "elites"
    -- IMPORTANT: Elites use one player-wide offer created by EnsureCurrentBracketOffer; level changes must never create personal elite bracket offers.
    if is_elite then
        return false
    end
    local available_brackets = AoE4RPG_GetLevelBracketsForUnit
        and AoE4RPG_GetLevelBracketsForUnit(entity, unit_data)
        or AoE4RPG.UPGRADE_BRACKETS
    local is_extended_bracket = AoE4RPG.UNCAPPED_HERO_ELITE_LEVELS
        and bracket_index > #available_brackets
    if bracket_index < 1 or (bracket_index > #available_brackets and not is_extended_bracket) then
        return false
    end
    unit_data.chosen_bracket_bonuses = unit_data.chosen_bracket_bonuses or {}
    unit_data.pending_bracket_bonus_offers = unit_data.pending_bracket_bonus_offers or {}
    if unit_data.chosen_bracket_bonuses[bracket_index]
        or AoE4RPG_BONUS_HasQueuedOffer(unit_data, bracket_index) then
        return false
    end

    local choices = AoE4RPG_BONUS_GenerateChoices(entity, bracket_index)
    if #choices ~= AoE4RPG.BONUS.choices_per_offer then
        return false
    end

    table.insert(unit_data.pending_bracket_bonus_offers, {
        bracket_index = bracket_index,
        choices = choices,
    })
    if AoE4RPG_AI_AutoSelectOffer then
        AoE4RPG_AI_AutoSelectOffer(entity, owner, bracket_index)
    end
    if AoE4RPG_BONUS_INDICATOR_RefreshEntity then
        AoE4RPG_BONUS_INDICATOR_RefreshEntity(entity_id)
    end
    if AoE4RPG_MarkUnitDataChanged then
        AoE4RPG_MarkUnitDataChanged(unit_data)
    end
    return true
end

-- Reapplies bracket scaling for XML/Squad-owned unique skills.
-- IMPORTANT: never adds or removes the native ability from the entity.
function AoE4RPG_BONUS_ReapplyUniqueSkillScaling(entity, unit_data)
    if not entity or not unit_data then return false end
    local civilization = unit_data.civilization
    local class_name = unit_data.class_name
    for _, entry in ipairs(AoE4RPG.ABILITY_LIST or {}) do
        if entry.skill_type == "unique"
            and (not entry.class_name or entry.class_name == class_name)
            and (not entry.civilization or entry.civilization == civilization) then
            local allowed_civilization = true
            if entry.civilizations then
                allowed_civilization = false
                for _, candidate_civilization in ipairs(entry.civilizations) do
                    if candidate_civilization == civilization then
                        allowed_civilization = true
                        break
                    end
                end
            end
            if allowed_civilization then
                local ability = AoE4RPG_BONUS_GetSkillAbilityBlueprint(entry, entity)
                if ability then
                    if AoE4RPG_ABILITY_LIST_GetEffectData
                        and AoE4RPG_EFFECT_LIST_ApplyUniqueSkillCooldown then
                        local data = AoE4RPG_ABILITY_LIST_GetEffectData(ability, entity)
                        AoE4RPG_EFFECT_LIST_ApplyUniqueSkillCooldown(entity, ability, data)
                    end
                end
            end
        end
    end
    return true
end

-- Creates the current bracket's offer for one eligible RPG entity.
-- This helper is safe to call repeatedly because CreateOffer rejects chosen or queued bands.
function AoE4RPG_BONUS_EnsureCurrentBracketOffer(entity, skip_native_experience_synchronization)
    local entity_id = AoE4RPG_RUNTIME_GetEntityIdentifier
        and AoE4RPG_RUNTIME_GetEntityIdentifier(entity)
        or entity and entity.EntityID
    if not entity or not entity_id then
        return false
    end

    if AoE4RPG_GetGrowthTargetEntity then
        local offer_target = AoE4RPG_GetGrowthTargetEntity(entity)
        if offer_target and offer_target ~= entity then
            entity = offer_target
            entity_id = AoE4RPG_RUNTIME_GetEntityIdentifier
                and AoE4RPG_RUNTIME_GetEntityIdentifier(entity)
                or entity and entity.EntityID
        end
    end

    local unit_data = entity_id and AoE4RPG_GetUnitData(entity_id) or nil
    if not unit_data then
        return false
    end
    local owner = AoE4RPG_ENTITY_TRACKER_GetSafePlayerOwner
        and AoE4RPG_ENTITY_TRACKER_GetSafePlayerOwner(entity)
        or nil
    if not skip_native_experience_synchronization and AoE4RPG_SynchronizeNativeExperience then
        AoE4RPG_SynchronizeNativeExperience(entity, owner, unit_data)
    end
    local tracked_record = AoE4RPG.ENTITY_TRACKER
        and AoE4RPG.ENTITY_TRACKER.tracked_entity_records[entity_id]
        or nil
    if not tracked_record and AoE4RPG_AI_GetTrackedRecord then
        tracked_record = AoE4RPG_AI_GetTrackedRecord(entity_id)
    end
    if not tracked_record then
        return false
    end
    local is_hero = tracked_record.role == "heroes"
    local is_elite = tracked_record.role == "elites"

    -- Bracket one is earned by reaching level one.
    -- IMPORTANT: Do not create an offer for a newly spawned level-zero hero or elite.
    if (unit_data.level or 0) <= 0 then
        return false
    end

    -- IMPORTANT: A new respawn EntityID cannot retain modifiers applied to the dead entity.
    -- IMPORTANT: A blueprint conversion may keep the EntityID, so remove our known modifier IDs before rebuilding them to avoid duplicate stacking on Jeanne changes.
    local blueprint = Entity_GetBlueprint and Entity_GetBlueprint(entity) or nil
    local blueprint_name = blueprint
    if blueprint and BP_GetName then
        local resolved_name = BP_GetName(blueprint)
        if type(resolved_name) == "string" and resolved_name ~= "" then
            blueprint_name = resolved_name
        end
    end
    blueprint_name = AoE4RPG_NormalizeBlueprintName
        and AoE4RPG_NormalizeBlueprintName(blueprint_name)
        or tostring(blueprint_name or "")
    local applied_entity_id = unit_data.random_bonus_applied_entity_id
    local applied_blueprint_name = unit_data.random_bonus_applied_blueprint_name
    local entity_changed = applied_entity_id and applied_entity_id ~= entity_id
    local blueprint_changed = applied_blueprint_name and applied_blueprint_name ~= blueprint_name
    local force_reapply = unit_data.random_bonus_force_reapply == true
    if (entity_changed or blueprint_changed) and AoE4RPG_CLASS_ApplyCachedProfileToEntity then
        local class_profile = AoE4RPG_CLASS_GetEntityProfile
            and AoE4RPG_CLASS_GetEntityProfile(entity)
            or nil
        if class_profile then
            AoE4RPG_CLASS_ApplyCachedProfileToEntity(entity, unit_data, class_profile)
        end
    end
    if force_reapply or entity_changed or blueprint_changed then
        -- IMPORTANT: Force reapply is used after level growth on the same EntityID.
        -- IMPORTANT: A replacement EntityID owns a different native modifier lifetime, so its stale handles are discarded without removing them here.
        if (force_reapply or blueprint_changed) and not entity_changed and Modifier_Remove then
            for _, modifier_id in ipairs(unit_data.random_bonus_modifier_ids or {}) do
                if modifier_id then
                    Modifier_Remove(modifier_id)
                end
            end
        end
        unit_data.random_bonus_modifier_ids = {}
        local maximum_bracket = #(AoE4RPG_GetLevelBracketsForUnit(entity, unit_data) or {})
        if AoE4RPG.UNCAPPED_HERO_ELITE_LEVELS and AoE4RPG_GetLevelBracketStep then
            maximum_bracket = math.max(maximum_bracket, AoE4RPG_GetLevelBracketStep(unit_data.level, entity, unit_data))
        end
        for bracket_index = 1, maximum_bracket do
            local chosen_choice = unit_data.chosen_bracket_bonuses
                and unit_data.chosen_bracket_bonuses[bracket_index]
                or nil
            if chosen_choice and chosen_choice.kind == "bonus" then
                local bonus_instance_key = "hero:"
                    .. tostring(unit_data.class_name or "unclassified")
                    .. ":bracket:"
                    .. tostring(bracket_index)
                AoE4RPG_BONUS_ApplyDefinition(
                    entity,
                    unit_data,
                    chosen_choice.key,
                    true,
                    bonus_instance_key,
                    chosen_choice.amount
                )
            elseif chosen_choice and chosen_choice.kind == "skill" then
                AoE4RPG_BONUS_ApplySkillChoice(entity, unit_data, chosen_choice, true)
            end
        end
        if unit_data.shared_elite_bonus_key then
            AoE4RPG_BONUS_ApplyDefinition(
                entity,
                unit_data,
                unit_data.shared_elite_bonus_key,
                true,
                "elite:shared",
                unit_data.shared_elite_choice and unit_data.shared_elite_choice.amount
            )
        elseif unit_data.shared_elite_choice and unit_data.shared_elite_choice.kind == "skill" then
            AoE4RPG_BONUS_ApplySkillChoice(entity, unit_data, unit_data.shared_elite_choice, true)
        end
    end
    unit_data.random_bonus_force_reapply = false
    unit_data.random_bonus_applied_entity_id = entity_id
    unit_data.random_bonus_applied_blueprint_name = blueprint_name
    if AoE4RPG_EnableCriticalHits then
        AoE4RPG_EnableCriticalHits(entity)
    end

    if is_elite then
        local player_id = AoE4RPG_BONUS_GetPlayerIdentifier(owner)
        if not player_id then
            return false
        end
        local shared_state = AoE4RPG.BONUS.shared_elite_bonus_by_player_id[player_id]
        if not shared_state then
            shared_state = {
                bracket_index = 1,
                choices = AoE4RPG_BONUS_GenerateChoices(entity, 1, true),
                chosen_choice = nil,
            }
            if #shared_state.choices ~= AoE4RPG.BONUS.choices_per_offer then
                return false
            end
            AoE4RPG.BONUS.shared_elite_bonus_by_player_id[player_id] = shared_state
        end
        if AoE4RPG_AI_AutoSelectOffer then
            AoE4RPG_AI_AutoSelectOffer(entity, owner, 1)
        end
        if shared_state.chosen_choice then
            local choice = shared_state.chosen_choice
            local applied = choice.kind == "bonus"
                and AoE4RPG_BONUS_ApplyDefinition(entity, unit_data, choice.key, false, "elite:shared", choice.amount)
                or choice.kind == "attribute"
                    and AoE4RPG_BONUS_ApplyAttributeChoice(entity, unit_data, choice)
                or choice.kind == "skill"
                    and AoE4RPG_BONUS_ApplySkillChoice(entity, unit_data, choice)
            if applied then
                if choice.kind == "bonus" then
                    unit_data.shared_elite_bonus_key = choice.key
                end
                unit_data.shared_elite_choice = choice
            end
        end
        if AoE4RPG_BONUS_INDICATOR_RefreshEntity then
            AoE4RPG_BONUS_INDICATOR_RefreshEntity(entity.EntityID)
        end
        return true
    end

    local bracket_index = AoE4RPG_GetLevelBracketStep(unit_data.level or 0, entity, unit_data)
    local created = AoE4RPG_BONUS_CreateOffer(entity, owner, bracket_index)
    if not created and AoE4RPG_BONUS_INDICATOR_RefreshEntity then
        AoE4RPG_BONUS_INDICATOR_RefreshEntity(entity.EntityID)
    end
    return created
end

-- Retained as a compatibility entry point for hosts that call it at match start.
-- Offers are now created only after the first successful level-up.
function AoE4RPG_BONUS_CreateInitialOffersForRegisteredUnits()
    if not AoE4RPG_ENTITY_TRACKER_ForEachTrackedEntity then
        return
    end
    AoE4RPG_ENTITY_TRACKER_ForEachTrackedEntity(function(entity)
        AoE4RPG_BONUS_EnsureCurrentBracketOffer(entity)
    end)
end

-- Returns the single offer currently allowed to appear for an entity.
function AoE4RPG_BONUS_GetActiveOffer(entity_id)
    local unit_data = AoE4RPG.UNIT_DATA and AoE4RPG.UNIT_DATA[entity_id] or nil
    if not unit_data then
        return nil
    end
    local entity = Entity_FromID and Entity_FromID(entity_id) or nil
    local tracked_record = AoE4RPG.ENTITY_TRACKER
        and AoE4RPG.ENTITY_TRACKER.tracked_entity_records[entity_id]
        or nil
    local is_elite = tracked_record and tracked_record.role == "elites" or false
    if is_elite then
        local owner = AoE4RPG_ENTITY_TRACKER_GetSafePlayerOwner
            and AoE4RPG_ENTITY_TRACKER_GetSafePlayerOwner(entity)
            or nil
        local player_id = AoE4RPG_BONUS_GetPlayerIdentifier(owner)
        local shared_state = player_id
            and AoE4RPG.BONUS.shared_elite_bonus_by_player_id[player_id]
            or nil
        if shared_state and not shared_state.chosen_choice then
            return {
                bracket_index = 1,
                choices = shared_state.choices,
                shared_elite_offer = true,
            }
        end
        return nil
    end
    if not unit_data.pending_bracket_bonus_offers then
        return nil
    end
    return unit_data.pending_bracket_bonus_offers[1]
end

-- Applies one selected bonus to the cumulative derived-stat table.
-- IMPORTANT: Weapon range, attack timing, and teardown remain entity modifiers because weapon modifiers must be rebuilt for newly spawned or converted entities.
-- Critical chance and health-per-attack are consumed by synchronized combat.
function AoE4RPG_BONUS_ApplyDefinition(
    entity,
    unit_data,
    definition_key,
    reapply_only,
    bonus_instance_key,
    amount_override
)
    local definition = AoE4RPG.BONUS_DEFINITIONS[definition_key]
    -- Reapplication follows the same live-path restriction as a new choice.
    -- IMPORTANT: This removes a former melee/ranged modifier if Jeanne changes branch or returns to her villager blueprint, instead of leaving it active there.
    if not definition or not AoE4RPG_BONUS_IsDefinitionEligible(entity, definition) then
        return false
    end

    unit_data.random_bonus_totals = unit_data.random_bonus_totals or {}
    local derived_stat = definition.derived_stat
    local amount = amount_override or definition.amount
    if not reapply_only then
        unit_data.random_bonus_totals[derived_stat] =
            (unit_data.random_bonus_totals[derived_stat] or 0) + amount
    end
    unit_data.random_bonus_modifier_ids = unit_data.random_bonus_modifier_ids or {}

    if (definition_key == "movement_speed" or definition_key == "regeneration")
        and Modifier_Create and Modifier_ApplyToPlayer and Entity_GetBlueprint then
        local owner = AoE4RPG_ENTITY_TRACKER_GetSafePlayerOwner
            and AoE4RPG_ENTITY_TRACKER_GetSafePlayerOwner(entity)
            or nil
        local player_id = AoE4RPG_BONUS_GetPlayerIdentifier(owner)
        local blueprint = Entity_GetBlueprint(entity)
        local blueprint_name = blueprint
        if blueprint and BP_GetName then
            local resolved_name = BP_GetName(blueprint)
            if type(resolved_name) == "string" and resolved_name ~= "" then
                blueprint_name = resolved_name
            end
        end
        blueprint_name = AoE4RPG_NormalizeBlueprintName
            and AoE4RPG_NormalizeBlueprintName(blueprint_name)
            or tostring(blueprint_name or "")
        local player_blueprint_keys = player_id
            and AoE4RPG.BONUS.applied_blueprint_bonus_keys_by_player_id[player_id]
            or nil
        if owner and player_id and blueprint and blueprint_name ~= "" then
            if not player_blueprint_keys then
                player_blueprint_keys = {}
                AoE4RPG.BONUS.applied_blueprint_bonus_keys_by_player_id[player_id] =
                    player_blueprint_keys
            end
            local persistent_key = tostring(bonus_instance_key or definition_key)
                .. ":blueprint:"
                .. blueprint_name
            if not player_blueprint_keys[persistent_key] then
                local modifier_name = definition_key == "movement_speed"
                    and "speed_maximum_modifier"
                    or "health_regeneration_modifier"
                local usage_type = definition_key == "movement_speed"
                    and MUT_Multiplication
                    or MUT_Addition
                local modifier_value = definition_key == "movement_speed"
                    and (1 + amount)
                    or amount
                local modifier = Modifier_Create(
                    MAT_EntityType,
                    modifier_name,
                    usage_type,
                    false,
                    modifier_value,
                    blueprint
                )
                player_blueprint_keys[persistent_key] =
                    -- Modifier_ApplyToPlayer requires Player*, while the numeric identifier remains the stable table key above.
                    Modifier_ApplyToPlayer(modifier, owner, 0) or true
            end
        end
    elseif definition_key == "weapon_range" and Modifier_Create and Modifier_ApplyToEntity then
        local modifier = Modifier_Create(MAT_Weapon, "range_weapon_modifier", MUT_MultiplicationAddition, false, amount, "")
        local modifier_id = Modifier_ApplyToEntity(modifier, entity, 0)
        if modifier_id then
            table.insert(unit_data.random_bonus_modifier_ids, modifier_id)
        end
    elseif definition_key == "attack_speed" and Modifier_Create and Modifier_ApplyToEntity then
        local attack_duration_factor = math.max(0.01, 1 - amount)
        local attack_modifier_names = {
            "reload_weapon_modifier",
            "cooldown_weapon_modifier",
            "weapon_wind_up_modifier",
            "weapon_wind_down_modifier",
        }
        for _, modifier_name in ipairs(attack_modifier_names) do
            local modifier = Modifier_Create(MAT_Weapon, modifier_name, MUT_Multiplication, false, attack_duration_factor, "")
            local modifier_id = Modifier_ApplyToEntity(modifier, entity, 0)
            if modifier_id then
                table.insert(unit_data.random_bonus_modifier_ids, modifier_id)
            end
        end
    elseif definition_key == "teardown_speed" and Modifier_Create and Modifier_ApplyToEntity then
        local teardown_duration_factor = math.max(0.01, 1 - amount)
        local modifier = Modifier_Create(MAT_Weapon, "weapon_teardown_modifier", MUT_Multiplication, false, teardown_duration_factor, "")
        local modifier_id = Modifier_ApplyToEntity(modifier, entity, 0)
        if modifier_id then
            table.insert(unit_data.random_bonus_modifier_ids, modifier_id)
        end
    end

    if AoE4RPG_TranslateAttributesToStats then
        AoE4RPG_TranslateAttributesToStats(unit_data)
    end
    if AoE4RPG_MarkUnitDataChanged then
        AoE4RPG_MarkUnitDataChanged(unit_data)
    end
    return true
end

-- Restores health after a registered melee unit with Health Per Attack deals a positive damage event.
-- ADJUST: change the definition amount above to tune healing per successful hit.
function AoE4RPG_BONUS_ApplyHealthPerAttack(attacker, unit_data)
    if not attacker or not unit_data or not Entity_GetHealth
        or not Entity_GetHealthMax or not Entity_SetHealth then
        return false
    end

    -- This passive is melee-only.
    if not AoE4RPG_EntityMatchesCombatType(attacker, "melee") then
        return false
    end

    local random_bonus_totals = unit_data.random_bonus_totals or {}
    local health_per_attack_ratio = random_bonus_totals.health_per_attack_ratio or 0
    if health_per_attack_ratio <= 0 then
        return false
    end

    -- Eligibility is checked when this bonus is selected.
    -- Once selected it is persistent, including through Jeanne's melee/ranged blueprint changes.

    local maximum_health = Entity_GetHealthMax(attacker)
    if not maximum_health or maximum_health <= 0 then
        return false
    end

    local current_health = Entity_GetHealth(attacker) or 0
    if current_health <= 0 or current_health >= maximum_health then
        return false
    end

    local healed_health_percentage = math.min(
        1.0,
        (current_health / maximum_health) + health_per_attack_ratio
    )
    Entity_SetHealth(attacker, healed_health_percentage)
    return true
end

-- Synchronized handler for a local UI selection.
function AoE4RPG_SelectBracketBonus(sending_player, data)
    -- IMPORTANT: Prevent a synchronized modifier callback from re-entering the same choice event.
    if AoE4RPG.BONUS.selection_in_progress then
        return
    end
    if type(data) ~= "string" then
        return
    end

    local entity_text, bracket_text, choice_text = string.match(data, "^(%d+),(%d+),(%d+)$")
    local entity_id = tonumber(entity_text)
    local bracket_index = tonumber(bracket_text)
    local choice_index = tonumber(choice_text)
    if not entity_id or not bracket_index or not choice_index
        or choice_index < 1 or choice_index > AoE4RPG.BONUS.choices_per_offer then
        return
    end

    local entity = Entity_FromID and Entity_FromID(entity_id) or nil
    if not entity then
        return
    end
    if not AoE4RPG_ENTITY_TRACKER_IsTrackedEntityIdentifier
        or not AoE4RPG_ENTITY_TRACKER_IsTrackedEntityIdentifier(entity_id) then
        return
    end

    local entity_owner = AoE4RPG_ENTITY_TRACKER_GetSafePlayerOwner
        and AoE4RPG_ENTITY_TRACKER_GetSafePlayerOwner(entity)
        or nil
    if not entity_owner then
        return
    end
    if AoE4RPG_BONUS_GetPlayerIdentifier(entity_owner) ~= AoE4RPG_BONUS_GetPlayerIdentifier(sending_player) then
        return
    end

    local unit_data = AoE4RPG_GetUnitData(entity_id)
    local offer = AoE4RPG_BONUS_GetActiveOffer(entity_id)
    unit_data.chosen_bracket_bonuses = unit_data.chosen_bracket_bonuses or {}
    if not offer or offer.bracket_index ~= bracket_index then
        return
    end

    local selected_choice = offer.choices[choice_index]
    AoE4RPG.BONUS.selection_in_progress = true
    if offer.shared_elite_offer then
        local player_id = AoE4RPG_BONUS_GetPlayerIdentifier(entity_owner)
        local shared_state = player_id
            and AoE4RPG.BONUS.shared_elite_bonus_by_player_id[player_id]
            or nil
        local definition = selected_choice and selected_choice.kind == "bonus"
            and AoE4RPG.BONUS_DEFINITIONS[selected_choice.key] or nil
        if not shared_state or shared_state.chosen_choice
            or not selected_choice
            or (selected_choice.kind == "bonus" and (not definition or definition.required_type)) then
            AoE4RPG.BONUS.selection_in_progress = false
            return
        end

        -- Commit the synchronized player-wide choice before applying it.
        shared_state.chosen_choice = selected_choice
        local processed_selected_entity = false
        if AoE4RPG_ENTITY_TRACKER_ForEachTrackedEntity then
            AoE4RPG_ENTITY_TRACKER_ForEachTrackedEntity(function(candidate, candidate_id, record)
                local candidate_owner = AoE4RPG_ENTITY_TRACKER_GetSafePlayerOwner
                    and AoE4RPG_ENTITY_TRACKER_GetSafePlayerOwner(candidate)
                    or nil
                local candidate_player_id = AoE4RPG_BONUS_GetPlayerIdentifier(candidate_owner)
                if record and record.role == "elites"
                    and candidate_player_id == player_id then
                    AoE4RPG_BONUS_EnsureCurrentBracketOffer(candidate, true)
                    processed_selected_entity = processed_selected_entity
                        or candidate_id == entity_id
                end
            end)
        end
        if not processed_selected_entity then
            AoE4RPG_BONUS_EnsureCurrentBracketOffer(entity, true)
        end
        if AoE4RPG_BONUS_UI_OnSelectionApplied then
            AoE4RPG_BONUS_UI_OnSelectionApplied(entity_id)
        end
        if AoE4RPG_BONUS_INDICATOR_Clear then
            AoE4RPG_BONUS_INDICATOR_Clear()
        end
        AoE4RPG.BONUS.selection_in_progress = false
        return
    end

    if unit_data.chosen_bracket_bonuses[bracket_index] then
        AoE4RPG.BONUS.selection_in_progress = false
        return
    end
    local applied = selected_choice and (
        (selected_choice.kind == "bonus" and AoE4RPG_BONUS_ApplyDefinition(entity, unit_data, selected_choice.key, false,
            "hero:" .. tostring(unit_data.class_name or "unclassified") .. ":bracket:" .. tostring(bracket_index), selected_choice.amount))
        or (selected_choice.kind == "attribute" and AoE4RPG_BONUS_ApplyAttributeChoice(entity, unit_data, selected_choice))
        or (selected_choice.kind == "skill" and AoE4RPG_BONUS_ApplySkillChoice(entity, unit_data, selected_choice))
    )
    if not applied then
        AoE4RPG.BONUS.selection_in_progress = false
        return
    end

    unit_data.chosen_bracket_bonuses[bracket_index] = selected_choice
    table.remove(unit_data.pending_bracket_bonus_offers, 1)
    if AoE4RPG_MarkUnitDataChanged then
        AoE4RPG_MarkUnitDataChanged(unit_data)
    end

    if AoE4RPG_BONUS_INDICATOR_RefreshEntity then
        AoE4RPG_BONUS_INDICATOR_RefreshEntity(entity_id)
    end

    if AoE4RPG_BONUS_UI_OnSelectionApplied then
        AoE4RPG_BONUS_UI_OnSelectionApplied(entity_id)
    end
    AoE4RPG.BONUS.selection_in_progress = false
end

-- Registers the network event exactly once during normal module initialization.
function AoE4RPG_BONUS_Initialize()
    if AoE4RPG.BONUS.initialized then
        return true
    end
    if not Network_RegisterEvent then
        return false
    end

    Network_RegisterEvent(AoE4RPG.BONUS.network_event_name)
    AoE4RPG.BONUS.initialized = true
    return true
end
