AoE4RPG.HEALING_EXPERIENCE_RATIO = 1.0
AoE4RPG.TECHNICIAN_DROPOFF_EXPERIENCE_RATIO = 1.0 -- Each resource dropped off grants one base XP.
AoE4RPG.TECHNICIAN_PRODUCED_UNIT_BONUS_RATIO = 0.10 -- Produced units receive 10% of the selected Technician's derived stats.
AoE4RPG.LEVEL_UP_SOUND = "sfx_campaign_scripted_small_group_celebrate"  -- Level up sound.
AoE4RPG.BRACKET_LEVEL_UP_SOUND = "mus_stinger_campaign_triumph_short"   -- Tier up sound.
-- This flag enables a special leveling rule for Jeanne and both Khan.
AoE4RPG.UNIT_DATA = {}
AoE4RPG.NATIVE_EXPERIENCE_ENTITY_IDS = {}
AoE4RPG.native_experience_monitor_registered = false
