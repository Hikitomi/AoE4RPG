-- ================= AoE4RPG Core ===============
-- AoE4RPG Core - Leveling Engine tracks experience, levels, brackets, and derived progression.
-- Author: Hikitomi
-- Referenced: AoE4RPG_classes.scar, AoE4RPG_entity_tracker.scar, and AoE4RPG_random_bonus.scar.
-- ================= AoE4RPG Core ===============

if not AoE4RPG then
    AoE4RPG = {}
end

-- ==================== Normalization ====================
-- ==================== Normalization ====================

function AoE4RPG_Round(value, decimal_places)
    local places = decimal_places or 2
    local factor = 10 ^ places
    return math.floor((value or 0) * factor + 0.5) / factor
end

function AoE4RPG_RoundToStep(value, step)
    local increment = step or 1
    return AoE4RPG_Round((value or 0) / increment, 0) * increment
end

AoE4RPG.VERSION = "1.0.0"
AoE4RPG.TUNING_MOD_GUID = "98552b27dfde4300a0ed44aa6e97017d"

-- Qualifies one custom property-bag short name with this tuning pack's GUID.
function AoE4RPG_GetQualifiedTuningBlueprintName(blueprint_short_name)
    if type(blueprint_short_name) ~= "string" or blueprint_short_name == "" then
        return nil
    end
    if string.find(blueprint_short_name, ":", 1, true) then
        return blueprint_short_name
    end
    return tostring(AoE4RPG.TUNING_MOD_GUID) .. ":" .. blueprint_short_name
end

-- Returns an AoE4RPG tuning upgrade by its XML filename.
-- Already-qualified names remain unchanged so callers can also provide the exact compiled identity when needed.
function AoE4RPG_GetTuningUpgradeBlueprint(upgrade_short_name)
    if not BP_GetUpgradeBlueprint
        or type(upgrade_short_name) ~= "string"
        or upgrade_short_name == "" then
        return nil
    end

    local qualified_name = AoE4RPG_GetQualifiedTuningBlueprintName(upgrade_short_name)
    return BP_GetUpgradeBlueprint(qualified_name)
end

-- Returns an ability copied into the AoE4RPG tuning pack.
-- Ability XML files use the same mod-qualified short-name format as custom upgrades.
function AoE4RPG_GetTuningAbilityBlueprint(ability_short_name)
    if not BP_GetAbilityBlueprint then
        return nil
    end
    local qualified_name = AoE4RPG_GetQualifiedTuningBlueprintName(ability_short_name)
    if not qualified_name then
        return nil
    end
    return BP_GetAbilityBlueprint(qualified_name)
end

AoE4RPG.LEVEL_OFFSET = 1    -- 0 to display starting Lv = 0.
AoE4RPG.MaxLevel = 24       -- Heroes Max Level. 24 + LEVEL_OFFSET = 25.
AoE4RPG.EliteMaxLevel = 9   -- Elites Max Level. 9 + LEVEL_OFFSET = 10.
