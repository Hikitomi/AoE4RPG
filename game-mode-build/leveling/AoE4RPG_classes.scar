-- ================= AoE4RPG Classes ===============
-- AoE4RPG Classes - Class Definitions defines class attributes, growth, roles, and class bonuses.
-- Author: Hikitomi
-- Referenced: AoE4RPG_core.scar, AoE4RPG_blueprints.scar, and AoE4RPG_random_bonus.scar.
-- ================= AoE4RPG Classes ===============

if not AoE4RPG then
    AoE4RPG = {}
end

-- The active class definition fields are `stat_type`, `can_be_elite`, and `attribute_growth`.
AoE4RPG.CLASS_DEFINITIONS = {
    assassin = {
        stat_type = "agility",
        can_be_elite = false,
        attribute_growth = { agility = 3.00, endurance = 2.00, vitality = 1.00 },
    },
    ranger = {
        stat_type = "agility",
        can_be_elite = false,
        attribute_growth = { agility = 3.5, endurance = 1.25, vitality = 1.25 },
    },
    skirmisher = {
        stat_type = "agility",
        can_be_elite = true,
        attribute_growth = { agility = 2.75, endurance = 2.00, vitality = 1.25 },
    },
    initiator = {
        stat_type = "vitality",
        can_be_elite = false,
        attribute_growth = { agility = 1.75, endurance = 1.75, vitality = 2.50 },
    },
    duelist = {
        stat_type = "vitality",
        can_be_elite = true,
        attribute_growth = { agility = 1.75, endurance = 1.25, vitality = 3.00 },
    },
    technician = {
        stat_type = "vitality",
        can_be_elite = true,
        attribute_growth = { agility = 0.25, endurance = 2.25, vitality = 3.00 },
    },
    commander = {
        stat_type = "endurance",
        can_be_elite = false,
        attribute_growth = { agility = 0.75, endurance = 3.5, vitality = 1.75 },
    },
    roamer = {
        stat_type = "endurance",
        can_be_elite = true,
        attribute_growth = { agility = 0.25, endurance = 3.00, vitality = 2.75 },
    },
    strategist = {
        stat_type = "endurance",
        can_be_elite = false,
        attribute_growth = { agility = 2.00, endurance = 3.00, vitality = 1.00 },
    },
