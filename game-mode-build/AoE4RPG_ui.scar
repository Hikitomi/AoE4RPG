-- =============================================================================
-- AoE4RPG UI Module
-- =============================================================================
-- Primitive UI placeholders for the new RPG system. This can be expanded to
-- add level display, attribute panels, and quick filter logic.
-- =============================================================================

if not AoE4RPG then
    AoE4RPG = {}
end

AoE4RPG.UI = {
    enabled = true,
    panels = {},
    last_selection_count = nil,
    last_selected_entity_id = nil,
    last_selected_unit_revision = nil,
    selection_monitor_registered = false,
}

-- This creates a simple stored panel record for class, level, and XP data.
-- Adjust: add new fields to the table below if another UI needs more saved values.
-- @param name Stable panel identifier; @param title Display title.
-- @return Mutable panel table stored in AoE4RPG.UI.panels.
function AoE4RPG_UI_CreatePanel(name, title)
    local panel = {
        name = name,
        title = title,
        visible = true,
    }

    AoE4RPG.UI.panels[name] = panel
    return panel
end

-- This copies the selected unit's current RPG values into the stored panel record.
-- Adjust: add another panel field here when a new selected-unit value is needed.
-- @param entity Selected EntityID/entity object.
-- @side_effect Copies the selected unit's class, level, and XP into unit_status.
function AoE4RPG_UI_UpdateSelectedUnitPanel(entity)
    if not entity then
        return
    end

    if AoE4RPG_UI_NormalizeEntity then
        entity = AoE4RPG_UI_NormalizeEntity(entity)
    end

    local entity_id = entity.EntityID or entity
    local unit_data = AoE4RPG_GetUnitData(entity_id)
    if not unit_data then
        return
    end

    local class_name = unit_data.class_name or AoE4RPG_CLASS_GetClassForEntity(entity)
    local panel = AoE4RPG.UI.panels["unit_status"]
    if not panel then
        panel = AoE4RPG_UI_CreatePanel("unit_status", "AoE4RPG")
    end

    panel.class_name = class_name
    panel.level = unit_data.level
    panel.exp = unit_data.exp
end

-- This creates the base unit-status data panel once during late initialization.
-- Adjust: create more non-XAML panel records here if another UI module needs them.
-- @return true after creating the base unit-status panel.
function AoE4RPG_UI_Initialize()
    AoE4RPG_UI_CreatePanel("unit_status", "AoE4RPG")
    return true
end

-- Reads the local player's current selection once and returns the first entity
-- only when exactly one squad is selected. Keeping this lookup in one helper
-- prevents the selection monitor from querying the UI twice for one change.
-- @return Selected entity, selected EntityID, and selected squad count.
-- Adjust: change the one-squad requirement here if multi-selection should be supported.
function AoE4RPG_UI_GetSingleSelectedEntity()
    if not Misc_GetSelectedSquads or not SGroup_CreateIfNotFound or not SGroup_Clear or not SGroup_Count or not SGroup_ForEach then
        return nil, nil, 0
    end

    local selected_squads = SGroup_CreateIfNotFound("AoE4RPG_SelectionWatcher")
    SGroup_Clear(selected_squads)
    Misc_GetSelectedSquads(selected_squads, false)
    local selection_count = SGroup_Count(selected_squads)
    if selection_count ~= 1 then
        return nil, nil, selection_count
    end

    local selected_entity = nil
    SGroup_ForEach(selected_squads, function(group_id, index, squad_id)
        if Squad_GetFirstEntity then
            selected_entity = Squad_GetFirstEntity(squad_id)
        end
        return true
    end)

    if not selected_entity then
        return nil, nil, selection_count
    end

    local selected_entity_id = selected_entity
    if AoE4RPG_UI_NormalizeEntity then
        local normalized_entity, normalized_entity_id = AoE4RPG_UI_NormalizeEntity(selected_entity)
        selected_entity = normalized_entity or selected_entity
        selected_entity_id = normalized_entity_id or selected_entity_id
    end

    return selected_entity, selected_entity_id, selection_count
end

-- Updates the visible hero panel only when selection or tracked RPG data has
-- changed. This function performs the formatting and UI_SetDataContext call;
-- the every-tick monitor remains inexpensive while the selection is stable.
-- @param force_update True to refresh even when cached values are unchanged.
-- @side_effect Shows, refreshes, or hides the selected hero attributes panel.
-- Adjust: add another revision comparison here if a second data source drives the panel.
function AoE4RPG_UI_UpdateSelectionState(force_update)
    local selected_entity, selected_entity_id, selection_count = AoE4RPG_UI_GetSingleSelectedEntity()
    local selected_unit_data = selected_entity_id and AoE4RPG.UNIT_DATA and AoE4RPG.UNIT_DATA[selected_entity_id] or nil
    local selected_unit_revision = selected_unit_data and (selected_unit_data.ui_revision or 0) or 0

    local selection_changed = selection_count ~= AoE4RPG.UI.last_selection_count
        or selected_entity_id ~= AoE4RPG.UI.last_selected_entity_id
    local unit_data_changed = selected_entity_id ~= nil
        and selected_unit_revision ~= AoE4RPG.UI.last_selected_unit_revision

    if not force_update and not selection_changed and not unit_data_changed then
        return
    end

    AoE4RPG.UI.last_selection_count = selection_count
    AoE4RPG.UI.last_selected_entity_id = selected_entity_id
    AoE4RPG.UI.last_selected_unit_revision = selected_entity_id and selected_unit_revision or nil

    if selection_count == 1 and selected_entity then
        AoE4RPG_UI_UpdateSelectedUnitPanel(selected_entity)
        if AoE4RPG_UI_UpdateHeroAttributes then
            AoE4RPG_UI_UpdateHeroAttributes(selected_entity)
        end

        -- Updating the panel can create the unit's RPG record. Cache its final
        -- revision so the next game tick does not perform a duplicate refresh.
        selected_unit_data = AoE4RPG.UNIT_DATA and AoE4RPG.UNIT_DATA[selected_entity_id] or nil
        AoE4RPG.UI.last_selected_unit_revision = selected_unit_data and (selected_unit_data.ui_revision or 0) or 0
    elseif AoE4RPG_UI_UpdateHeroAttributes then
        AoE4RPG_UI_UpdateHeroAttributes(nil)
    end
end

-- Every-tick rule entry point. The expensive UI update is skipped unless the
-- selected EntityID or its small revision counter changed.
function AoE4RPG_UI_MonitorSelection()
    AoE4RPG_UI_UpdateSelectionState(false)
end

-- Starts the immediate selection watcher once and performs an initial refresh
-- so a hero selected before HUD initialization appears without waiting.
-- @return True when the monitor is active.
function AoE4RPG_UI_StartSelectionMonitor()
    if AoE4RPG.UI.selection_monitor_registered then
        return true
    end
    if not Rule_Add then
        return false
    end

    Rule_Add(AoE4RPG_UI_MonitorSelection)
    AoE4RPG.UI.selection_monitor_registered = true
    AoE4RPG_UI_UpdateSelectionState(true)
    return true
end

-- Removes the module-owned selection rule during match shutdown.
function AoE4RPG_UI_StopSelectionMonitor()
    if AoE4RPG.UI.selection_monitor_registered and Rule_Remove then
        Rule_Remove(AoE4RPG_UI_MonitorSelection)
    end
    AoE4RPG.UI.selection_monitor_registered = false
end

-- Compatibility entry point retained for host scripts that request a manual refresh.
function AoE4RPG_UI_RefreshSelection()
    AoE4RPG_UI_UpdateSelectionState(true)
end

-- Compatibility entry point retained for hosts that previously scheduled this function.
function AoE4RPG_UI_CheckSelectionChange()
    AoE4RPG_UI_MonitorSelection()
end
